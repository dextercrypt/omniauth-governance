<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:f="/lib/form">

  <st:adjunct includes="io.jenkins.plugins.rotogate.rg.rgSsoToggle"/>

  <!-- Native Jenkins user database is always on (this realm extends HudsonPrivateSecurityRealm).
       Self-signup is deliberately NOT offered: onboarding is governed through the Rotogate
       provisioning portal (request + approval + audit), so the parent's "Allow users to sign up"
       option is omitted here and forced off in the descriptor. -->

  <!-- Single sign-on is an additive capability, off by default. Native accounts work on their own;
       turning this on reveals the provider settings below. The toggle is authoritative: switching
       it off keeps any stored provider settings but makes sign-in native-only. -->
  <f:entry>
    <f:checkbox field="ssoEnabled" title="${%Connect a single sign-on provider (SSO)}"/>
  </f:entry>
  <f:block>
    <div class="jenkins-form-description">
      Users sign in with native Jenkins accounts. Connect a provider to let your team sign in with
      their organization identity.
    </div>
  </f:block>

  <!-- SSO settings. Kept in the DOM even when the toggle is off (so stored provider settings are
       preserved on save); shown/hidden off the checkbox by rgSsoToggle.js. -->
  <div class="rg-sso-settings" data-rg-sso-settings="true">

    <!-- Single sign-on provider. Modelled as an RotogateSsoProvider extension point: the dropdown
         lists every registered provider (Microsoft Entra today) and renders the selected one's own
         config form. Adding a provider later is just a new RotogateSsoProvider subclass + its
         config.jelly — this form needs no change. -->
    <f:dropdownDescriptorSelector field="provider" title="${%Single sign-on provider}"/>

    <!-- Roadmap note. The dropdown above only lists providers that exist as a real extension
         (Microsoft Entra today); this keeps the "more providers planned" signal the hand-built
         selector used to carry, without putting non-functional options into the real selector. -->
    <f:block>
      <div class="jenkins-form-description">
        More providers planned: Okta, Google Workspace, Generic OIDC, SAML 2.0. Microsoft Entra is available today.
      </div>
    </f:block>

  </div>

</j:jelly>
