<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout" xmlns:f="/lib/form">
  <l:layout permission="${app.ADMINISTER}" title="Rotogate - Access Management" norefresh="true">
    <l:side-panel>
      <st:include page="sidepanel.jelly"/>
    </l:side-panel>
    <l:main-panel>
      <st:adjunct includes="io.jenkins.plugins.rotogate.rg.rg"/>
      <st:adjunct includes="io.jenkins.plugins.rotogate.rg.rgPaginate"/>
      <st:adjunct includes="io.jenkins.plugins.rotogate.rg.rgConfirm"/>
      <st:adjunct includes="io.jenkins.plugins.rotogate.rg.permImplied"/>
      <st:adjunct includes="io.jenkins.plugins.rotogate.RotogateManagementLink.accessManagementAssets"/>

      <l:app-bar title="Access Management"/>

      <div style="padding:0 16px 60px;">

        <!-- Flash -->
        <j:if test="${request2.getParameter('saved') == 'true'}">
          <div class="jenkins-alert jenkins-alert-success" style="margin-bottom:12px;">Access updated successfully.</div>
        </j:if>
        <j:if test="${request2.getParameter('roleSaved') == 'true'}">
          <div class="jenkins-alert jenkins-alert-success" style="margin-bottom:12px;">Role saved.</div>
        </j:if>
        <j:if test="${request2.getParameter('roleDeleted') == 'true'}">
          <div class="jenkins-alert jenkins-alert-success" style="margin-bottom:12px;">Role deleted.</div>
        </j:if>
        <j:if test="${request2.getParameter('error') == 'lastAdmin'}">
          <div class="jenkins-alert jenkins-alert-danger" style="margin-bottom:12px;">Cannot save - this would remove the last administrator.</div>
        </j:if>
        <j:if test="${request2.getParameter('error') == 'notRotogate'}">
          <div class="jenkins-alert jenkins-alert-danger" style="margin-bottom:12px;">Rotogate Authorization Strategy must be active to manage permissions here.</div>
        </j:if>
        <j:if test="${request2.getParameter('error') == 'invalidRole'}">
          <div class="jenkins-alert jenkins-alert-warning" style="margin-bottom:12px;">Role not found - check the Roles tab.</div>
        </j:if>
        <j:if test="${request2.getParameter('error') == 'missingSid'}">
          <div class="jenkins-alert jenkins-alert-danger" style="margin-bottom:12px;">User ID / Group OID is required.</div>
        </j:if>
        <j:if test="${request2.getParameter('error') == 'groupAlreadyExists'}">
          <div class="jenkins-alert jenkins-alert-warning" style="margin-bottom:12px;">This group has already been added.</div>
        </j:if>
        <j:if test="${request2.getParameter('error') == 'configError'}">
          <div class="jenkins-alert jenkins-alert-danger" style="margin-bottom:12px;">Assignment configuration is not available.</div>
        </j:if>
        <j:if test="${request2.getParameter('reviewed') == 'true'}">
          <div class="jenkins-alert jenkins-alert-success" style="margin-bottom:12px;">Access confirmed - review clock reset.</div>
        </j:if>
        <j:if test="${request2.getParameter('error') == 'missingRoleName'}">
          <div class="jenkins-alert jenkins-alert-warning" style="margin-bottom:12px;">Role name is required.</div>
        </j:if>

        <j:if test="${!it.rotogateActive}">
          <div class="jenkins-alert jenkins-alert-warning" style="margin-bottom:16px;">
            Active strategy is not Rotogate - permission writes are disabled.
            Switch to <strong>Rotogate Authorization Strategy</strong> in
            <a href="${rootURL}/manage/configureSecurity/">Configure Global Security</a>.
          </div>
        </j:if>

        <!-- Tabs -->
        <div style="display:flex;align-items:flex-end;border-bottom:2px solid var(--panel-border-color,var(--rg-card-border));margin-bottom:20px;">
          <button class="oam-tab oam-tab-active" type="button" id="tabBtnUsers">
            Users <span id="userCountBadge" class="oam-count">0</span>
          </button>
          <button class="oam-tab" type="button" id="tabBtnRoles">
            Roles <span class="oam-count">${it.roles.size()}</span>
          </button>
        </div>

        <!-- ===== TAB: USERS ===== -->
        <div id="tabPanelUsers">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;gap:12px;flex-wrap:wrap;">
            <div style="display:flex;align-items:center;gap:8px;background:var(--rg-card-bg);border:1px solid var(--panel-border-color,var(--rg-card-border));border-radius:6px;padding:6px 12px;min-width:220px;">
              <l:icon src="symbol-search plugin-ionicons-api" class="icon-xs"/>
              <input id="oamSearch" type="text" placeholder="Search users and groups…"
                     style="border:none;outline:none;background:transparent;font-size:0.88em;color:var(--text-color,#333);width:180px;"/>
            </div>
            <j:if test="${it.rotogateActive}">
              <button type="button"
                      class="jenkins-button jenkins-button--primary js-rg-add-user" >
                + Add User
              </button>
            </j:if>
          </div>

          <div>
            <j:choose>
              <j:when test="${it.accessManagementUserList.isEmpty()}">
                <l:notice title="No permissions yet" icon="symbol-people plugin-ionicons-api">
                  No permissions configured yet.
                  <j:if test="${it.rotogateActive}">
                    <button type="button"
                            class="jenkins-button jenkins-button--primary js-rg-add-user" style="margin-top:12px">
                      + Add User
                    </button>
                  </j:if>
                </l:notice>
              </j:when>
              <j:otherwise>
                <table id="oamUsersTable" class="jenkins-table jenkins-table--medium rg-paginated" data-page-size="15" style="width:100%;">
                  <thead>
                    <tr>
                      <th>User / Group</th>
                      <th>Type</th>
                      <th>Role</th>
                      <th>Last Login</th>
                      <th style="width:80px;"></th>
                    </tr>
                  </thead>
                  <tbody>
                    <j:forEach var="u" items="${it.accessManagementUserList}">
                      <tr class="user-row"
                          data-sid="${u.sid}" data-type="${u.type.name()}" data-display="${u.displayName}"
                          style="cursor:pointer;transition:background 0.1s;">
                        <td>
                          <div style="display:flex;align-items:center;gap:11px;">
                            <div style="width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.9em;font-weight:700;flex-shrink:0;color:#fff;background:var(--blue);">${u.avatarLetter}</div>
                            <div>
                              <j:choose>
                                <j:when test="${u.type.name() == 'GROUP'}">
                                  <div style="font-weight:600;font-size:0.9em;">${u.displayName != null and u.displayName != u.sid ? u.displayName : u.sid}</div>
                                  <j:if test="${u.displayName != null and u.displayName != u.sid}">
                                    <div style="font-size:0.76em;color:var(--text-color-secondary,#888);font-family:monospace;">${u.sid}</div>
                                  </j:if>
                                </j:when>
                                <j:otherwise>
                                  <div style="font-weight:600;font-size:0.9em;">${u.sid}</div>
                                  <j:if test="${u.displayName != null and u.displayName != u.sid}">
                                    <div style="font-size:0.76em;color:var(--text-color-secondary,#888);">${u.displayName}</div>
                                  </j:if>
                                </j:otherwise>
                              </j:choose>
                            </div>
                          </div>
                        </td>
                        <td>
                          <span class="oam-type-badge"><j:choose><j:when test="${u.userEntry}">User</j:when><j:otherwise>Group</j:otherwise></j:choose></span>
                        </td>
                        <td>
                          <span class="oam-role-badge">${u.roleName}</span>
                        </td>
                        <td style="font-size:0.86em;color:var(--text-color-secondary,#888);">
                          <j:choose>
                            <j:when test="${u.relativeLastLogin != null}">${u.relativeLastLogin}</j:when>
                            <j:otherwise><span style="color:#ccc;">—</span></j:otherwise>
                          </j:choose>
                        </td>
                        <td style="text-align:right;">
                          <button type="button"
                                  class="jenkins-button js-rg-manage" style="padding:3px 10px">Manage</button>
                        </td>
                      </tr>
                    </j:forEach>
                  </tbody>
                </table>
              </j:otherwise>
            </j:choose>
          </div>
        </div>

        <!-- ===== TAB: ROLES ===== -->
        <div id="tabPanelRoles" style="display:none;">

          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
            <div style="font-size:0.85em;color:var(--text-color-secondary,#777);">
              Define custom roles with specific permissions, then assign them to users.
            </div>
            <j:if test="${it.rotogateActive}">
              <button type="button"
                      class="jenkins-button jenkins-button--primary js-rg-create-role" style="margin-left:12px">
                + Create Role
              </button>
            </j:if>
          </div>

          <!-- Inline Create/Edit form (hidden by default) -->
          <div id="roleFormPanel" style="display:none;border:1px solid var(--rg-info-border);border-radius:8px;padding:20px 22px;background:var(--rg-info-bg);margin-bottom:16px;">
            <div id="roleFormTitle" style="font-size:0.95em;font-weight:700;margin-bottom:16px;">Create Role</div>
            <f:form method="post" action="saveRole">
              <div style="display:grid;grid-template-columns:1fr 2fr;gap:16px;margin-bottom:16px;">
                <div>
                  <div class="oam-label">Role Name *</div>
                  <input id="roleNameInput" type="text" name="roleName" required="required"
                         class="jenkins-input" placeholder="e.g. QA Engineer"
                         style="width:100%;box-sizing:border-box;"/>
                </div>
                <div>
                  <div class="oam-label">Description</div>
                  <input id="roleDescInput" type="text" name="roleDescription"
                         class="jenkins-input" placeholder="What this role allows"
                         style="width:100%;box-sizing:border-box;"/>
                </div>
              </div>
              <div style="margin-bottom:16px;">
                <div class="oam-label">Permissions</div>
                <div style="border:1px solid var(--panel-border-color,var(--rg-card-border));border-radius:6px;overflow:hidden;max-height:360px;overflow-y:auto;">
                  <j:forEach var="group" items="${it.availablePermissions}">
                    <details style="border-bottom:1px solid var(--panel-border-color,var(--rg-neutral-bg));">
                      <summary style="padding:8px 14px;cursor:pointer;background:var(--rg-neutral-bg);user-select:none;list-style:none;display:flex;align-items:center;gap:6px;">
                        <span class="arr">&#9656;</span>
                        <span style="display:flex;flex-direction:column;gap:1px;">
                          <span style="font-size:0.83em;font-weight:600;line-height:1.2;">${group.groupName}</span>
                          <j:if test="${group.subtitle != null and group.subtitle != ''}">
                            <span style="font-size:0.72em;font-weight:400;color:#999;line-height:1.2;">${group.subtitle}</span>
                          </j:if>
                        </span>
                      </summary>
                      <div style="padding:10px 14px;display:flex;flex-wrap:wrap;gap:6px;">
                        <j:forEach var="perm" items="${group.permissions}">
                          <label class="perm-label" tooltip="${perm.description}" style="display:inline-flex;align-items:center;gap:6px;background:var(--rg-neutral-bg);border:1px solid var(--rg-card-border);border-radius:4px;padding:5px 10px;cursor:pointer;transition:background 0.1s,border-color 0.1s;">
                            <input type="checkbox" class="perm-cb" name="rolePermissions" value="${perm.id}" data-implied-by="${perm.impliedById}"/>
                            <span style="font-size:0.82em;font-weight:500;line-height:1.2;">${perm.name}</span>
                          </label>
                        </j:forEach>
                      </div>
                    </details>
                  </j:forEach>
                </div>
              </div>
              <div style="display:flex;gap:10px;">
                <button type="submit" class="jenkins-button jenkins-button--primary" >Save Role</button>
                <button type="button" id="rgRoleCancel" class="jenkins-button" >Cancel</button>
              </div>
            </f:form>
          </div>

          <!-- Roles list -->
          <div>
            <j:choose>
              <j:when test="${it.roles.isEmpty()}">
                <l:notice title="No roles yet" icon="symbol-list-outline plugin-ionicons-api">
                  No roles defined yet.
                  <j:if test="${it.rotogateActive}">
                    <button type="button"
                            class="jenkins-button jenkins-button--primary js-rg-create-role" style="margin-top:12px">
                      + Create Role
                    </button>
                  </j:if>
                </l:notice>
              </j:when>
              <j:otherwise>
                <table id="oamRolesTable" class="jenkins-table jenkins-table--medium rg-paginated" data-page-size="15" style="width:100%;">
                  <thead>
                    <tr>
                      <th>Role Name</th>
                      <th>Description</th>
                      <th>Permissions</th>
                      <th style="width:140px;"></th>
                    </tr>
                  </thead>
                  <tbody>
                    <j:forEach var="r" items="${it.roles}" varStatus="rs">
                      <tr>
                        <td style="font-weight:600;font-size:0.9em;">${r.name}</td>
                        <td style="font-size:0.85em;color:var(--text-color-secondary,#777);">${r.description}</td>
                        <td style="text-align:left;">
                          <span style="font-size:0.8em;background:var(--rg-info-bg);color:var(--blue);padding:2px 9px;border-radius:10px;font-weight:700;">${r.permissionCount}</span>
                        </td>
                        <td style="text-align:right;white-space:nowrap;">
                          <j:if test="${it.rotogateActive}">
                            <button type="button"
                                    data-rname="${r.name}"
                                    data-rdesc="${r.description}"
                                    data-rperms="${r.permissionsJson}"
                                    class="jenkins-button js-rg-edit-role" style="padding:3px 10px;margin-right:4px">
                              Edit
                            </button>
                            <f:form method="post" action="deleteRole" class="rg-inline-form">
                              <input type="hidden" name="roleName" value="${r.name}"/>
                              <button type="submit"
 data-confirm="Delete role: ${r.name}?"
 class="jenkins-button js-rg-confirm"
 style="padding:3px 10px;color:var(--error-color);border-color:var(--error-color);">
                                Delete
                              </button>
                            </f:form>
                          </j:if>
                        </td>
                      </tr>
                    </j:forEach>
                  </tbody>
                </table>
              </j:otherwise>
            </j:choose>
          </div>
        </div>

      </div>

      <!-- Add User Drawer -->
      <div id="drawerBackdrop" class="js-rg-close-drawer"
           style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.3);z-index:9998;"></div>

      <div id="addUserDrawer"
           style="position:fixed;top:0;right:-500px;bottom:0;width:460px;background:var(--rg-card-bg);
                  z-index:9999;box-shadow:-6px 0 28px rgba(0,0,0,0.13);overflow-y:auto;
                  transition:right 0.26s cubic-bezier(0.4,0,0.2,1);display:none;flex-direction:column;">

        <div style="position:sticky;top:0;z-index:10;display:flex;align-items:center;justify-content:space-between;
                    padding:18px 20px;border-bottom:1px solid var(--panel-border-color,#eee);background:var(--rg-card-bg);">
          <div style="font-weight:700;font-size:1em;" id="auDrawerTitle">Add User</div>
          <button type="button" class="js-rg-close-drawer"
                  style="background:none;border:none;cursor:pointer;color:#999;font-size:1.2em;padding:6px;line-height:1;">&#10005;</button>
        </div>

        <div style="padding:22px 20px 32px;">
          <f:form name="addUserForm" method="post" action="addUser">
            <input type="hidden" id="auAction" name="action" value="existing"/>

            <!-- User Type -->
            <div style="margin-bottom:18px;">
              <div class="oam-label">User Type</div>
              <div style="display:flex;gap:0;border:1px solid var(--panel-border-color,var(--rg-card-border));border-radius:6px;overflow:hidden;">
                <label id="auTypeNativeLabel"
                       style="flex:1;display:flex;align-items:center;justify-content:center;gap:7px;padding:9px;cursor:pointer;font-size:0.88em;background:var(--blue);color:#fff;font-weight:600;transition:background 0.15s;">
                  <input type="radio" name="userType" id="auTypeNative" value="NATIVE" checked="checked"
                         style="display:none;"/><l:icon src="symbol-lock-closed plugin-ionicons-api" class="icon-sm"/><span>Native / Local</span>
                </label>
                <label id="auTypeEntraLabel"
                       style="flex:1;display:flex;align-items:center;justify-content:center;gap:7px;padding:9px;cursor:pointer;font-size:0.88em;background:var(--rg-card-bg);color:var(--text-color,#333);transition:background 0.15s;">
                  <input type="radio" name="userType" id="auTypeEntra" value="ENTRA"
                         style="display:none;"/><l:icon src="symbol-cloud plugin-ionicons-api" class="icon-sm"/><span>Entra / Microsoft</span>
                </label>
                <label id="auTypeGroupLabel"
                       style="flex:1;display:flex;align-items:center;justify-content:center;gap:7px;padding:9px;cursor:pointer;font-size:0.88em;background:var(--rg-card-bg);color:var(--text-color,#333);transition:background 0.15s;">
                  <input type="radio" name="userType" id="auTypeGroup" value="GROUP"
                         style="display:none;"/><l:icon src="symbol-people plugin-ionicons-api" class="icon-sm"/><span>Entra Group</span>
                </label>
              </div>
            </div>

            <!-- Username / Email -->
            <div style="margin-bottom:10px;">
              <div class="oam-label" id="auSidLabel">Username *</div>
              <input id="auSid" type="text" name="sid"
                     class="jenkins-input" placeholder="e.g. mark"
                     style="width:100%;box-sizing:border-box;"/>
            </div>

            <!-- Status area -->
            <div id="auStatus" style="display:none;margin-bottom:14px;padding:10px 12px;border-radius:6px;font-size:0.85em;"></div>

            <!-- Native: create form (shown when not found) -->
            <div id="auCreateForm" style="display:none;margin-bottom:16px;padding:14px 16px;background:var(--rg-info-bg);border:1px solid var(--rg-info-border);border-radius:6px;">
              <div style="font-size:0.82em;font-weight:700;color:var(--blue);margin-bottom:12px;">Create New Account</div>
              <div style="margin-bottom:10px;">
                <div class="oam-label">Full Name</div>
                <input id="auFullName" type="text" name="fullName"
                       class="jenkins-input" placeholder="e.g. Mark Johnson"
                       style="width:100%;box-sizing:border-box;"/>
              </div>
              <div style="margin-bottom:10px;">
                <div class="oam-label">Email Address</div>
                <input id="auEmail" type="email" name="email"
                       class="jenkins-input" placeholder="e.g. mark@company.com"
                       style="width:100%;box-sizing:border-box;"/>
              </div>
              <div style="margin-bottom:10px;">
                <label style="display:flex;align-items:center;gap:8px;font-size:0.86em;cursor:pointer;padding:8px 10px;background:var(--rg-neutral-bg);border:1px solid var(--rg-card-border);border-radius:5px;">
                  <input type="checkbox" name="forcePasswordChange" value="true" checked="checked" id="auForcePasswordCb"/>
                  <span>User must set a new password on first login</span>
                </label>
              </div>
              <div style="font-size:0.78em;color:#666;padding:8px 10px;background:var(--rg-warning-bg);border:1px solid var(--rg-warning-border);border-radius:4px;">
                <l:icon src="symbol-key plugin-ionicons-api" class="icon-xs"/>A secure temporary password will be auto-generated and shown once after account creation.
              </div>
            </div>

            <!-- Entra: info banner -->
            <div id="auEntraInfo" style="display:none;margin-bottom:16px;padding:10px 12px;background:var(--rg-success-bg);border:1px solid var(--rg-success-border);border-radius:6px;font-size:0.83em;color:var(--rg-success-fg);">
              <l:icon src="symbol-checkmark-circle plugin-ionicons-api" class="icon-xs"/>Access will be pre-provisioned. When this user logs in via Microsoft for the first time, their account will be created automatically and access will already be in place.
            </div>

            <!-- Group: OID + label fields -->
            <div id="auGroupFields" style="display:none;">
              <div style="margin-bottom:10px;">
                <div class="oam-label">Group Object ID (OID) *</div>
                <input id="auGroupOid" type="text" name="groupOid"
                       class="jenkins-input" placeholder="e.g. xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                       style="width:100%;box-sizing:border-box;font-family:monospace;font-size:0.9em;"/>
                <div style="font-size:0.76em;color:#888;margin-top:4px;">
                  Find in Azure portal: Azure AD &#8250; Groups &#8250; [Your Group] &#8250; Object ID
                </div>
              </div>
              <div style="margin-bottom:16px;">
                <div class="oam-label">Label (optional)</div>
                <input id="auGroupLabel" type="text" name="groupLabel"
                       class="jenkins-input" placeholder="e.g. Payments Team Developers"
                       style="width:100%;box-sizing:border-box;"/>
                <div style="font-size:0.76em;color:#888;margin-top:4px;">Your own note - shown until display name resolves on first login.</div>
              </div>
              <div style="margin-bottom:16px;padding:10px 12px;background:var(--rg-warning-bg);border:1px solid var(--rg-warning-border);border-radius:6px;font-size:0.82em;color:var(--warning-color);">
                <l:icon src="symbol-people plugin-ionicons-api" class="icon-xs"/>All members of this Azure AD group will be able to log in via Microsoft SSO. Jenkins accounts are created automatically on first login. Access is re-validated on every login - removing this group immediately revokes access.
              </div>
              <div style="padding:10px 12px;background:var(--rg-info-bg);border:1px solid var(--rg-info-border);border-radius:6px;font-size:0.82em;color:var(--rg-info-fg);">
                &#8505; Display name will be resolved automatically when the first group member signs in with Microsoft.
              </div>
            </div>

            <div style="display:flex;gap:10px;margin-top:16px;">
              <button type="submit" id="auSubmitBtn" class="jenkins-button jenkins-button--primary">Continue</button>
              <button type="button" class="jenkins-button js-rg-close-drawer" >Cancel</button>
            </div>
          </f:form>
        </div>
      </div>



    </l:main-panel>
  </l:layout>
</j:jelly>
