<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler">
  <!--
    The notification event checkbox grid for one channel. The three channels (email / Slack / Teams)
    offer the identical event list and differ only in the checkbox group name, so the markup lives
    here once and is pulled in with <st:include page="eventGrid.jelly"/>. The caller sets the
    checkbox group name in the shared Jelly context before including, e.g.
    <j:set var="eventGridName" value="smtpEvents"/>. Each label carries Jenkins' native tooltip
    attribute for its description (hover).
  -->
  <j:set var="n" value="${eventGridName}"/>
  <div class="rg-event-grid">
    <label class="rg-event-label" tooltip="Report after each automated cleanup run (dry-run or live)."><input type="checkbox" name="${n}" value="cleanup"/> <span>Stale cleanup ran</span></label>
    <label class="rg-event-label" tooltip="Alert when an admin manually deletes a user via the Rotogate UI."><input type="checkbox" name="${n}" value="userDeleted"/> <span>User manually deleted</span></label>
    <label class="rg-event-label" tooltip="Sent when Rotogate settings are saved."><input type="checkbox" name="${n}" value="configChanged"/> <span>Rotogate config changed</span></label>
    <label class="rg-event-label" tooltip="Alert when users are added to or removed from the protected list."><input type="checkbox" name="${n}" value="protectedListChanged"/> <span>Protected users list changed</span></label>
    <label class="rg-event-label" tooltip="Alert when Microsoft Graph API calls fail, breaking Entra group sync."><input type="checkbox" name="${n}" value="graphApiFailure"/> <span>Graph API failure</span></label>
    <label class="rg-event-label" tooltip="Alert when a user is granted Jenkins ADMINISTER permission."><input type="checkbox" name="${n}" value="adminGranted"/> <span>Admin permission granted</span></label>
    <label class="rg-event-label" tooltip="Alert when consecutive login failures hit the configured threshold."><input type="checkbox" name="${n}" value="bruteForce"/> <span>Brute force detected</span></label>
    <label class="rg-event-label" tooltip="Periodic digest of users approaching the stale threshold."><input type="checkbox" name="${n}" value="staleWarning"/> <span>Stale warning digest</span></label>
    <label class="rg-event-label" tooltip="Periodic digest of role assignments overdue for review."><input type="checkbox" name="${n}" value="accessReview"/> <span>Access review digest</span></label>
    <label class="rg-event-label" tooltip="Sent to approvers when a user submits a JIT access request."><input type="checkbox" name="${n}" value="jitRequest"/> <span><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="12" height="12" style="vertical-align:middle;margin-right:3px;"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/></svg>JIT request submitted</span></label>
    <label class="rg-event-label" tooltip="Sent to the requester when their JIT request is approved."><input type="checkbox" name="${n}" value="jitApproved"/> <span><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="12" height="12" style="vertical-align:middle;margin-right:3px;"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/></svg>JIT access approved</span></label>
    <label class="rg-event-label" tooltip="Sent to the requester when their JIT request is denied or times out."><input type="checkbox" name="${n}" value="jitDenied"/> <span><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="12" height="12" style="vertical-align:middle;margin-right:3px;"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/></svg>JIT access denied</span></label>
    <label class="rg-event-label" tooltip="Sent when a user submits a self-service access request."><input type="checkbox" name="${n}" value="provisionRequest"/> <span>Access request submitted</span></label>
    <label class="rg-event-label" tooltip="Alert when a time-limited account reaches its expiry."><input type="checkbox" name="${n}" value="accountExpired"/> <span>Account expired (time-limited)</span></label>
    <label class="rg-event-label" tooltip="Alert when an account is locked after repeated login failures."><input type="checkbox" name="${n}" value="accountLocked"/> <span>Account locked (brute force)</span></label>
  </div>
</j:jelly>
