<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout" xmlns:f="/lib/form">

  <l:layout permission="${app.ADMINISTER}" title="Rotogate — Active Sessions" norefresh="true">
    <l:side-panel>
      <st:include page="sidepanel.jelly"/>
    </l:side-panel>
    <l:main-panel>
      <st:adjunct includes="io.jenkins.plugins.rotogate.RotogateManagementLink.sessionsAssets"/>
      <st:adjunct includes="io.jenkins.plugins.rotogate.rg.rgConfirm"/>

      <l:app-bar title="Active Sessions"/>

      <div style="padding: 16px 24px;">

        <j:if test="${request2.getParameter('revoked') == 'true'}">
          <div class="jenkins-alert jenkins-alert-success" style="margin-bottom: 16px;">
            Session revoked successfully.
          </div>
        </j:if>
        <j:if test="${request2.getParameter('error') == 'self'}">
          <div class="jenkins-alert jenkins-alert-warning" style="margin-bottom: 16px;">
            You cannot revoke your own session.
          </div>
        </j:if>

        <p style="color: var(--text-color-secondary); margin-bottom: 16px;">
          All currently active Jenkins sessions. Sessions are tracked from login onwards.
          Revoking a session immediately logs that user out.
        </p>

        <j:set var="sessions" value="${it.activeSessions}"/>

        <j:choose>
          <j:when test="${sessions.isEmpty()}">
            <div style="padding: 32px; text-align: center; color: var(--text-color-secondary);">
              No active sessions tracked yet. Sessions appear here after users log in.
            </div>
          </j:when>
          <j:otherwise>
            <table class="jenkins-table jenkins-table--medium sortable">
              <thead>
                <tr>
                  <th>Username</th>
                  <th>Full Name</th>
                  <th>Type</th>
                  <th>Logged In</th>
                  <th>IP Address</th>
                  <th>Browser</th>
                  <th>OS</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <j:forEach var="s" items="${sessions}">
                  <tr>
                    <td><strong>${s.userId}</strong></td>
                    <td>${s.fullName}</td>
                    <td>
                      <j:choose>
                        <j:when test="${s.userType != 'Native'}">
                          <span style="background:var(--rg-info-bg);color:var(--blue);padding:2px 8px;border-radius:4px;font-size:0.85em;">${s.userType}</span>
                        </j:when>
                        <j:otherwise>
                          <span style="background:var(--rg-neutral-bg);color:var(--text-color-secondary);padding:2px 8px;border-radius:4px;font-size:0.85em;">Native</span>
                        </j:otherwise>
                      </j:choose>
                    </td>
                    <td>
                      <span style="display:inline-flex;align-items:center;gap:4px;">
                        <span>${s.relativeLoginTime}</span>
                        <span class="rg-info-wrap">
                          <span class="rg-info-btn">i</span>
                          <span class="rg-info-tip">${s.loginTime}</span>
                        </span>
                      </span>
                    </td>
                    <td style="font-family:monospace;font-size:0.88em;">${s.ip}</td>
                    <td>${s.browser}</td>
                    <td>${s.os}</td>
                    <td>
                      <j:choose>
                        <j:when test="${s.sessionId == it.currentSessionId}">
                          <span style="background:var(--rg-success-bg);color:var(--rg-success-fg);padding:2px 8px;border-radius:4px;font-size:0.82em;">Current</span>
                        </j:when>
                        <j:otherwise>
                          <f:form method="post" action="revokeSession" name="revoke-${s.sessionId}">
                            <input type="hidden" name="sessionId" value="${s.sessionId}"/>
                            <button type="submit"
                                    class="jenkins-button jenkins-button--danger jenkins-button--small"
                                    data-confirm="This will immediately log out ${s.userId}. They will need to log in again to access Jenkins."
                                    data-confirm-title="Revoke session">
                              Revoke
                            </button>
                          </f:form>
                        </j:otherwise>
                      </j:choose>
                    </td>
                  </tr>
                </j:forEach>
              </tbody>
            </table>
          </j:otherwise>
        </j:choose>

      </div>

    </l:main-panel>
  </l:layout>

</j:jelly>
