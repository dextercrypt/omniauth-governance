<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <l:layout title="OmniAuth — User Access" norefresh="true">
    <l:main-panel>
      <st:adjunct includes="io.jenkins.plugins.omniauth.oau.oau"/>

      <j:set var="sid"              value="${request2.getParameter('sid')}"/>
      <j:set var="type"             value="${request2.getParameter('type')}"/>
      <j:set var="header"           value="${it.userDetailHeader}"/>
      <j:set var="assignments"      value="${it.userAssignments}"/>
      <j:set var="roles"            value="${it.roles}"/>
      <j:set var="tmpPwd"           value="${it.tempPassword}"/>
      <j:set var="isNewUser"        value="${request2.getParameter('newUser') == 'true'}"/>
      <j:set var="isPreProvisioned" value="${request2.getParameter('preProvisioned') == 'true'}"/>
      <j:set var="userIsGlobalAdmin" value="${it.isUserGlobalAdmin(sid)}"/>

      <!-- Breadcrumb -->
      <div class="jenkins-app-bar">
        <div class="jenkins-app-bar__content">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
            <a href="${rootURL}/manage/omniauth-management/"
               style="color:var(--text-color-secondary,var(--text-color-secondary));font-size:0.82em;text-decoration:none;">
              &#8592; OmniAuth Management
            </a>
            <span style="color:#ccc;">/</span>
            <a href="accessManagement"
               style="color:var(--text-color-secondary,var(--text-color-secondary));font-size:0.82em;text-decoration:none;">
              Access Management
            </a>
            <span style="color:#ccc;">/</span>
            <h1 class="jenkins-app-bar__heading">
              <j:choose>
                <j:when test="${header != null}">${header.sid}</j:when>
                <j:otherwise>User</j:otherwise>
              </j:choose>
            </h1>
          </div>
        </div>
      </div>

      <div style="padding:0 16px 60px;">

        <!-- Flash -->
        <j:if test="${request2.getParameter('saved') == 'true'}">
          <div class="jenkins-alert jenkins-alert-success" style="margin-bottom:12px;">Access updated.</div>
        </j:if>
        <j:if test="${request2.getParameter('reviewed') == 'true'}">
          <div class="jenkins-alert jenkins-alert-success" style="margin-bottom:12px;">Access confirmed — review clock reset.</div>
        </j:if>
        <j:if test="${request2.getParameter('error') == 'lastAdmin'}">
          <div class="jenkins-alert jenkins-alert-danger" style="margin-bottom:12px;">Cannot remove — this would leave Jenkins with no administrators.</div>
        </j:if>
        <j:if test="${request2.getParameter('error') == 'notOmniAuth'}">
          <div class="jenkins-alert jenkins-alert-danger" style="margin-bottom:12px;">OmniAuth Authorization Strategy must be active.</div>
        </j:if>
        <j:if test="${request2.getParameter('error') == 'invalidRole'}">
          <div class="jenkins-alert jenkins-alert-warning" style="margin-bottom:12px;">Role not found. Check that it still exists in the Roles tab.</div>
        </j:if>
        <j:if test="${request2.getParameter('error') == 'notFound'}">
          <div class="jenkins-alert jenkins-alert-warning" style="margin-bottom:12px;">Job or folder not found at that path.</div>
        </j:if>
        <j:if test="${request2.getParameter('error') == 'missingSid'}">
          <div class="jenkins-alert jenkins-alert-warning" style="margin-bottom:12px;">User or group ID is required.</div>
        </j:if>
        <j:if test="${request2.getParameter('error') == 'noPermissions'}">
          <div class="jenkins-alert jenkins-alert-warning" style="margin-bottom:12px;">No permissions selected — choose at least one permission from the Custom picker.</div>
        </j:if>
        <j:if test="${request2.getParameter('error') == 'jitMinApprovers'}">
          <div class="jenkins-alert jenkins-alert-warning" style="margin-bottom:12px;">JIT assignments require at least 2 approvers. Add a second approver and save again.</div>
        </j:if>

        <!-- Group-managed notice -->
        <j:if test="${header != null and header.groupManaged}">
          <div style="margin-bottom:16px;padding:12px 16px;background:var(--oau-warning-bg);border:1px solid var(--oau-warning-border);border-radius:8px;font-size:0.88em;color:var(--warning-color);display:flex;align-items:flex-start;gap:10px;">
            <span style="flex-shrink:0;display:inline-flex;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg></span>
            <span>
              <strong>Group-provisioned user.</strong>
              Access is controlled by the Azure AD group assignment — individual grants are not permitted.
              To change this user's permissions, edit the group entity in Access Management.
            </span>
          </div>
        </j:if>

        <!-- Pre-provisioned banner -->
        <j:if test="${isPreProvisioned}">
          <div style="margin-bottom:16px;padding:12px 16px;background:var(--oau-success-bg);border:1px solid var(--oau-success-border);border-radius:8px;font-size:0.88em;color:var(--oau-success-fg);">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px;margin-right:4px;"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg><strong>${sid}</strong> has been pre-provisioned. Their account will be created automatically when they log in via Microsoft for the first time. Assign access below so it's ready when they arrive.
          </div>
        </j:if>

        <!-- New native user banner -->
        <j:if test="${isNewUser}">
          <div style="margin-bottom:16px;padding:12px 16px;background:var(--oau-info-bg);border:1px solid var(--oau-info-border);border-radius:8px;font-size:0.88em;color:var(--oau-info-fg);">
            &#10003; Account created for <strong>${sid}</strong>. Assign access below.
          </div>
        </j:if>

        <!-- Temp password modal (shown once, read from session) -->
        <j:if test="${tmpPwd != null}">
          <div id="tmpPwdOverlay"
               style="position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);z-index:9999;display:flex;align-items:center;justify-content:center;">
            <div style="background:#fff;border-radius:10px;padding:28px 32px;max-width:420px;width:90%;box-shadow:0 20px 60px rgba(0,0,0,0.25);">
              <div style="font-weight:700;font-size:1.05em;margin-bottom:6px;">Account Created</div>
              <div style="font-size:0.85em;color:#555;margin-bottom:18px;">
                Share this temporary password with <strong>${sid}</strong>.
                <j:if test="${request2.getParameter('mustChange') == 'true'}">
                  They will be prompted to set a new password on first login.
                </j:if>
                <j:if test="${request2.getParameter('mustChange') != 'true'}">
                  They can log in directly with this password.
                </j:if>
              </div>
              <div style="font-size:0.75em;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:#888;margin-bottom:6px;">Temporary Password</div>
              <div style="display:flex;align-items:center;gap:8px;margin-bottom:18px;">
                <div id="tmpPwdVal"
                     style="flex:1;font-family:monospace;font-size:1.1em;font-weight:700;letter-spacing:0.08em;padding:10px 14px;background:var(--oau-neutral-bg);border:1px solid var(--oau-card-border);border-radius:6px;color:var(--text-color);">
                  ${tmpPwd}
                </div>
                <button type="button" onclick="copyTmpPwd()"
                        class="jenkins-button" style="font-size:0.82em;padding:8px 14px;white-space:nowrap;">
                  Copy
                </button>
              </div>
              <div style="font-size:0.78em;color:var(--error-color);margin-bottom:18px;">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-1px;margin-right:4px;"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>This password will not be shown again. Copy it now.
              </div>
              <button type="button" onclick="document.getElementById('tmpPwdOverlay').style.display='none'"
                      class="jenkins-button jenkins-button--primary" style="width:100%;font-size:0.88em;">
                Done — I've copied the password
              </button>
            </div>
          </div>
          <script>//<![CDATA[
            function copyTmpPwd() {
              var pwd = document.getElementById('tmpPwdVal').textContent.trim();
              navigator.clipboard.writeText(pwd).then(function() {
                var btn = event.target;
                btn.textContent = 'Copied!';
                setTimeout(function() { btn.textContent = 'Copy'; }, 2000);
              });
            }
          //]]></script>
        </j:if>

        <!-- User card -->
        <j:if test="${header != null}">
          <div style="display:flex;align-items:center;gap:14px;padding:16px 20px;background:var(--oau-card-bg);border:1px solid var(--panel-border-color,var(--oau-card-border));border-radius:10px;margin-bottom:20px;">
            <div class="udx-avatar"
                 style="width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.15em;font-weight:700;color:#fff;flex-shrink:0;background:var(--oau-info-fg);">
              ${header.avatarLetter}
            </div>
            <div style="flex:1;min-width:0;">
              <div style="font-weight:700;font-size:1.05em;">${header.sid}</div>
              <div style="font-size:0.83em;color:var(--text-color-secondary,#888);margin-top:2px;">
                <j:choose>
                  <j:when test="${header.userEntry}">User</j:when>
                  <j:otherwise>Group</j:otherwise>
                </j:choose>
                <j:if test="${header.displayName != null and header.displayName != header.sid}"> · ${header.displayName}</j:if>
                <j:if test="${header.relativeLastLogin != null}"> · Last login: ${header.relativeLastLogin}</j:if>
              </div>
              <!-- Time-limited account expiry (provisioning portal) -->
              <j:if test="${header.hasExpiry()}">
                <j:set var="pillBase" value="display:inline-block;padding:3px 10px;border-radius:12px;font-size:0.76em;font-weight:600;"/>
                <div style="margin-top:6px;">
                  <j:choose>
                    <j:when test="${header.accountDisabledByExpiry}"><span style="${pillBase}background:var(--oau-danger-bg);color:var(--oau-danger-fg);" title="Disabled by the expiry worker on ${header.formattedExpiresAt}">Access expired &#183; account disabled</span></j:when>
                    <j:when test="${header.accountExpired}">        <span style="${pillBase}background:var(--oau-danger-bg);color:var(--oau-danger-fg);" title="Expired ${header.formattedExpiresAt}">Access expired</span></j:when>
                    <j:when test="${header.expiresInDays &lt;= 7}">  <span style="${pillBase}background:var(--oau-warning-bg);color:var(--warning-color);" title="${header.formattedExpiresAt}">Access expires in ${header.expiresInDays} day(s)</span></j:when>
                    <j:otherwise>                                   <span style="${pillBase}background:var(--oau-card-border);color:var(--text-color-secondary);" title="${header.formattedExpiresAt}">Access expires ${header.formattedExpiresAt} (in ${header.expiresInDays} days)</span></j:otherwise>
                  </j:choose>
                </div>
              </j:if>
            </div>
          </div>
        </j:if>

        <!-- Assignments section -->
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
          <div style="font-size:1em;font-weight:700;">Access Assignments</div>
          <j:if test="${it.omniAuthActive and (header == null or !header.groupManaged)}">
            <button type="button" onclick="udxShowAdd()"
                    class="jenkins-button jenkins-button--primary"
                    style="font-size:0.85em;">+ Add Access</button>
          </j:if>
        </div>

        <div style="border:1px solid var(--panel-border-color,var(--oau-card-border));border-radius:8px;overflow:hidden;background:var(--oau-card-bg);">
          <j:choose>
            <j:when test="${assignments.isEmpty()}">
              <div style="padding:56px;text-align:center;color:#888;">
                <div style="margin-bottom:8px;opacity:0.3;display:flex;justify-content:center;"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/></svg></div>
                <div style="font-size:0.9em;">No access assigned to this user yet.</div>
                <j:if test="${it.omniAuthActive and (header == null or !header.groupManaged)}">
                  <button type="button" onclick="udxShowAdd()"
                          class="jenkins-button jenkins-button--primary"
                          style="margin-top:12px;font-size:0.85em;">+ Add Access</button>
                </j:if>
              </div>
            </j:when>
            <j:otherwise>
              <table style="width:100%;border-collapse:collapse;">
                <thead>
                  <tr style="background:var(--oau-neutral-bg);border-bottom:2px solid var(--panel-border-color,var(--oau-card-border));">
                    <th class="udx-th">Scope</th>
                    <th class="udx-th">Role</th>
                    <th class="udx-th">Permissions</th>
                    <th class="udx-th">Expires</th>
                    <th class="udx-th" style="width:140px;"></th>
                  </tr>
                </thead>
                <tbody>
                  <j:forEach var="a" items="${assignments}">
                    <tr style="border-bottom:1px solid var(--panel-border-color,var(--oau-neutral-bg));">
                      <!-- Scope -->
                      <td style="padding:12px 16px;">
                        <div style="display:flex;align-items:center;gap:8px;">
                          <span style="font-size:1em;">
                            <j:choose>
                              <j:when test="${a.global}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px;"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg></j:when>
                              <j:when test="${a.scopeType == 'folder'}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px;"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg></j:when>
                              <j:otherwise><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px;"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg></j:otherwise>
                            </j:choose>
                          </span>
                          <div>
                            <div style="font-weight:600;font-size:0.9em;">${a.displayScope}</div>
                            <j:if test="${!a.global}">
                              <div style="font-size:0.72em;color:#aaa;">${a.scope}</div>
                            </j:if>
                          </div>
                        </div>
                      </td>
                      <!-- Role -->
                      <td style="padding:12px 16px;">
                        <span class="udx-role-badge">${a.roleName}</span>
                        <j:if test="${a.jit}">
                          <span style="display:inline-flex;align-items:center;gap:3px;margin-left:5px;
                                       font-size:0.72em;font-weight:700;padding:2px 7px;border-radius:10px;
                                       background:var(--oau-warning-bg);border:1px solid var(--warning-color);color:var(--warning-color);white-space:nowrap;">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="11" height="11" style="vertical-align:middle;margin-right:2px;"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/></svg>JIT
                          </span>
                        </j:if>
                        <j:if test="${userIsGlobalAdmin and !a.global}">
                          <span title="This assignment has no effect — the user's global Admin role supersedes all scoped restrictions."
                                style="display:inline-flex;align-items:center;gap:4px;margin-left:6px;
                                       font-size:0.72em;font-weight:700;padding:2px 7px;border-radius:10px;
                                       background:var(--oau-warning-bg);border:1px solid var(--oau-warning-border);color:var(--warning-color);cursor:help;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                              <line x1="12" y1="9" x2="12" y2="13"/><circle cx="12" cy="17" r="1" fill="currentColor" stroke="none"/>
                            </svg>
                            Superseded
                          </span>
                        </j:if>
                      </td>
                      <!-- Permissions summary -->
                      <td style="padding:12px 16px;font-size:0.82em;color:var(--text-color-secondary,#777);">
                        ${a.permissionSummary}
                      </td>
                      <!-- Expires -->
                      <td style="padding:12px 16px;font-size:0.82em;">
                        <j:choose>
                          <j:when test="${a.expiresAt != null and a.expiresAt != ''}">
                            <span class="udx-expiry-badge" data-expires="${a.expiresAt}"></span>
                          </j:when>
                          <j:otherwise>
                            <span style="color:#ccc;">—</span>
                          </j:otherwise>
                        </j:choose>
                      </td>
                      <!-- Edit + Confirm + Revoke -->
                      <td style="padding:12px 16px;text-align:right;">
                        <j:if test="${it.omniAuthActive}">
                          <div style="display:flex;gap:6px;justify-content:flex-end;align-items:center;">
                            <j:if test="${!a.global and (header == null or !header.groupManaged)}">
                              <button type="button"
                                      onclick="udxShowEdit('${a.scope}','${a.displayScope}','${a.roleName}',${a.customPermissionsJson},'${a.expiresAt != null ? a.expiresAt : ''}','${a.accessType}','${a.approverGroup}',${a.maxDurationHours},${a.approvalTimeoutHours})"
                                      class="jenkins-button"
                                      style="font-size:0.78em;padding:3px 10px;">
                                Edit
                              </button>
                            </j:if>
                            <form method="post" action="revokeAssignment" style="display:inline;">
                              <input type="hidden" name="${app.crumbRequestField}" value="${app.crumb}"/>
                              <input type="hidden" name="sid"   value="${sid}"/>
                              <input type="hidden" name="type"  value="${type}"/>
                              <input type="hidden" name="scope" value="${a.scope}"/>
                              <button type="submit"
                                      onclick="return confirm('Revoke ${a.roleName} on ${a.displayScope}?')"
                                      class="jenkins-button"
                                      style="font-size:0.78em;padding:3px 10px;color:var(--error-color);border-color:var(--error-color);">
                                Revoke
                              </button>
                            </form>
                          </div>
                        </j:if>
                      </td>
                    </tr>
                  </j:forEach>
                </tbody>
              </table>
            </j:otherwise>
          </j:choose>
        </div>

        <!-- ============================================================ -->
        <!-- Grant / Edit access — unified slide-over drawer              -->
        <!-- (suppressed entirely for group-managed users)               -->
        <!-- ============================================================ -->
        <j:if test="${header == null or !header.groupManaged}">
        <div id="udxDrawer" class="udx-drawer" aria-hidden="true">
          <div class="udx-drawer__scrim" onclick="udxCloseDrawer()"></div>
          <form id="udxGrantForm" method="post" action="grantAssignment"
                class="udx-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="udxDrawerTitle">
            <input type="hidden" name="${app.crumbRequestField}" value="${app.crumb}"/>
            <input type="hidden" name="sid"  value="${sid}"/>
            <input type="hidden" name="type" value="${type}"/>

            <!-- Header -->
            <header class="udx-drawer__head">
              <div style="min-width:0;">
                <div class="udx-drawer__title" id="udxDrawerTitle">Grant access</div>
                <div class="udx-drawer__sub">to <b>${sid}</b></div>
              </div>
              <button type="button" class="udx-drawer__x" onclick="udxCloseDrawer()" aria-label="Close" title="Close">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </header>

            <!-- Scrollable body -->
            <div class="udx-drawer__body">

              <!-- 1 · SCOPE -->
              <section class="udx-step">
                <div class="udx-step__n">1</div>
                <div class="udx-step__c">
                  <div class="udx-step__t">Scope</div>
                  <div class="udx-step__d">Where this access applies.</div>

                  <!-- ADD mode -->
                  <div id="udxScopeChoose">
                    <div class="udx-seg">
                      <label class="udx-seg__opt">
                        <input type="radio" name="scopeType" value="global" checked="checked" onchange="udxScopeChange('global')"/>
                        <span class="udx-seg__face">
                          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 010 18 15 15 0 010-18z"/></svg>
                          <b>Global</b><small>All of Jenkins</small>
                        </span>
                      </label>
                      <label class="udx-seg__opt">
                        <input type="radio" name="scopeType" value="item" onchange="udxScopeChange('item')"/>
                        <span class="udx-seg__face">
                          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V7z"/></svg>
                          <b>Specific job or folder</b><small>One item + its parents</small>
                        </span>
                      </label>
                    </div>
                    <div id="udxItemInput" style="display:none;margin-top:12px;">
                      <input id="udxScopeValue" type="hidden" value=""/>
                      <div style="display:flex;align-items:center;gap:8px;max-width:480px;">
                        <button type="button" id="udxScopeBtn" class="udx-scopebtn" onclick="udxModalOpen()">
                          <span style="display:flex;align-items:center;gap:8px;flex:1;min-width:0;">
                            <span id="udxScopeIcon" style="flex-shrink:0;display:inline-flex;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:block"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg></span>
                            <span id="udxScopeLbl" class="udx-scopebtn__ph">Select a job or folder…</span>
                          </span>
                          <svg width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><path d="M3 4.5L6 7.5 9 4.5"/></svg>
                        </button>
                        <button type="button" id="udxScopeClear" class="udx-scopeclear" onclick="udxScopeClearFn()" title="Clear selection" style="display:none;">&#x2715;</button>
                      </div>
                      <div class="udx-hint">Parent folders automatically receive Read access.</div>
                    </div>
                    <input id="udxScopeGlobal" type="hidden" name="scope" value=""/>
                  </div>

                  <!-- EDIT mode (scope fixed) -->
                  <div id="udxScopeFixed" style="display:none;">
                    <div class="udx-scope-ro" id="udxEditScopeDisplay"></div>
                    <div class="udx-hint">Scope can't be changed — revoke and re-grant to move it.</div>
                  </div>
                </div>
              </section>

              <!-- 2 · WHAT TO GRANT -->
              <section class="udx-step">
                <div class="udx-step__n">2</div>
                <div class="udx-step__c">
                  <div class="udx-step__t">What to grant</div>
                  <div class="udx-step__d">Apply a saved role, or hand-pick permissions.</div>

                  <div class="udx-cards">
                    <button type="button" id="udxModeRole" class="udx-card" onclick="udxSetMode('role')">
                      <span class="udx-card__ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg></span>
                      <span class="udx-card__tt">Use a role</span>
                      <span class="udx-card__ds">Pick a saved preset</span>
                    </button>
                    <button type="button" id="udxModeCustom" class="udx-card" onclick="udxSetMode('custom')">
                      <span class="udx-card__ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg></span>
                      <span class="udx-card__tt">Custom permissions</span>
                      <span class="udx-card__ds">Hand-pick individually</span>
                    </button>
                  </div>

                  <!-- Role mode -->
                  <div id="udxRoleRow" style="display:none;margin-top:14px;">
                    <div class="udx-fieldlabel">Role</div>
                    <div class="udx-select-wrap">
                      <select name="role" id="udxRoleSelect" class="udx-select" onchange="udxRoleChange()">
                        <j:forEach var="r" items="${roles}">
                          <option value="${r.name}" data-perms="${r.permissionsJson}">${r.name} · ${r.permissionCount} permissions</option>
                        </j:forEach>
                        <option value="CUSTOM" id="udxCustomOpt" hidden="hidden">Custom</option>
                      </select>
                      <svg class="udx-select-chev" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4.5L6 7.5 9 4.5"/></svg>
                    </div>
                    <j:if test="${roles.isEmpty()}">
                      <div class="udx-emptyroles">No saved roles yet — use <b>Custom permissions</b>, or create roles in the Roles tab.</div>
                    </j:if>
                    <div id="udxRolePreview" class="udx-preview"></div>
                  </div>

                  <!-- Custom mode -->
                  <div id="udxCustomPerms" style="display:none;margin-top:14px;">
                    <div class="udx-pickhead">
                      <div class="udx-search">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="22" y2="22"/></svg>
                        <input type="text" id="udxPermFilter" placeholder="Filter permissions…" autocomplete="off" oninput="udxPermFilterFn(this.value)"/>
                      </div>
                      <span class="udx-count" id="udxPermCount">0 selected</span>
                    </div>
                    <div id="udxSelChips" class="udx-selchips" style="display:none;"></div>
                    <div class="udx-pickbox" id="udxPickBox">
                      <j:forEach var="group" items="${it.availablePermissions}">
                        <details class="udx-pgroup" open="open">
                          <summary class="udx-psum">
                            <span class="udx-arr">&#9656;</span>
                            <span class="udx-pgname">${group.groupName}<j:if test="${group.subtitle != null and group.subtitle != ''}"><small>${group.subtitle}</small></j:if></span>
                            <span class="udx-selall" onclick="udxToggleGroup(event, this)">Select all</span>
                          </summary>
                          <div class="udx-pbody">
                            <j:forEach var="perm" items="${group.permissions}">
                              <label class="udx-perm">
                                <input type="checkbox" class="udx-perm-cb" name="customPermissions" value="${perm.id}"
                                       data-name="${perm.name}" data-group="${group.groupName}" data-short="${perm.shortId}"
                                       onchange="udxPermChanged()"/>
                                <span class="udx-perm__tx">
                                  <span class="udx-perm__nm">${perm.name}</span>
                                  <span class="udx-perm__id">${perm.shortId}</span>
                                </span>
                              </label>
                            </j:forEach>
                          </div>
                        </details>
                      </j:forEach>
                    </div>
                  </div>
                </div>
              </section>

              <!-- 3 · EXPIRY -->
              <section class="udx-step">
                <div class="udx-step__n">3</div>
                <div class="udx-step__c">
                  <div class="udx-step__t">Expiry <span class="udx-opt">optional</span></div>
                  <div class="udx-step__d">Automatically revoke at the end of a chosen day.</div>
                  <input type="date" name="expiresAt" id="udxExpiresAt" class="udx-date"
                         onchange="udxUpdateExpiryHint(this.value,'udxExpiryHint');udxUpdateSummary()"/>
                  <div id="udxExpiryHint" class="udx-hint">No expiry — access stays until revoked.</div>
                </div>
              </section>

              <!-- 4 · ACCESS TYPE (scoped items only) -->
              <section class="udx-step" id="udxAccessTypeSection" style="display:none;">
                <div class="udx-step__n">4</div>
                <div class="udx-step__c">
                  <div class="udx-step__t">Access type</div>
                  <div class="udx-step__d">How the user gets this access.</div>
                  <div class="udx-seg udx-seg--stack">
                    <label class="udx-seg__opt">
                      <input type="radio" name="accessType" value="STANDING" checked="checked" onchange="udxAccessTypeChange('STANDING')"/>
                      <span class="udx-seg__face udx-seg__face--row">
                        <b>Standing</b><small>Permanent access while the assignment is active.</small>
                      </span>
                    </label>
                    <label class="udx-seg__opt">
                      <input type="radio" name="accessType" value="JIT" onchange="udxAccessTypeChange('JIT')"/>
                      <span class="udx-seg__face udx-seg__face--row">
                        <b style="display:inline-flex;align-items:center;gap:4px;">JIT <svg viewBox="0 0 20 20" fill="currentColor" width="12" height="12"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/></svg></b>
                        <small>User must request activation; an approver must approve before access is granted.</small>
                      </span>
                    </label>
                  </div>
                  <!-- JIT-specific fields -->
                  <div id="udxJitFields" style="display:none;" class="udx-jit">
                    <div style="margin-bottom:14px;">
                      <div class="udx-fieldlabel">Approvers <span style="color:var(--error-color);">*</span></div>
                      <div class="udx-hint" style="margin-bottom:6px;">Minimum 2 required. All must approve. Enter email addresses or Jenkins usernames.</div>
                      <div id="udxApproverChips" class="udx-chipbox"></div>
                      <div style="position:relative;">
                        <input type="text" id="udxApproverInput" class="udx-input" style="width:100%;box-sizing:border-box;"
                               placeholder="Type email or username and press Enter…" autocomplete="off"
                               oninput="udxChipSearch(this.value,'udxApproverDrop','udxApproverChips','udxApprovers')"
                               onkeydown="udxChipKeydown(event,'udxApproverInput','udxApproverDrop','udxApproverChips','udxApprovers')"
                               onblur="setTimeout(function(){var d=document.getElementById('udxApproverDrop');if(d)d.style.display='none'},200)"/>
                        <div id="udxApproverDrop" class="udx-suggest-drop" style="display:none;"></div>
                      </div>
                      <input type="hidden" name="approvers" id="udxApprovers" value=""/>
                      <div id="udxApproverValidation" style="display:none;font-size:0.76em;color:var(--error-color);margin-top:3px;">At least 2 approvers required.</div>
                    </div>
                    <div style="display:flex;gap:16px;flex-wrap:wrap;">
                      <div style="flex:1;min-width:120px;">
                        <div class="udx-fieldlabel">Max duration (h)</div>
                        <input type="number" onwheel="this.blur()" name="maxDurationHours" id="udxMaxDuration"
                               class="udx-input" style="width:100%;" value="4" min="1" max="168"/>
                        <div class="udx-hint">Max hours a user can request.</div>
                      </div>
                      <div style="flex:1;min-width:120px;">
                        <div class="udx-fieldlabel">Approval timeout (h)</div>
                        <input type="number" onwheel="this.blur()" name="approvalTimeoutHours" id="udxApprovalTimeout"
                               class="udx-input" style="width:100%;" value="4" min="1" max="48"/>
                        <div class="udx-hint">Hours before a pending request auto-denies.</div>
                      </div>
                    </div>
                  </div>
                </div>
              </section>

            </div>

            <!-- Sticky footer -->
            <footer class="udx-drawer__foot">
              <div class="udx-summary" id="udxSummary">Choose a scope and what to grant.</div>
              <div class="udx-drawer__actions">
                <button type="button" class="jenkins-button" onclick="udxCloseDrawer()">Cancel</button>
                <button type="submit" class="jenkins-button jenkins-button--primary" id="udxSubmitBtn">Grant access</button>
              </div>
            </footer>
          </form>
        </div>
        </j:if>

        <!-- Edit Access is handled by the unified drawer above (udxShowEdit). -->

      </div>

      <style>
        .udx-th {
          padding: 10px 16px; text-align: left; font-size: 0.78em; font-weight: 700;
          text-transform: uppercase; letter-spacing: 0.05em;
          color: var(--text-color-secondary, #888); white-space: nowrap;
        }
        .udx-role-badge {
          display: inline-block; padding: 3px 10px; border-radius: 10px; font-size: 0.78em;
          font-weight: 700; background: var(--accent-color, var(--oau-info-fg)); color: #fff; white-space: nowrap;
        }
        details[open] .udx-arr { display:inline-block;transform:rotate(90deg); }
        details > summary::-webkit-details-marker { display:none; }

        /* ============================================================ */
        /* Grant / Edit access — slide-over drawer                      */
        /* ============================================================ */
        .udx-drawer {
          --udx-accent: var(--accent-color, var(--blue));
          --udx-accent-soft: rgba(59,130,246,0.12);
          --udx-accent-soft: color-mix(in srgb, var(--udx-accent) 12%, transparent);
          --udx-accent-line: rgba(59,130,246,0.45);
          --udx-accent-line: color-mix(in srgb, var(--udx-accent) 45%, transparent);
          --udx-card: var(--card-background, var(--oau-card-bg));
          --udx-line: var(--panel-border-color, var(--input-border, var(--oau-card-border)));
          --udx-muted: var(--text-color-secondary, var(--text-color-secondary));
          position: fixed; inset: 0; z-index: 9998;
          visibility: hidden; pointer-events: none;
        }
        .udx-drawer[aria-hidden="false"] { visibility: visible; pointer-events: auto; }
        .udx-drawer__scrim {
          position: absolute; inset: 0; background: rgba(15,20,30,0.42);
          backdrop-filter: blur(2px); opacity: 0; transition: opacity 0.28s ease;
        }
        .udx-drawer[aria-hidden="false"] .udx-drawer__scrim { opacity: 1; }
        .udx-drawer__panel {
          position: absolute; top: 0; right: 0; height: 100%;
          width: 560px; max-width: 94vw;
          background: var(--udx-card); color: var(--text-color, var(--text-color));
          box-shadow: -18px 0 50px rgba(0,0,0,0.22);
          display: flex; flex-direction: column;
          transform: translateX(102%); transition: transform 0.34s cubic-bezier(0.22,1,0.36,1);
        }
        .udx-drawer[aria-hidden="false"] .udx-drawer__panel { transform: translateX(0); }
        .udx-drawer__head {
          display: flex; align-items: flex-start; justify-content: space-between; gap: 12px;
          padding: 22px 26px 18px; border-bottom: 1px solid var(--udx-line); flex-shrink: 0;
        }
        .udx-drawer__title { font-size: 1.18em; font-weight: 700; letter-spacing: -0.01em; line-height: 1.2; }
        .udx-drawer__sub { font-size: 0.85em; color: var(--udx-muted); margin-top: 3px; }
        .udx-drawer__sub b { color: var(--text-color, var(--text-color)); font-weight: 600; }
        .udx-drawer__x {
          flex-shrink: 0; width: 34px; height: 34px; border-radius: 9px;
          border: none; background: none; color: var(--udx-muted); cursor: pointer;
          display: flex; align-items: center; justify-content: center; transition: background 0.12s, color 0.12s;
        }
        .udx-drawer__x:hover { background: var(--udx-accent-soft); color: var(--udx-accent); }
        .udx-drawer__body { flex: 1; overflow-y: auto; padding: 8px 26px 24px; }
        .udx-drawer__foot {
          flex-shrink: 0; border-top: 1px solid var(--udx-line);
          padding: 14px 26px 16px; background: var(--udx-card);
          display: flex; flex-direction: column; gap: 12px;
        }
        .udx-drawer__actions { display: flex; gap: 10px; justify-content: flex-end; }
        .udx-summary {
          font-size: 0.84em; line-height: 1.5; color: var(--udx-muted);
          background: var(--udx-accent-soft); border: 1px solid var(--udx-accent-line);
          border-radius: 8px; padding: 9px 13px;
        }
        .udx-summary b { color: var(--text-color, var(--text-color)); font-weight: 600; }

        /* steps */
        .udx-step { display: flex; gap: 14px; padding: 20px 0; border-bottom: 1px solid var(--udx-line); }
        .udx-step:last-child { border-bottom: none; }
        .udx-step__n {
          flex-shrink: 0; width: 26px; height: 26px; border-radius: 50%;
          background: var(--udx-accent-soft); color: var(--udx-accent);
          font-size: 0.82em; font-weight: 700; display: flex; align-items: center; justify-content: center; margin-top: 1px;
        }
        .udx-step__c { flex: 1; min-width: 0; }
        .udx-step__t { font-size: 0.98em; font-weight: 700; letter-spacing: -0.01em; }
        .udx-step__d { font-size: 0.82em; color: var(--udx-muted); margin: 2px 0 12px; }
        .udx-opt {
          font-size: 0.68em; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;
          color: var(--udx-muted); border: 1px solid var(--udx-line); border-radius: 6px; padding: 1px 6px; margin-left: 4px;
        }
        .udx-fieldlabel { font-size: 0.78em; font-weight: 700; margin-bottom: 6px; }
        .udx-hint { font-size: 0.78em; color: var(--udx-muted); margin-top: 5px; }

        /* segmented control */
        .udx-seg { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .udx-seg--stack { grid-template-columns: 1fr; }
        .udx-seg__opt { position: relative; cursor: pointer; display: block; }
        .udx-seg__opt input { position: absolute; opacity: 0; pointer-events: none; }
        .udx-seg__face {
          display: flex; flex-direction: column; gap: 2px; padding: 12px 14px;
          border: 1.5px solid var(--udx-line); border-radius: 10px; transition: all 0.14s;
          font-size: 0.88em;
        }
        .udx-seg__face svg { color: var(--udx-muted); margin-bottom: 3px; }
        .udx-seg__face b { font-weight: 600; }
        .udx-seg__face small { font-size: 0.82em; color: var(--udx-muted); }
        .udx-seg__face--row { flex-direction: column; }
        .udx-seg__opt:hover .udx-seg__face { border-color: var(--udx-accent-line); }
        .udx-seg__opt input:checked + .udx-seg__face {
          border-color: var(--udx-accent); background: var(--udx-accent-soft);
          box-shadow: 0 0 0 1px var(--udx-accent);
        }
        .udx-seg__opt input:checked + .udx-seg__face svg,
        .udx-seg__opt input:checked + .udx-seg__face b { color: var(--udx-accent); }

        /* scope picker button (item) */
        .udx-scopebtn {
          display: flex; align-items: center; gap: 8px; flex: 1; min-width: 0;
          padding: 9px 13px; border: 1.5px solid var(--udx-line); border-radius: 9px;
          background: var(--udx-card); color: var(--text-color, var(--text-color));
          cursor: pointer; font-size: 0.88em; justify-content: space-between; transition: border-color 0.14s, box-shadow 0.14s;
        }
        .udx-scopebtn:hover { border-color: var(--udx-accent); box-shadow: 0 0 0 3px var(--udx-accent-soft); }
        .udx-scopebtn__ph { color: var(--udx-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .udx-scopeclear {
          flex-shrink: 0; width: 30px; height: 30px; border-radius: 8px;
          border: 1.5px solid var(--udx-line); background: var(--udx-card); color: var(--udx-muted);
          cursor: pointer; font-size: 0.8em; display: inline-flex; align-items: center; justify-content: center; transition: all 0.14s;
        }
        .udx-scopeclear:hover { border-color: var(--error-color); color: var(--error-color); }
        .udx-scope-ro {
          font-size: 0.9em; font-weight: 600; padding: 9px 14px; border-radius: 8px;
          background: var(--udx-accent-soft); color: var(--text-color, var(--text-color));
          display: inline-block; font-family: var(--font-family-mono, monospace);
        }

        /* role/custom cards */
        .udx-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .udx-card {
          display: flex; flex-direction: column; align-items: flex-start; gap: 2px;
          padding: 14px 15px; border: 1.5px solid var(--udx-line); border-radius: 11px;
          background: var(--udx-card); color: var(--text-color, var(--text-color)); cursor: pointer; text-align: left; transition: all 0.14s;
        }
        .udx-card:hover { border-color: var(--udx-accent-line); }
        .udx-card__ic { color: var(--udx-muted); margin-bottom: 4px; transition: color 0.14s; }
        .udx-card__tt { font-size: 0.92em; font-weight: 600; }
        .udx-card__ds { font-size: 0.78em; color: var(--udx-muted); }
        .udx-card.is-active {
          border-color: var(--udx-accent); background: var(--udx-accent-soft); box-shadow: 0 0 0 1px var(--udx-accent);
        }
        .udx-card.is-active .udx-card__ic { color: var(--udx-accent); }

        /* styled select */
        .udx-select-wrap { position: relative; max-width: 360px; }
        .udx-select {
          width: 100%; appearance: none; -webkit-appearance: none;
          padding: 9px 34px 9px 13px; border: 1.5px solid var(--udx-line); border-radius: 9px;
          background: var(--udx-card); color: var(--text-color, var(--text-color)); font-size: 0.88em; cursor: pointer; transition: border-color 0.14s, box-shadow 0.14s;
        }
        .udx-select:focus { outline: none; border-color: var(--udx-accent); box-shadow: 0 0 0 3px var(--udx-accent-soft); }
        .udx-select-chev { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); color: var(--udx-muted); pointer-events: none; }
        .udx-emptyroles { font-size: 0.82em; color: var(--udx-muted); margin-top: 8px; }

        /* role permission preview */
        .udx-preview { margin-top: 12px; }
        .udx-preview:empty { display: none; }
        .udx-pv-grp { margin-bottom: 9px; }
        .udx-pv-grp:last-child { margin-bottom: 0; }
        .udx-pv-gname {
          font-size: 0.7em; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
          color: var(--udx-muted); margin-bottom: 5px;
        }
        .udx-pv-chips { display: flex; flex-wrap: wrap; gap: 5px; }
        .udx-pv-chip {
          font-size: 0.76em; padding: 3px 9px; border-radius: 7px;
          background: var(--udx-accent-soft); color: var(--udx-accent); font-weight: 500; border: 1px solid var(--udx-accent-line);
        }
        .udx-pv-empty { font-size: 0.8em; color: var(--udx-muted); }

        /* custom permission picker */
        .udx-pickhead { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
        .udx-search { position: relative; flex: 1; display: flex; align-items: center; }
        .udx-search svg { position: absolute; left: 11px; color: var(--udx-muted); pointer-events: none; }
        .udx-search input {
          width: 100%; box-sizing: border-box; padding: 8px 12px 8px 33px;
          border: 1.5px solid var(--udx-line); border-radius: 8px; font-size: 0.86em;
          background: var(--udx-card); color: var(--text-color, var(--text-color)); transition: border-color 0.14s, box-shadow 0.14s;
        }
        .udx-search input:focus { outline: none; border-color: var(--udx-accent); box-shadow: 0 0 0 3px var(--udx-accent-soft); }
        .udx-count { flex-shrink: 0; font-size: 0.78em; font-weight: 600; color: var(--udx-accent); white-space: nowrap; }
        .udx-selchips {
          display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 10px;
          padding: 8px; border: 1px dashed var(--udx-accent-line); border-radius: 8px; background: var(--udx-accent-soft);
        }
        .udx-selchip {
          display: inline-flex; align-items: center; gap: 5px; font-size: 0.75em; font-weight: 500;
          padding: 2px 5px 2px 9px; border-radius: 12px; background: var(--udx-card); color: var(--text-color, var(--text-color)); border: 1px solid var(--udx-accent-line);
        }
        .udx-selchip button { border: none; background: none; cursor: pointer; color: var(--udx-muted); font-size: 1em; line-height: 1; padding: 0 2px; }
        .udx-selchip button:hover { color: var(--error-color); }
        .udx-pickbox {
          border: 1px solid var(--udx-line); border-radius: 10px; overflow: hidden;
          max-height: 300px; overflow-y: auto;
        }
        .udx-pgroup { border-bottom: 1px solid var(--udx-line); }
        .udx-pgroup:last-child { border-bottom: none; }
        .udx-pgroup.udx-nomatch { display: none; }
        .udx-psum {
          display: flex; align-items: center; gap: 8px; padding: 9px 14px; cursor: pointer;
          user-select: none; list-style: none; background: var(--udx-accent-soft);
        }
        .udx-pgname { flex: 1; font-size: 0.83em; font-weight: 600; display: flex; flex-direction: column; gap: 1px; }
        .udx-pgname small { font-size: 0.82em; font-weight: 400; color: var(--udx-muted); }
        .udx-selall { font-size: 0.74em; font-weight: 600; color: var(--udx-accent); cursor: pointer; flex-shrink: 0; }
        .udx-selall:hover { text-decoration: underline; }
        .udx-pbody { padding: 10px 14px; display: flex; flex-wrap: wrap; gap: 6px; }
        .udx-perm {
          display: inline-flex; align-items: center; gap: 7px; padding: 5px 11px;
          background: var(--udx-card); border: 1px solid var(--udx-line); border-radius: 7px;
          cursor: pointer; transition: background 0.12s, border-color 0.12s;
        }
        .udx-perm.udx-nomatch { display: none; }
        .udx-perm:hover { border-color: var(--udx-accent-line); }
        .udx-perm:has(input:checked) { background: var(--udx-accent-soft); border-color: var(--udx-accent); }
        .udx-perm__tx { display: flex; flex-direction: column; gap: 1px; }
        .udx-perm__nm { font-size: 0.82em; font-weight: 500; line-height: 1.2; }
        .udx-perm__id { font-size: 0.67em; color: var(--udx-muted); font-family: var(--font-family-mono, monospace); line-height: 1.2; }

        /* inputs reused inside drawer */
        .udx-date {
          padding: 8px 11px; border: 1.5px solid var(--udx-line); border-radius: 9px; font-size: 0.88em;
          background: var(--udx-card); color: var(--text-color, var(--text-color));
        }
        .udx-date:focus { outline: none; border-color: var(--udx-accent); box-shadow: 0 0 0 3px var(--udx-accent-soft); }
        .udx-input {
          padding: 8px 11px; border: 1.5px solid var(--udx-line); border-radius: 9px; font-size: 0.88em;
          background: var(--udx-card); color: var(--text-color, var(--text-color)); box-sizing: border-box;
        }
        .udx-input:focus { outline: none; border-color: var(--udx-accent); box-shadow: 0 0 0 3px var(--udx-accent-soft); }
        .udx-jit { margin-top: 14px; padding: 14px 16px; background: var(--udx-accent-soft); border: 1px solid var(--udx-line); border-radius: 10px; }
        .udx-chipbox {
          display: flex; flex-wrap: wrap; gap: 4px; min-height: 32px; padding: 4px 6px;
          border: 1px solid var(--udx-line); border-radius: 8px; background: var(--udx-card); margin-bottom: 6px; align-items: center;
        }

        .udx-expiry-badge {
          display:inline-block; padding:2px 8px; border-radius:8px; font-size:0.78em; font-weight:600;
          background:var(--oau-warning-bg); color:var(--warning-color); border:1px solid var(--oau-warning-border); white-space:nowrap;
        }
        .udx-suggest-drop {
          position:absolute; top:100%; left:0; right:0; z-index:9990;
          background:var(--card-background, var(--oau-card-bg)); border:1.5px solid var(--accent-color,var(--blue)); border-top:none;
          border-radius:0 0 8px 8px; box-shadow:0 6px 20px rgba(0,0,0,0.18);
          max-height:220px; overflow-y:auto;
        }
        .udx-suggest-row {
          display:flex; align-items:center; gap:9px;
          padding:8px 12px; cursor:pointer; transition:background 0.1s;
        }
        .udx-suggest-row:hover { background:color-mix(in srgb, var(--accent-color,var(--blue)) 12%, transparent); }
        .udx-suggest-icon { display:inline-flex; flex-shrink:0; }
        .udx-suggest-id   { font-size:0.88em; font-weight:600; color:var(--text-color,var(--text-color)); line-height:1.2; }
        .udx-suggest-dn   { font-size:0.78em; color:var(--text-color-secondary); line-height:1.2; }
        .udx-suggest-chip {
          margin-left:auto; flex-shrink:0;
          font-size:0.68em; font-weight:700; padding:1px 6px;
          border-radius:8px; text-transform:uppercase; letter-spacing:0.04em;
        }
        .udx-expiry-badge.udx-expiry-soon {
          background:var(--oau-danger-bg); color:var(--error-color); border-color:var(--error-color);
        }
        @keyframes udxModalIn {
          0%   { opacity:0; transform:translate(var(--genie-dx,0px),var(--genie-dy,0px)) scale(0.08); filter:blur(3px); }
          60%  { filter:blur(0); }
          100% { opacity:1; transform:translate(0,0) scale(1); filter:blur(0); }
        }
        @keyframes udxModalOut {
          0%   { opacity:1; transform:translate(0,0) scale(1); filter:blur(0); }
          40%  { filter:blur(0); }
          100% { opacity:0; transform:translate(var(--genie-dx,0px),var(--genie-dy,0px)) scale(0.08); filter:blur(3px); }
        }
      </style>

      <script>//<![CDATA[
        // ── Grant / Edit access drawer ──────────────────────────────────────
        var udxUserIsGlobalAdmin = ${userIsGlobalAdmin ? 'true' : 'false'};
        var udxConflictConfirmed = false;
        var udxIsEdit    = false;   // is the drawer in edit (vs add) mode
        var udxGrantWhat = 'role';  // 'role' | 'custom'
        var udxPermMeta  = {};      // permId -> {name, group, short}

        function udxEsc(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

        // Build permission metadata from the rendered picker (escaping-safe).
        document.addEventListener('DOMContentLoaded', function() {
          document.querySelectorAll('#udxCustomPerms .udx-perm-cb').forEach(function(cb) {
            udxPermMeta[cb.value] = {
              name:  cb.getAttribute('data-name')  || cb.value,
              group: cb.getAttribute('data-group') || 'Other',
              short: cb.getAttribute('data-short') || cb.value
            };
          });
        });

        // Block a scoped grant for a user who already has global Admin (add only).
        (function() {
          var form = document.getElementById('udxGrantForm');
          if (!form) return;
          form.addEventListener('submit', function(e) {
            if (udxConflictConfirmed || udxIsEdit) return;
            var scopeType = document.querySelector('input[name="scopeType"]:checked');
            if (scopeType && scopeType.value === 'item' && udxUserIsGlobalAdmin) {
              e.preventDefault();
              var sidEl = document.querySelector('#udxGrantForm input[name="sid"]');
              document.getElementById('udxConflictSid').textContent = sidEl ? sidEl.value : '';
              document.getElementById('udxConflictModal').style.display = 'flex';
            }
          });
        })();
        function udxConflictCancel() {
          document.getElementById('udxConflictModal').style.display = 'none';
        }
        function udxConflictProceed() {
          document.getElementById('udxConflictModal').style.display = 'none';
          udxConflictConfirmed = true;
          document.getElementById('udxGrantForm').submit();
        }

        // ── open / close ────────────────────────────────────────────────────
        function udxOpenDrawer() {
          document.getElementById('udxDrawer').setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
          document.addEventListener('keydown', udxDrawerKey);
          udxUpdateSummary();
        }
        function udxCloseDrawer() {
          document.getElementById('udxDrawer').setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
          document.removeEventListener('keydown', udxDrawerKey);
        }
        function udxDrawerKey(e) { if (e.key === 'Escape') udxCloseDrawer(); }

        // ── ADD ─────────────────────────────────────────────────────────────
        function udxShowAdd() {
          udxIsEdit = false;
          udxConflictConfirmed = false;
          document.getElementById('udxGrantForm').action = 'grantAssignment';
          document.getElementById('udxDrawerTitle').textContent = 'Grant access';
          document.getElementById('udxSubmitBtn').textContent   = 'Grant access';

          document.getElementById('udxScopeChoose').style.display = '';
          document.getElementById('udxScopeFixed').style.display  = 'none';
          document.querySelectorAll('input[name="scopeType"]').forEach(function(r){ r.checked = r.value === 'global'; });
          udxScopeClearFn();
          udxScopeChange('global');

          var hasRoles = document.getElementById('udxRoleSelect').querySelector('option:not([hidden])') != null;
          udxSetMode(hasRoles ? 'role' : 'custom');
          document.querySelectorAll('#udxCustomPerms .udx-perm-cb').forEach(function(cb){ cb.checked = false; });
          udxPermChanged();

          document.getElementById('udxExpiresAt').value = '';
          udxUpdateExpiryHint('', 'udxExpiryHint');

          document.querySelectorAll('input[name="accessType"]').forEach(function(r){ r.checked = r.value === 'STANDING'; });
          udxClearChips('udxApproverChips', 'udxApprovers');
          document.getElementById('udxMaxDuration').value = 4;
          document.getElementById('udxApprovalTimeout').value = 4;
          udxAccessTypeChange('STANDING');

          udxOpenDrawer();
        }

        // ── EDIT ────────────────────────────────────────────────────────────
        function udxShowEdit(scope, scopeDisplay, roleId, customPermsArr, expiresAt, accessType, approverGroup, maxDuration, approvalTimeout) {
          udxIsEdit = true;
          udxConflictConfirmed = true; // edits never trip the global-admin conflict guard
          document.getElementById('udxGrantForm').action = 'editAssignment';
          document.getElementById('udxDrawerTitle').textContent = 'Edit access';
          document.getElementById('udxSubmitBtn').textContent   = 'Save changes';

          // Scope is fixed in edit mode.
          document.getElementById('udxScopeChoose').style.display = 'none';
          document.getElementById('udxScopeFixed').style.display  = '';
          document.getElementById('udxEditScopeDisplay').textContent = scopeDisplay || scope;
          var sv = document.getElementById('udxScopeValue');
          sv.value = scope; sv.setAttribute('name', 'scope');
          document.getElementById('udxScopeGlobal').removeAttribute('name');
          document.getElementById('udxAccessTypeSection').style.display = ''; // edit = scoped item

          var isCustom = (roleId === 'CUSTOM');
          if (isCustom) {
            udxSetMode('custom');
            document.querySelectorAll('#udxCustomPerms .udx-perm-cb').forEach(function(cb){
              cb.checked = Array.isArray(customPermsArr) && customPermsArr.indexOf(cb.value) >= 0;
            });
            udxPermChanged();
          } else {
            udxSetMode('role');
            var sel = document.getElementById('udxRoleSelect');
            for (var i = 0; i < sel.options.length; i++) {
              if (sel.options[i].value === roleId) { sel.selectedIndex = i; break; }
            }
            udxRoleChange();
          }

          var dateInput = document.getElementById('udxExpiresAt');
          dateInput.value = expiresAt ? expiresAt.substring(0, 10) : '';
          udxUpdateExpiryHint(dateInput.value, 'udxExpiryHint');

          var isJit = accessType === 'JIT';
          document.querySelectorAll('input[name="accessType"]').forEach(function(r){ r.checked = r.value === (isJit ? 'JIT' : 'STANDING'); });
          udxClearChips('udxApproverChips', 'udxApprovers');
          if (approverGroup) {
            approverGroup.split(',').forEach(function(a){ var t = a.trim(); if (t) udxChipAdd(t, 'udxApproverChips', 'udxApprovers'); });
          }
          document.getElementById('udxMaxDuration').value = maxDuration || 4;
          document.getElementById('udxApprovalTimeout').value = approvalTimeout || 4;
          udxAccessTypeChange(isJit ? 'JIT' : 'STANDING');

          udxOpenDrawer();
        }

        // ── what to grant: role vs custom ──────────────────────────────────
        function udxSetMode(mode) {
          udxGrantWhat = mode;
          var sel = document.getElementById('udxRoleSelect');
          document.getElementById('udxModeRole').classList.toggle('is-active', mode === 'role');
          document.getElementById('udxModeCustom').classList.toggle('is-active', mode === 'custom');
          if (mode === 'custom') {
            sel.value = 'CUSTOM';
            document.getElementById('udxRoleRow').style.display = 'none';
            document.getElementById('udxCustomPerms').style.display = '';
            udxPermChanged();
          } else {
            if (sel.value === 'CUSTOM') {
              var first = sel.querySelector('option:not([hidden])');
              if (first) sel.value = first.value;
            }
            document.getElementById('udxRoleRow').style.display = '';
            document.getElementById('udxCustomPerms').style.display = 'none';
            udxRoleChange();
          }
          udxUpdateSummary();
        }

        // ── role preview ───────────────────────────────────────────────────
        function udxRoleChange() {
          var sel = document.getElementById('udxRoleSelect');
          var opt = sel.options[sel.selectedIndex];
          var box = document.getElementById('udxRolePreview');
          box.innerHTML = '';
          if (!opt || opt.value === 'CUSTOM') { udxUpdateSummary(); return; }
          var ids = [];
          try { ids = JSON.parse(opt.getAttribute('data-perms') || '[]'); } catch (e) { ids = []; }
          if (!ids.length) {
            box.innerHTML = '<div class="udx-pv-empty">This role has no permissions.</div>';
            udxUpdateSummary(); return;
          }
          var groups = {}, order = [];
          ids.forEach(function(id) {
            var m = udxPermMeta[id];
            var g  = m ? (m.group || 'Other') : 'Other';
            var nm = m ? m.name : id;
            if (!groups[g]) { groups[g] = []; order.push(g); }
            groups[g].push(nm);
          });
          var head = document.createElement('div');
          head.className = 'udx-pv-gname';
          head.textContent = 'This role grants ' + ids.length + ' permission' + (ids.length === 1 ? '' : 's');
          box.appendChild(head);
          order.forEach(function(g) {
            var wrap  = document.createElement('div'); wrap.className = 'udx-pv-grp';
            var gn    = document.createElement('div'); gn.className = 'udx-pv-gname'; gn.textContent = g;
            var chips = document.createElement('div'); chips.className = 'udx-pv-chips';
            groups[g].forEach(function(nm) {
              var c = document.createElement('span'); c.className = 'udx-pv-chip'; c.textContent = nm; chips.appendChild(c);
            });
            wrap.appendChild(gn); wrap.appendChild(chips); box.appendChild(wrap);
          });
          udxUpdateSummary();
        }

        // ── custom permission picker ───────────────────────────────────────
        function udxPermFilterFn(q) {
          var lq = (q || '').toLowerCase().trim();
          document.querySelectorAll('#udxPickBox .udx-pgroup').forEach(function(grp) {
            var any = false;
            grp.querySelectorAll('.udx-perm').forEach(function(lbl) {
              var cb = lbl.querySelector('.udx-perm-cb');
              var hay = ((cb.getAttribute('data-name') || '') + ' ' + (cb.getAttribute('data-short') || '') + ' ' + cb.value).toLowerCase();
              var match = !lq || hay.indexOf(lq) >= 0;
              lbl.classList.toggle('udx-nomatch', !match);
              if (match) any = true;
            });
            grp.classList.toggle('udx-nomatch', !any);
            if (lq && any) grp.setAttribute('open', 'open');
          });
        }
        function udxToggleGroup(ev, el) {
          ev.preventDefault(); ev.stopPropagation();
          var grp = el.closest('.udx-pgroup');
          var cbs = Array.prototype.slice.call(grp.querySelectorAll('.udx-perm:not(.udx-nomatch) .udx-perm-cb'));
          var allOn = cbs.length > 0 && cbs.every(function(cb){ return cb.checked; });
          cbs.forEach(function(cb){ cb.checked = !allOn; });
          udxPermChanged();
        }
        function udxPermChanged() {
          var checked = Array.prototype.slice.call(document.querySelectorAll('#udxCustomPerms .udx-perm-cb:checked'));
          var countEl = document.getElementById('udxPermCount');
          if (countEl) countEl.textContent = checked.length + ' selected';
          var strip = document.getElementById('udxSelChips');
          if (strip) {
            strip.innerHTML = '';
            if (!checked.length) {
              strip.style.display = 'none';
            } else {
              strip.style.display = '';
              checked.forEach(function(cb) {
                var chip = document.createElement('span'); chip.className = 'udx-selchip';
                var lbl  = document.createElement('span'); lbl.textContent = cb.getAttribute('data-name') || cb.value;
                var x    = document.createElement('button'); x.type = 'button'; x.innerHTML = '&#10005;';
                x.onclick = function(){ cb.checked = false; udxPermChanged(); };
                chip.appendChild(lbl); chip.appendChild(x); strip.appendChild(chip);
              });
            }
          }
          document.querySelectorAll('#udxPickBox .udx-pgroup').forEach(function(grp){
            var cbs   = Array.prototype.slice.call(grp.querySelectorAll('.udx-perm-cb'));
            var allOn = cbs.length > 0 && cbs.every(function(c){ return c.checked; });
            var sa    = grp.querySelector('.udx-selall');
            if (sa) sa.textContent = allOn ? 'Clear all' : 'Select all';
          });
          udxUpdateSummary();
        }

        // ── live summary line ──────────────────────────────────────────────
        function udxUpdateSummary() {
          var el = document.getElementById('udxSummary');
          if (!el) return;
          var scopeTxt;
          if (udxIsEdit) {
            scopeTxt = document.getElementById('udxEditScopeDisplay').textContent || 'this item';
          } else {
            var st = document.querySelector('input[name="scopeType"]:checked');
            if (st && st.value === 'item') {
              var sp = document.getElementById('udxScopeValue').value;
              scopeTxt = sp ? sp : '(no item selected yet)';
            } else {
              scopeTxt = 'all of Jenkins';
            }
          }
          var whatTxt;
          if (udxGrantWhat === 'custom') {
            var n = document.querySelectorAll('#udxCustomPerms .udx-perm-cb:checked').length;
            whatTxt = '<b>' + n + '</b> custom permission' + (n === 1 ? '' : 's');
          } else {
            var sel = document.getElementById('udxRoleSelect');
            var opt = sel.options[sel.selectedIndex];
            whatTxt = (opt && opt.value !== 'CUSTOM') ? ('the <b>' + udxEsc(opt.value) + '</b> role') : 'a role';
          }
          var atTxt = '';
          var st2 = document.querySelector('input[name="scopeType"]:checked');
          var scoped = udxIsEdit || (st2 && st2.value === 'item');
          if (scoped) {
            var at = document.querySelector('input[name="accessType"]:checked');
            atTxt = (at && at.value === 'JIT') ? ', <b>JIT</b>' : ', standing';
          }
          var exp = document.getElementById('udxExpiresAt').value;
          var expTxt = exp ? (', expires ' + udxEsc(exp)) : ', no expiry';
          el.innerHTML = 'Granting ' + whatTxt + ' on <b>' + udxEsc(scopeTxt) + '</b>' + atTxt + expTxt + '.';
        }

        function udxAccessTypeChange(val) {
          document.getElementById('udxJitFields').style.display = val === 'JIT' ? '' : 'none';
          udxUpdateSummary();
        }

        // ── Approver chip input ──────────────────────────────────────────────
        var udxApproverXhr = null;
        var udxSuggestBase = '${rootURL}/manage/omniauth-management/suggestApprovers';

        function udxChipAdd(value, chipsId, hiddenId) {
          if (!value || !value.trim()) return;
          var v = value.trim();
          var hidden = document.getElementById(hiddenId);
          var existing = hidden.value ? hidden.value.split(',').map(function(s){return s.trim();}) : [];
          if (existing.indexOf(v) >= 0) return; // no duplicates
          existing.push(v);
          hidden.value = existing.join(',');
          var chips = document.getElementById(chipsId);
          var chip = document.createElement('span');
          chip.style.cssText = 'display:inline-flex;align-items:center;gap:4px;padding:2px 8px 2px 10px;background:var(--oau-info-bg);color:var(--oau-info-fg);border-radius:12px;font-size:0.78em;font-weight:600;';
          // Build with DOM APIs (textContent / addEventListener), never innerHTML+onclick, so a
          // chip value containing quotes or angle brackets can't inject markup or break out of
          // the handler attribute.
          var chipLabel = document.createElement('span');
          chipLabel.textContent = v;
          var chipBtn = document.createElement('button');
          chipBtn.type = 'button';
          chipBtn.style.cssText = 'border:none;background:none;cursor:pointer;color:var(--oau-info-fg);font-size:0.9em;padding:0 0 0 2px;line-height:1;';
          chipBtn.innerHTML = '&#10005;';
          chipBtn.addEventListener('click', function() { udxChipRemove(v, chipsId, hiddenId); });
          chip.appendChild(chipLabel);
          chip.appendChild(chipBtn);
          chips.appendChild(chip);
          udxUpdateChipValidation(chipsId, hiddenId);
        }

        function udxChipRemove(value, chipsId, hiddenId) {
          var hidden = document.getElementById(hiddenId);
          var existing = hidden.value ? hidden.value.split(',').map(function(s){return s.trim();}) : [];
          hidden.value = existing.filter(function(s){return s !== value;}).join(',');
          var chips = document.getElementById(chipsId);
          chips.innerHTML = '';
          hidden.value.split(',').forEach(function(v) { if (v.trim()) udxChipAdd(v.trim(), chipsId, hiddenId); });
          // Re-add chips (simpler than finding the right chip element)
          // Actually, we already cleared chips, so re-render from hidden value
          // But we just added them above in the forEach... wait, udxChipAdd also sets hidden.value.
          // The trick: clear hidden first, then re-add.
          hidden.value = '';
          chips.innerHTML = '';
          existing.filter(function(s){return s.trim() && s.trim() !== value;}).forEach(function(v) {
            udxChipAdd(v.trim(), chipsId, hiddenId);
          });
          udxUpdateChipValidation(chipsId, hiddenId);
        }

        function udxClearChips(chipsId, hiddenId) {
          document.getElementById(chipsId).innerHTML = '';
          document.getElementById(hiddenId).value = '';
          udxUpdateChipValidation(chipsId, hiddenId);
        }

        function udxUpdateChipValidation(chipsId, hiddenId) {
          var hidden = document.getElementById(hiddenId);
          var count = hidden.value ? hidden.value.split(',').filter(function(s){return s.trim();}).length : 0;
          var validId = hiddenId.replace('Approvers','ApproverValidation');
          var valid = document.getElementById(validId);
          if (valid) valid.style.display = count < 2 && count > 0 ? '' : 'none';
        }

        function udxChipKeydown(event, inputId, dropId, chipsId, hiddenId) {
          if (event.key === 'Enter' || event.key === ',') {
            event.preventDefault();
            var input = document.getElementById(inputId);
            var v = input.value.trim().replace(/,$/, '');
            if (v) { udxChipAdd(v, chipsId, hiddenId); input.value = ''; }
            var drop = document.getElementById(dropId);
            if (drop) drop.style.display = 'none';
          }
        }

        function udxChipSearch(q, dropId, chipsId, hiddenId) {
          var drop = document.getElementById(dropId);
          if (!q.trim()) { drop.style.display = 'none'; return; }
          if (udxApproverXhr) udxApproverXhr.abort();
          udxApproverXhr = new XMLHttpRequest();
          var url = udxSuggestBase + '?q=' + encodeURIComponent(q);
          udxApproverXhr.open('GET', url, true);
          udxApproverXhr.onload = function() {
            if (udxApproverXhr.status !== 200) { drop.style.display = 'none'; return; }
            var users;
            try { users = JSON.parse(udxApproverXhr.responseText); } catch(e) { drop.style.display = 'none'; return; }
            if (!users || !users.length) { drop.style.display = 'none'; return; }
            drop.innerHTML = '';
            users.forEach(function(u) {
              var isGroup = u.type === 'group';
              var row = document.createElement('div');
              row.className = 'udx-suggest-row';
              var icon = document.createElement('span');
              icon.className = 'udx-suggest-icon';
              icon.innerHTML = isGroup
                ? '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>'
                : '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>';
              icon.style.color = isGroup ? '#7c3aed' : 'var(--blue)';
              icon.style.flexShrink = '0';
              row.appendChild(icon);
              var text = document.createElement('div');
              text.style.cssText = 'display:flex;flex-direction:column;gap:1px;min-width:0;';
              var nameEl = document.createElement('span');
              nameEl.className = 'udx-suggest-id';
              nameEl.textContent = u.id;
              text.appendChild(nameEl);
              if (u.displayName) {
                var dn = document.createElement('span');
                dn.className = 'udx-suggest-dn';
                dn.textContent = u.displayName;
                text.appendChild(dn);
              }
              row.appendChild(text);
              var chipEl = document.createElement('span');
              chipEl.className = 'udx-suggest-chip';
              chipEl.textContent = isGroup ? 'group' : 'user';
              chipEl.style.background = isGroup ? 'color-mix(in srgb, #7c3aed 13%, transparent)' : 'var(--oau-info-bg)';
              chipEl.style.color      = isGroup ? '#7c3aed' : 'var(--oau-info-fg)';
              row.appendChild(chipEl);
              row.onmousedown = function() {
                var inputEl = drop.previousElementSibling;
                udxChipAdd(u.id, chipsId, hiddenId);
                if (inputEl) inputEl.value = '';
                drop.style.display = 'none';
              };
              drop.appendChild(row);
            });
            drop.style.display = '';
          };
          udxApproverXhr.send();
        }
        function udxUpdateExpiryHint(val, hintId) {
          var hint = document.getElementById(hintId);
          if (!hint) return;
          if (!val) { hint.textContent = 'No expiry — access stays until revoked.'; hint.style.color = ''; return; }
          var d = new Date(val + 'T00:00:00');
          var opts = { year:'numeric', month:'long', day:'numeric' };
          hint.textContent = 'Access will be revoked after ' + d.toLocaleDateString(undefined, opts) + '.';
          hint.style.color = '';
        }

        // Render expiry badges from ISO strings
        document.addEventListener('DOMContentLoaded', function() {
          document.querySelectorAll('.udx-expiry-badge').forEach(function(el) {
            var iso = el.getAttribute('data-expires');
            if (!iso) return;
            var exp = new Date(iso);
            var now = new Date();
            var diffDays = Math.ceil((exp - now) / 86400000);
            var dateStr = exp.toLocaleDateString(undefined, { month:'short', day:'numeric', year:'numeric' });
            if (diffDays < 0) {
              el.textContent = 'Expired';
              el.classList.add('udx-expiry-soon');
            } else if (diffDays <= 7) {
              el.textContent = diffDays === 0 ? 'Expires today' : 'Expires in ' + diffDays + 'd';
              el.classList.add('udx-expiry-soon');
            } else {
              el.textContent = dateStr;
            }
          });
        });
        function udxScopeChange(val) {
          var itemDiv    = document.getElementById('udxItemInput');
          var scopeVal   = document.getElementById('udxScopeValue');
          var globalHid  = document.getElementById('udxScopeGlobal');
          var atSection  = document.getElementById('udxAccessTypeSection');
          if (val === 'item') {
            itemDiv.style.display = '';
            scopeVal.setAttribute('name', 'scope');
            globalHid.removeAttribute('name');
            if (atSection) atSection.style.display = '';
          } else {
            itemDiv.style.display = 'none';
            globalHid.setAttribute('name', 'scope');
            scopeVal.removeAttribute('name');
            if (atSection) atSection.style.display = 'none';
            // Reset to STANDING when switching to global
            document.querySelectorAll('input[name="accessType"]').forEach(function(r) { r.checked = r.value === 'STANDING'; });
            udxAccessTypeChange('STANDING');
          }
          udxUpdateSummary();
        }

        // --- Scope picker modal ---
        var udxScopeItems = ${it.allScopeNamesJson}; // [{path, type}, ...]
        var udxScopeTree  = null;
        var udxPending    = null;
        var udxArrowIdx   = -1;
        // House-style inline SVG icons for the scope picker (replace emoji; currentColor = theme-aware).
        var UDX_IC_FOLDER = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:block"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>';
        var UDX_IC_JOB    = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:block"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>';

        function udxBuildTree(items) {
          var root = {};
          items.forEach(function(item) {
            var parts = item.path.split('/');
            var node = root;
            var cur = '';
            parts.forEach(function(part) {
              cur = cur ? cur + '/' + part : part;
              if (!node[part]) node[part] = { _path: cur, _type: item.type, _children: {} };
              node = node[part]._children;
            });
          });
          return root;
        }

        function udxModalOpen() {
          if (!udxScopeTree) udxScopeTree = udxBuildTree(udxScopeItems);
          udxPending  = document.getElementById('udxScopeValue').value || null;
          udxArrowIdx = -1;
          var modal = document.getElementById('udxScopeModal');
          modal.style.opacity = '1';
          modal.style.pointerEvents = 'auto';
          var box = modal.querySelector('[data-modal-box]');
          if (box) {
            var btn = document.getElementById('udxScopeBtn');
            if (btn) {
              var r = btn.getBoundingClientRect();
              var dx = (r.left + r.width  / 2) - window.innerWidth  / 2;
              var dy = (r.top  + r.height / 2) - window.innerHeight / 2;
              box.style.setProperty('--genie-dx', dx.toFixed(1) + 'px');
              box.style.setProperty('--genie-dy', dy.toFixed(1) + 'px');
            }
            box.style.animation = 'none'; box.offsetHeight; box.style.animation = 'udxModalIn 0.45s cubic-bezier(0.34,1.56,0.64,1)';
          }
          var search = document.getElementById('udxModalSearch');
          search.value = '';
          udxModalFilter('');
          udxModalFooter();
          if (udxPending) {
            setTimeout(function() {
              var rows = document.querySelectorAll('.udx-mrow');
              for (var i = 0; i < rows.length; i++) {
                if (rows[i].getAttribute('data-path') === udxPending) {
                  rows[i].scrollIntoView({ block: 'center' });
                  break;
                }
              }
            }, 30);
          }
          setTimeout(function(){ search.focus(); }, 60);
          document.addEventListener('keydown', udxModalKey);
        }

        function udxModalClose() {
          var modal = document.getElementById('udxScopeModal');
          var box   = modal.querySelector('[data-modal-box]');
          document.removeEventListener('keydown', udxModalKey);
          udxArrowIdx = -1;
          modal.style.pointerEvents = 'none';
          if (box) {
            var btn = document.getElementById('udxScopeBtn');
            if (btn) {
              var r = btn.getBoundingClientRect();
              var dx = (r.left + r.width  / 2) - window.innerWidth  / 2;
              var dy = (r.top  + r.height / 2) - window.innerHeight / 2;
              box.style.setProperty('--genie-dx', dx.toFixed(1) + 'px');
              box.style.setProperty('--genie-dy', dy.toFixed(1) + 'px');
            }
            box.style.animation = 'udxModalOut 0.28s ease-in forwards';
            setTimeout(function() { modal.style.opacity = '0'; }, 240);
          } else {
            modal.style.opacity = '0';
          }
        }

        function udxModalConfirm() {
          if (!udxPending) return;
          var selItem = udxScopeItems.find(function(i){ return i.path === udxPending; });
          document.getElementById('udxScopeValue').value = udxPending;
          var lbl  = document.getElementById('udxScopeLbl');
          var icon = document.getElementById('udxScopeIcon');
          lbl.textContent  = udxPending;
          lbl.style.color  = 'inherit';
          icon.innerHTML = (selItem && selItem.type === 'folder') ? UDX_IC_FOLDER : UDX_IC_JOB;
          document.getElementById('udxScopeClear').style.display = 'inline-flex';
          udxModalClose();
          udxUpdateSummary();
        }

        function udxScopeClearFn() {
          document.getElementById('udxScopeValue').value = '';
          var lbl  = document.getElementById('udxScopeLbl');
          var icon = document.getElementById('udxScopeIcon');
          lbl.textContent  = 'Select a job or folder…';
          lbl.style.color  = '';
          icon.innerHTML = UDX_IC_FOLDER;
          document.getElementById('udxScopeClear').style.display = 'none';
          udxPending = null;
          udxUpdateSummary();
        }

        function udxModalKey(e) {
          if (e.key === 'Escape') { udxModalClose(); return; }
          var rows = Array.from(document.querySelectorAll('.udx-mrow'));
          if (!rows.length) return;
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            udxArrowIdx = Math.min(udxArrowIdx + 1, rows.length - 1);
            udxArrowFocus(rows);
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            udxArrowIdx = Math.max(udxArrowIdx - 1, 0);
            udxArrowFocus(rows);
          } else if (e.key === 'Enter') {
            if (udxArrowIdx >= 0 && rows[udxArrowIdx]) {
              udxModalPick(rows[udxArrowIdx].getAttribute('data-path'));
            } else if (udxPending) {
              udxModalConfirm();
            }
          }
        }

        function udxArrowFocus(rows) {
          rows.forEach(function(r, i) {
            var isFocus = i === udxArrowIdx;
            var isSel   = r.getAttribute('data-path') === udxPending;
            r.style.background = isFocus ? 'var(--oau-info-bg)' : (isSel ? 'var(--oau-info-bg)' : '');
            r.style.outline    = isFocus ? '2px solid var(--blue)' : 'none';
          });
          if (rows[udxArrowIdx]) rows[udxArrowIdx].scrollIntoView({ block: 'nearest' });
        }

        function udxModalPick(path) {
          udxPending  = path;
          udxArrowIdx = -1;
          udxModalFooter();
          document.querySelectorAll('.udx-mrow').forEach(function(r) {
            var sel = r.getAttribute('data-path') === path;
            r.style.background = sel ? 'var(--oau-info-bg)' : '';
            r.style.fontWeight = sel ? '600'     : '';
            r.style.color      = sel ? 'var(--oau-info-fg)' : '';
            r.style.outline    = 'none';
            r.style.borderLeftColor = sel ? 'var(--blue)' : 'transparent';
          });
        }

        function udxModalFooter() {
          var lbl = document.getElementById('udxModalLbl');
          var btn = document.getElementById('udxModalOk');
          if (udxPending) {
            lbl.textContent = udxPending;
            lbl.style.color = 'var(--text-color)';
            btn.removeAttribute('disabled');
          } else {
            lbl.textContent = 'Nothing selected';
            lbl.style.color = '#aaa';
            btn.setAttribute('disabled', 'disabled');
          }
        }

        function udxModalFilter(q) {
          var body = document.getElementById('udxModalBody');
          body.innerHTML = '';
          udxArrowIdx = -1;
          if (!q) {
            udxModalRenderTree(udxScopeTree, body, 0);
            return;
          }
          var lq   = q.toLowerCase();
          var hits = udxScopeItems.filter(function(i){ return i.path.toLowerCase().indexOf(lq) >= 0; });

          // Result count
          var countBar = document.createElement('div');
          countBar.style.cssText = 'padding:8px 24px 4px;font-size:0.75em;color:#bbb;font-weight:600;letter-spacing:0.05em;text-transform:uppercase;';
          countBar.textContent = hits.length + (hits.length === 1 ? ' result' : ' results');
          body.appendChild(countBar);

          if (!hits.length) {
            body.innerHTML = '<div style="padding:48px;text-align:center;color:#ccc;font-size:0.9em;">No matching jobs or folders</div>';
            return;
          }

          hits.forEach(function(item) {
            var path   = item.path;
            var isFolder = item.type === 'folder';
            var parts  = path.split('/');
            var name   = parts[parts.length - 1];
            var parent = parts.length > 1 ? parts.slice(0, -1).join('/') : '';
            var sel    = path === udxPending;

            var row = document.createElement('div');
            row.className = 'udx-mrow';
            row.setAttribute('data-path', path);
            row.style.cssText = 'display:flex;align-items:center;gap:12px;padding:10px 24px;cursor:pointer;'
              + 'border-left:4px solid transparent;transition:background 0.12s;'
              + (sel ? 'background:var(--oau-info-bg);border-left-color:var(--blue);' : '');
            row.onmouseenter = function(){ if(this.getAttribute('data-path')!==udxPending) this.style.background='var(--oau-neutral-bg)'; };
            row.onmouseleave = function(){ if(this.getAttribute('data-path')!==udxPending) this.style.background=''; };

            // Icon
            var iconEl = document.createElement('span');
            iconEl.style.cssText = 'flex-shrink:0;display:inline-flex;';
            iconEl.innerHTML = isFolder
              ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--warning-color)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V7z"/></svg>'
              : '<svg width="18" height="18" viewBox="0 0 24 24" fill="var(--blue)" stroke="none"><polygon points="6,3 20,12 6,21"/></svg>';

            // Text block
            var textEl = document.createElement('div');
            textEl.style.cssText = 'display:flex;flex-direction:column;gap:2px;min-width:0;';

            // Name with match highlight
            var lo = name.toLowerCase().indexOf(lq);
            var nameEl = document.createElement('div');
            nameEl.style.cssText = 'font-size:0.93em;font-weight:' + (sel ? '700' : '500') + ';color:' + (sel ? 'var(--oau-info-fg)' : 'var(--text-color)') + ';white-space:nowrap;overflow:hidden;text-overflow:ellipsis;';
            if (lo >= 0) {
              nameEl.innerHTML = name.substring(0,lo)
                + '<mark style="background:rgba(26,115,232,0.15);color:var(--oau-info-fg);border-radius:2px;padding:0 2px;">'
                + name.substring(lo, lo+q.length) + '</mark>'
                + name.substring(lo+q.length);
            } else {
              nameEl.textContent = name;
            }

            // Parent path
            if (parent) {
              var parentEl = document.createElement('div');
              parentEl.style.cssText = 'font-size:0.78em;color:#bbb;font-family:monospace;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;';
              parentEl.textContent = parent;
              textEl.appendChild(nameEl);
              textEl.appendChild(parentEl);
            } else {
              textEl.appendChild(nameEl);
            }

            row.appendChild(iconEl);
            row.appendChild(textEl);
            row.onclick = function(){ udxModalPick(path); };
            body.appendChild(row);
          });
        }

        function udxModalRenderTree(nodeMap, container, depth) {
          Object.keys(nodeMap).sort(function(a,b){ return a.toLowerCase().localeCompare(b.toLowerCase()); })
            .forEach(function(key) {
              var n       = nodeMap[key];
              var hasKids = Object.keys(n._children).length > 0;
              var sel     = n._path === udxPending;
              var pad     = 20 + depth * 20;

              var row = document.createElement('div');
              row.className = 'udx-mrow';
              row.setAttribute('data-path', n._path);
              row.style.cssText = 'display:flex;align-items:center;gap:8px;padding:10px 20px 10px ' + pad + 'px;'
                + 'cursor:pointer;font-size:0.93em;border-left:4px solid transparent;transition:background 0.12s;'
                + (sel ? 'background:var(--oau-info-bg);font-weight:600;color:var(--oau-info-fg);border-left-color:var(--blue);' : '');
              row.onmouseenter = function(){ if(this.getAttribute('data-path')!==udxPending) this.style.background='var(--oau-neutral-bg)'; };
              row.onmouseleave = function(){ if(this.getAttribute('data-path')!==udxPending) this.style.background = sel ? 'var(--oau-info-bg)' : ''; };

              if (hasKids) {
                var arr = document.createElement('span');
                arr.style.cssText = 'width:18px;height:18px;flex-shrink:0;display:inline-flex;align-items:center;'
                  + 'justify-content:center;cursor:pointer;transition:transform 0.15s;color:#bbb;';
                arr.innerHTML = '<svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M3 2l4 3-4 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
                var kids = document.createElement('div');
                var shouldExpand = udxPending && (udxPending === n._path || udxPending.indexOf(n._path + '/') === 0);
                kids.style.display = shouldExpand ? '' : 'none';
                if (shouldExpand) arr.style.transform = 'rotate(90deg)';
                arr.onclick = function(e) {
                  e.stopPropagation();
                  var open = kids.style.display !== 'none';
                  kids.style.display = open ? 'none' : '';
                  arr.style.transform = open ? '' : 'rotate(90deg)';
                };
                var icon = document.createElement('span');
                icon.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--warning-color)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V7z"/></svg>';
                icon.style.cssText = 'flex-shrink:0;display:inline-flex;';
                var lbl = document.createElement('span'); lbl.textContent = key;
                lbl.style.cssText = 'min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;';
                row.appendChild(arr); row.appendChild(icon); row.appendChild(lbl);
                row.onclick = function(){ udxModalPick(n._path); };
                container.appendChild(row);
                udxModalRenderTree(n._children, kids, depth + 1);
                container.appendChild(kids);
              } else {
                var spacer = document.createElement('span'); spacer.style.cssText = 'width:18px;flex-shrink:0;';
                var icon = document.createElement('span');
                icon.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="var(--blue)" stroke="none"><polygon points="6,3 20,12 6,21"/></svg>';
                icon.style.cssText = 'flex-shrink:0;display:inline-flex;';
                var lbl = document.createElement('span'); lbl.textContent = key;
                lbl.style.cssText = 'min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;';
                row.appendChild(spacer); row.appendChild(icon); row.appendChild(lbl);
                row.onclick = function(){ udxModalPick(n._path); };
                container.appendChild(row);
              }
            });
        }
      //]]></script>

    <!-- Conflict detection modal -->
    <div id="udxConflictModal"
         style="display:none;position:fixed;inset:0;z-index:10000;background:rgba(0,0,0,0.45);
                align-items:center;justify-content:center;">
      <div style="background:var(--oau-card-bg);border-radius:12px;padding:28px 32px;
                  max-width:460px;width:90%;box-shadow:0 20px 60px rgba(0,0,0,0.22);">
        <div style="display:flex;align-items:flex-start;gap:14px;margin-bottom:16px;">
          <div style="flex-shrink:0;margin-top:2px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none"
                 stroke="var(--warning-color)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
              <line x1="12" y1="9" x2="12" y2="13"/><circle cx="12" cy="17" r="1" fill="var(--warning-color)" stroke="none"/>
            </svg>
          </div>
          <div>
            <div style="font-weight:700;font-size:1em;margin-bottom:6px;">User already has global Admin access</div>
            <div style="font-size:0.875em;color:var(--text-color-secondary,#555);line-height:1.55;">
              <strong id="udxConflictSid"></strong> has an existing global Administrator role which grants
              full Jenkins access. A scoped assignment will have no effect — the Admin role supersedes all restrictions.
            </div>
          </div>
        </div>
        <div style="font-size:0.82em;color:var(--warning-color);background:var(--oau-warning-bg);border:1px solid var(--oau-warning-border);
                    border-radius:6px;padding:10px 12px;margin-bottom:22px;line-height:1.5;">
          Consider removing the global Admin role first if you intend to restrict this user to a specific scope.
        </div>
        <div style="display:flex;gap:10px;justify-content:flex-end;">
          <button type="button" onclick="udxConflictCancel()" class="jenkins-button" style="font-size:0.88em;">Cancel</button>
          <button type="button" onclick="udxConflictProceed()"
                  style="font-size:0.88em;padding:7px 16px;border-radius:6px;cursor:pointer;
                         background:var(--warning-color);color:#fff;border:1px solid var(--warning-color);font-weight:600;">
            Add Anyway
          </button>
        </div>
      </div>
    </div>

    <!-- Scope picker modal -->
    <div id="udxScopeModal" onclick="if(event.target===this)udxModalClose()"
         style="display:flex;opacity:0;pointer-events:none;position:fixed;inset:0;z-index:9999;
                background:rgba(15,20,30,0.5);backdrop-filter:blur(3px);
                align-items:center;justify-content:center;transition:opacity 0.32s;">
      <div data-modal-box="1" style="background:#fff;border-radius:14px;width:660px;max-width:94vw;
                  box-shadow:0 32px 80px rgba(0,0,0,0.24);animation:udxModalIn 0.45s cubic-bezier(0.34,1.56,0.64,1);
                  transform-origin:50% 50%;will-change:transform,opacity;
                  display:flex;flex-direction:column;max-height:84vh;overflow:hidden;">

        <!-- Header -->
        <div style="display:flex;align-items:center;justify-content:space-between;
                    padding:22px 24px 16px;border-bottom:1px solid var(--oau-neutral-bg);">
          <div>
            <div style="font-size:1.05em;font-weight:700;color:var(--text-color);letter-spacing:-0.02em;">Select Job or Folder</div>
            <div style="font-size:0.8em;color:#aaa;margin-top:3px;font-weight:400;">Choose where to apply this access grant</div>
          </div>
          <button type="button" onclick="udxModalClose()"
                  style="background:none;border:none;cursor:pointer;width:34px;height:34px;
                         border-radius:8px;font-size:1.1em;color:#bbb;display:flex;
                         align-items:center;justify-content:center;flex-shrink:0;transition:background 0.12s,color 0.12s;"
                  onmouseenter="this.style.background='var(--oau-card-border)';this.style.color='#333'"
                  onmouseleave="this.style.background='none';this.style.color='#bbb'">&#x2715;</button>
        </div>

        <!-- Search -->
        <div style="padding:14px 20px;border-bottom:1px solid var(--oau-neutral-bg);">
          <div style="position:relative;display:flex;align-items:center;">
            <svg style="position:absolute;left:13px;color:#bbb;pointer-events:none;flex-shrink:0;" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#bbb" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="22" y2="22"/></svg>
            <input id="udxModalSearch" type="text" placeholder="Search jobs and folders…"
                   style="width:100%;box-sizing:border-box;padding:11px 14px 11px 38px;
                          border:1.5px solid var(--oau-card-border);border-radius:9px;font-size:0.93em;
                          outline:none;transition:border-color 0.15s,box-shadow 0.15s;color:#222;background:var(--oau-neutral-bg);"
                   oninput="udxModalFilter(this.value)"
                   onfocus="this.style.borderColor='var(--blue)';this.style.boxShadow='0 0 0 3px rgba(26,115,232,0.12)';this.style.background='#fff'"
                   onblur="this.style.borderColor='var(--oau-card-border)';this.style.boxShadow='none';this.style.background='var(--oau-neutral-bg)'"/>
          </div>
        </div>

        <!-- Tree body -->
        <div id="udxModalBody" style="flex:1;overflow-y:auto;padding:8px 0;min-height:260px;"/>

        <!-- Footer -->
        <div style="padding:16px 24px;border-top:1px solid var(--oau-neutral-bg);
                    display:flex;align-items:center;justify-content:space-between;gap:16px;
                    background:var(--oau-neutral-bg);border-radius:0 0 14px 14px;">
          <div style="flex:1;min-width:0;">
            <div style="font-size:0.7em;font-weight:700;text-transform:uppercase;
                        letter-spacing:0.07em;color:#ccc;margin-bottom:4px;">Selected</div>
            <div id="udxModalLbl" style="font-size:0.86em;color:#aaa;font-family:monospace;
                 white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">Nothing selected</div>
          </div>
          <div style="display:flex;gap:8px;flex-shrink:0;">
            <button type="button" onclick="udxModalClose()"
                    class="jenkins-button" style="font-size:0.88em;padding:8px 18px;">Cancel</button>
            <button type="button" id="udxModalOk" onclick="udxModalConfirm()"
                    class="jenkins-button jenkins-button--primary"
                    style="font-size:0.88em;padding:8px 18px;" disabled="disabled">Select &#8594;</button>
          </div>
        </div>

      </div>
    </div>

    </l:main-panel>
  </l:layout>
</j:jelly>
