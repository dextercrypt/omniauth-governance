<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">

  <l:layout title="OmniAuth — Backup &amp; Restore" norefresh="true">
    <l:side-panel>
      <st:include page="sidepanel.jelly"/>
    </l:side-panel>
    <l:main-panel>

      <st:adjunct includes="io.jenkins.plugins.omniauth.OmniAuthManagementLink.backupAssets"/>

      <div class="jenkins-app-bar">
        <div class="jenkins-app-bar__content">
          <h1 class="jenkins-app-bar__heading">Backup &amp; Restore</h1>
        </div>
      </div>

      <div style="padding: 16px 24px; max-width: 860px;">

        <!-- Status messages -->
        <j:if test="${request2.getParameter('imported') == '1'}">
          <div class="jenkins-alert jenkins-alert-success" style="margin-bottom: 20px;">
            Configuration imported — ${request2.getParameter('roles')} role(s),
            ${request2.getParameter('assignments')} assignment(s),
            ${request2.getParameter('groups')} group(s). If you imported from another controller,
            re-enter your secrets (Entra client secret, SMTP password, Slack/Teams webhooks) on the
            relevant pages.
          </div>
        </j:if>
        <j:if test="${request2.getParameter('reverted') == '1'}">
          <div class="jenkins-alert jenkins-alert-success" style="margin-bottom: 20px;">
            Restored to the chosen point.
          </div>
        </j:if>
        <j:if test="${request2.getParameter('error') != null}">
          <div class="jenkins-alert jenkins-alert-danger" style="margin-bottom: 20px;">
            ${request2.getParameter('error')}
          </div>
        </j:if>

        <!-- What this does -->
        <div class="jenkins-card" style="padding: 16px 20px; margin-bottom: 20px;">
          <p style="margin: 0 0 8px 0; color: var(--text-color-secondary); font-size: 0.9em;">
            Back up and restore OmniAuth <strong>roles, assignments, Access-Management groups, and
            global settings</strong> as a portable YAML file — useful for replicating access
            configuration onto another controller.
          </p>
          <p style="margin: 0; color: var(--text-color-secondary); font-size: 0.85em;">
            The sign-in / security realm and all secrets are <strong>not</strong> included, so an
            import never changes how you log in. After restoring onto a different controller,
            re-enter secrets on their pages.
          </p>
        </div>

        <!-- Export -->
        <div class="jenkins-card" style="padding: 0; margin-bottom: 20px; overflow: hidden;">
          <div style="padding: 14px 20px; border-bottom: 1px solid var(--oau-card-border);">
            <h3 style="margin: 0; font-size: 0.95em; font-weight: 600;">Export</h3>
          </div>
          <div style="padding: 16px 20px;">
            <p style="margin: 0 0 12px 0; color: var(--text-color-secondary); font-size: 0.85em;">
              Download the current configuration as a YAML file.
            </p>
            <form method="post" action="exportConfig">
              <input type="hidden" name="${app.crumbRequestField}" value="${app.crumb}"/>
              <button type="submit" class="jenkins-button jenkins-button--primary">
                Export configuration
              </button>
            </form>
          </div>
        </div>

        <!-- Import -->
        <div class="jenkins-card" style="padding: 0; margin-bottom: 20px; overflow: hidden;">
          <div style="padding: 14px 20px; border-bottom: 1px solid var(--oau-card-border);">
            <h3 style="margin: 0; font-size: 0.95em; font-weight: 600;">Import / Restore</h3>
          </div>
          <div style="padding: 16px 20px;">
            <p style="margin: 0 0 12px 0; color: var(--text-color-secondary); font-size: 0.85em;">
              Choose a backup file (or paste its contents), then review the plan. Importing
              <strong>replaces</strong> the current roles, assignments, groups and settings. A restore
              point is saved first, so you can roll back.
            </p>
            <form method="post" action="importConfig" id="bkImportForm">
              <input type="hidden" name="${app.crumbRequestField}" value="${app.crumb}"/>
              <input type="file" id="bkFile" accept=".yaml,.yml,.txt"
                     class="jenkins-input" style="margin-bottom: 12px; display: block;"/>
              <textarea name="config" id="bkConfig" rows="8"
                        placeholder="Backup file contents appear here (or paste them)."
                        class="jenkins-input" style="width: 100%; font-family: monospace; font-size: 0.8em;"></textarea>
              <div style="margin-top: 12px;">
                <button type="button" id="bkPreviewBtn" class="jenkins-button jenkins-button--primary">
                  Review changes &amp; import
                </button>
              </div>
            </form>
          </div>
        </div>

        <!-- Revert / restore points -->
        <j:if test="${it.revertAvailable}">
          <div class="jenkins-card" style="padding: 0; margin-bottom: 20px; overflow: hidden;">
            <div style="padding: 14px 20px; border-bottom: 1px solid var(--oau-card-border);">
              <h3 style="margin: 0; font-size: 0.95em; font-weight: 600;">Restore points</h3>
            </div>
            <div style="padding: 16px 20px;">
              <p style="margin: 0 0 12px 0; color: var(--text-color-secondary); font-size: 0.85em;">
                A snapshot is saved automatically before each import. Roll back to any of the last five.
              </p>
              <table class="jenkins-table" style="width: 100%;">
                <thead>
                  <tr>
                    <th>Taken</th>
                    <th>Contents</th>
                    <th style="text-align: right;">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <j:forEach var="s" items="${it.snapshots}">
                    <tr>
                      <td>${s.displayTime}</td>
                      <td style="color: var(--text-color-secondary);">
                        ${s.roles} role(s), ${s.assignments} assignment(s), ${s.groups} group(s)
                      </td>
                      <td style="text-align: right;">
                        <form method="post" action="revertImport" class="bkRevertForm"
                              style="display: inline;" data-when="${s.displayTime}">
                          <input type="hidden" name="${app.crumbRequestField}" value="${app.crumb}"/>
                          <input type="hidden" name="snapshot" value="${s.fileName}"/>
                          <button type="submit" class="jenkins-button">Roll back to this</button>
                        </form>
                      </td>
                    </tr>
                  </j:forEach>
                </tbody>
              </table>
            </div>
          </div>
        </j:if>

        <!-- Import history -->
        <j:if test="${it.historyAvailable}">
          <div class="jenkins-card" style="padding: 0; margin-bottom: 20px; overflow: hidden;">
            <div style="padding: 14px 20px; border-bottom: 1px solid var(--oau-card-border);">
              <h3 style="margin: 0; font-size: 0.95em; font-weight: 600;">Recent activity</h3>
            </div>
            <div style="padding: 16px 20px;">
              <table class="jenkins-table" style="width: 100%;">
                <thead>
                  <tr>
                    <th>When</th>
                    <th>Who</th>
                    <th>Action</th>
                    <th>What changed</th>
                  </tr>
                </thead>
                <tbody>
                  <j:forEach var="h" items="${it.importHistory}">
                    <tr>
                      <td style="white-space: nowrap;">${h.displayTime}</td>
                      <td>${h.user}</td>
                      <td style="text-transform: capitalize;">${h.action}</td>
                      <td style="color: var(--text-color-secondary);">${h.summary}</td>
                    </tr>
                  </j:forEach>
                </tbody>
              </table>
            </div>
          </div>
        </j:if>

      </div>

      <!-- Plan modal -->
      <div id="bkPlanOverlay" style="display: none; position: fixed; inset: 0; z-index: 1000;
           background: rgba(0,0,0,0.5); align-items: flex-start; justify-content: center;">
        <div class="jenkins-card" style="margin-top: 7vh; width: 92%; max-width: 680px; max-height: 80vh;
             display: flex; flex-direction: column; padding: 0; overflow: hidden;">
          <div style="padding: 16px 20px; border-bottom: 1px solid var(--oau-card-border);">
            <h2 id="bkPlanTitle" style="margin: 0; font-size: 1.05em;">Import plan</h2>
            <p id="bkPlanSubtitle" style="margin: 6px 0 0 0; color: var(--text-color-secondary); font-size: 0.85em;">
              These changes will be applied to the live configuration. A restore point is saved first.
            </p>
          </div>
          <div id="bkPlanBody" style="padding: 16px 20px; overflow-y: auto; flex: 1 1 auto;"></div>
          <div style="padding: 14px 20px; border-top: 1px solid var(--oau-card-border);
               display: flex; gap: 10px; justify-content: flex-end;">
            <button type="button" id="bkPlanCancel" class="jenkins-button">Cancel</button>
            <button type="button" id="bkPlanApply" class="jenkins-button jenkins-button--primary">
              Apply import
            </button>
          </div>
        </div>
      </div>

    </l:main-panel>
  </l:layout>
</j:jelly>
