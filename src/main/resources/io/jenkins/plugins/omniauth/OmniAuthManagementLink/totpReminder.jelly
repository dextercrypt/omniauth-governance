<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">

  <j:set var="skips"    value="${it.currentUserEnrollSkips}"/>
  <j:set var="forced"   value="${it.breakGlassEnrollmentForced}"/>
  <j:set var="afterThis" value="${it.breakGlassSkipsAfterThis}"/>

  <l:layout title="OmniAuth — Authenticator Setup" norefresh="true">
    <l:main-panel>
      <st:adjunct includes="io.jenkins.plugins.omniauth.oau.oau"/>
      <st:adjunct includes="io.jenkins.plugins.omniauth.OmniAuthManagementLink.totpReminderAssets"/>

      <j:if test="${!forced}">
        <div class="jenkins-app-bar">
          <div class="jenkins-app-bar__content">
            <h1 class="jenkins-app-bar__heading">Set Up Your Break Glass Authenticator</h1>
          </div>
        </div>
      </j:if>

      <j:choose>

          <!-- ══ FORCED MODE ═══════════════════════════════════════════════════ -->
          <j:when test="${forced}">
            <div style="min-height:70vh; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:32px 24px;">
            <div style="width:100%; max-width:600px;">

            <!-- Action-required banner -->
            <div style="display:flex; align-items:center; gap:12px; padding:12px 16px; background:var(--oau-danger-bg); border:1px solid var(--oau-danger-border); border-radius:8px; margin-bottom:20px;">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--oau-danger-fg)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><circle cx="12" cy="16" r="0.5" fill="var(--oau-danger-fg)"/>
              </svg>
              <span style="font-size:0.88em; color:var(--oau-danger-fg);"><strong>Action Required</strong> — You've used all 3 reminders. Enroll a TOTP device to continue using Jenkins.</span>
            </div>

            <!-- Enrollment card -->
            <div class="jenkins-card" style="padding:0; overflow:hidden;">

              <!-- Card header -->
              <div style="padding:18px 24px; border-bottom:1px solid var(--oau-card-border); background:linear-gradient(135deg,var(--oau-danger-bg) 0%,#fff 100%);">
                <div style="display:flex; align-items:center; gap:14px;">
                  <div style="flex-shrink:0; width:48px; height:48px; border-radius:50%; background:var(--oau-danger-bg); display:flex; align-items:center; justify-content:center;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--error-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="5" y="11" width="14" height="10" rx="2"/><path d="M12 3a4 4 0 0 1 4 4v4H8V7a4 4 0 0 1 4-4z"/>
                    </svg>
                  </div>
                  <div>
                    <div style="font-size:1em; font-weight:700; color:var(--text-color); margin-bottom:3px;">Enroll Your Authenticator</div>
                    <div style="font-size:0.83em; color:var(--text-color-secondary); line-height:1.4;">
                      This is a one-time setup. Scan the QR code into any TOTP app — takes under 2 minutes.
                    </div>
                  </div>
                </div>
              </div>

              <div style="padding:24px;">

                <!-- Device name -->
                <div style="margin-bottom:18px;">
                  <label style="display:block; font-size:0.88em; font-weight:600; margin-bottom:4px;">Device name</label>
                  <input id="device-name" type="text" class="jenkins-input" style="width:280px;"
                         placeholder="e.g. iPhone — Google Authenticator"/>
                  <div style="font-size:0.78em; color:var(--text-color-secondary); margin-top:4px;">Helps you identify this device later.</div>
                </div>

                <!-- Loading -->
                <div id="step-loading" style="text-align:center; padding:28px; color:var(--text-color-secondary); display:none;">
                  <div style="font-size:0.9em;">Generating QR code…</div>
                </div>

                <!-- Step 1: Generate -->
                <div id="step-generate">
                  <div style="font-size:0.85em; color:var(--text-color-secondary); margin-bottom:14px; line-height:1.6;">
                    Open your authenticator app (Google Authenticator, Microsoft Authenticator, Authy, or any TOTP app)
                    and scan the QR code you'll generate below.
                  </div>
                  <button type="button" class="jenkins-button jenkins-button--primary" id="btn-generate-qr">
                    Generate QR Code
                  </button>
                </div>

                <!-- Step 2: QR + verify -->
                <div id="step-qr" style="display:none;">
                  <ol style="margin:0 0 18px; padding-left:20px; font-size:0.88em; color:var(--text-color-secondary); line-height:2;">
                    <li>Open your authenticator app and tap <strong>+</strong> → <strong>Scan QR code</strong></li>
                    <li>Scan the code below (scan into all apps you want before confirming)</li>
                    <li>Enter the 6-digit code shown in your app to confirm</li>
                  </ol>
                  <div style="display:flex; gap:28px; align-items:flex-start; flex-wrap:wrap;">
                    <div>
                      <img id="qr-img" src="" alt="TOTP QR Code"
                           style="width:190px; height:190px; border:1px solid var(--oau-card-border); border-radius:10px; display:block;"/>
                      <div style="margin-top:6px; font-size:0.75em; color:var(--text-color-secondary); text-align:center;">
                        Scan with authenticator app
                      </div>
                    </div>
                    <div style="flex:1; min-width:200px;">
                      <div style="margin-bottom:14px;">
                        <div style="font-size:0.82em; font-weight:600; margin-bottom:4px; color:var(--text-color-secondary);">Manual entry key</div>
                        <div id="secret-display" style="font-family:monospace; font-size:0.82em; background:var(--background,var(--oau-neutral-bg)); border:1px solid var(--oau-card-border); border-radius:6px; padding:8px 12px; letter-spacing:2px; word-break:break-all;"></div>
                        <div style="font-size:0.75em; color:var(--text-color-secondary); margin-top:3px;">Use this if you can't scan.</div>
                      </div>
                      <div style="margin-bottom:14px;">
                        <label style="display:block; font-size:0.88em; font-weight:600; margin-bottom:6px;">
                          Verify — enter 6-digit code from your app
                        </label>
                        <input id="verify-code" type="text" inputmode="numeric" maxlength="6" autocomplete="off"
                               placeholder="123456" class="jenkins-input"
                               style="width:140px; letter-spacing:4px; font-size:1.1em; text-align:center;"/>
                      </div>
                      <div id="verify-err" style="display:none; margin-bottom:12px; padding:8px 12px; background:var(--oau-danger-bg); border:1px solid var(--oau-danger-border); border-radius:6px; font-size:0.85em; color:var(--oau-danger-fg);"></div>
                      <button type="button" id="btn-verify" class="jenkins-button jenkins-button--primary">
                        Confirm &amp; Save
                      </button>
                    </div>
                  </div>
                </div>

                <!-- Step 3: Success -->
                <div id="step-success" style="display:none; text-align:center; padding:36px 0 20px;">
                  <div style="width:64px; height:64px; border-radius:50%; background:var(--oau-success-bg); display:flex; align-items:center; justify-content:center; margin:0 auto 16px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--oau-success-fg)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                  </div>
                  <div style="font-size:1.05em; font-weight:700; color:var(--oau-success-fg); margin-bottom:6px;">Authenticator enrolled!</div>
                  <div style="font-size:0.85em; color:var(--text-color-secondary); margin-bottom:20px;">
                    You can now use Emergency Override on the Security page. Redirecting…
                  </div>
                  <div style="height:4px; background:var(--oau-card-border); border-radius:2px; max-width:260px; margin:0 auto; overflow:hidden;">
                    <div id="success-bar" style="height:100%; width:100%; background:var(--oau-success-fg); transition:width 1.5s linear;"></div>
                  </div>
                </div>

              </div>
            </div>

            </div><!-- /max-width -->
            </div><!-- /flex center -->

          </j:when>

          <!-- ══ REMINDER MODE ═════════════════════════════════════════════════ -->
          <j:otherwise>
            <div style="min-height:70vh; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:32px 24px;">
            <div style="width:100%; max-width:600px;">

            <div class="jenkins-card" style="padding:36px 32px; border-left:4px solid var(--oau-warning-border);">

              <!-- Icon -->
              <div style="display:flex; justify-content:center; margin-bottom:22px;">
                <div style="width:68px; height:68px; border-radius:50%; background:var(--oau-warning-bg); display:flex; align-items:center; justify-content:center; box-shadow:0 0 0 8px var(--oau-warning-bg);">
                  <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="var(--warning-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  </svg>
                </div>
              </div>

              <!-- Heading -->
              <h2 style="text-align:center; margin:0 0 10px; font-size:1.15em; font-weight:700; color:var(--text-color);">
                Set Up Your Break Glass Authenticator
              </h2>
              <p style="text-align:center; margin:0 auto 22px; max-width:460px; font-size:0.88em; color:var(--text-color-secondary); line-height:1.65;">
                As a Jenkins administrator, enrolling a TOTP device lets you activate
                <strong>Emergency Override</strong> — an audited safety mechanism for recovery
                scenarios where direct access to the Authorization table is needed.
              </p>

              <!-- Reminder dots -->
              <div style="display:flex; align-items:center; justify-content:center; gap:8px; margin-bottom:26px;">
                <span style="font-size:0.78em; color:var(--text-color-secondary); margin-right:4px;">Reminders used:</span>
                <div style="width:11px; height:11px; border-radius:50%; background:${skips ge 1 ? 'var(--oau-warning-border)' : 'var(--oau-card-border)'}; border:1px solid ${skips ge 1 ? 'var(--warning-color)' : 'var(--oau-card-border)'};"></div>
                <div style="width:11px; height:11px; border-radius:50%; background:${skips ge 2 ? 'var(--oau-warning-border)' : 'var(--oau-card-border)'}; border:1px solid ${skips ge 2 ? 'var(--warning-color)' : 'var(--oau-card-border)'};"></div>
                <div style="width:11px; height:11px; border-radius:50%; background:var(--oau-card-border); border:1px solid var(--oau-card-border);"></div>
                <span style="font-size:0.78em; color:var(--text-color-secondary); margin-left:4px;">${3 - skips} of 3 remaining</span>
              </div>

              <!-- CTAs -->
              <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
                <a href="emergencyAccess"
                   style="display:inline-flex; align-items:center; gap:8px; padding:9px 20px; border:none; border-radius:6px; background:var(--blue); color:#fff; font-size:0.88em; font-weight:600; text-decoration:none; cursor:pointer;">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M12 3a4 4 0 0 1 4 4v4H8V7a4 4 0 0 1 4-4z"/></svg>
                  Enroll Now
                </a>
                <j:choose>
                  <j:when test="${skips eq 2}">
                    <button type="button" class="js-oau-skip-reminder"
                            style="padding:9px 20px; border:1px solid var(--oau-warning-border); border-radius:6px; background:#fff; color:var(--oau-warning-fg); font-size:0.88em; font-weight:600; cursor:pointer;">
                      Last reminder — Dismiss
                    </button>
                  </j:when>
                  <j:otherwise>
                    <button type="button" class="js-oau-skip-reminder"
                            style="padding:9px 20px; border:1px solid var(--oau-card-border); border-radius:6px; background:#fff; color:var(--text-color-secondary); font-size:0.88em; cursor:pointer;">
                      Remind me later (${afterThis} more after this)
                    </button>
                  </j:otherwise>
                </j:choose>
              </div>

              <!-- Footer hint -->
              <p style="text-align:center; margin:22px 0 0; font-size:0.78em; color:var(--text-color-secondary);">
                This reminder appears once per login session.
                After all reminders are used, enrollment will be required before accessing Jenkins.
              </p>

            </div><!-- /jenkins-card -->
            </div><!-- /max-width -->
            </div><!-- /flex center -->

          </j:otherwise>
        </j:choose>

    </l:main-panel>
  </l:layout>

</j:jelly>
