<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">

  <l:layout title="OmniAuth — Overview" norefresh="true">
    <l:side-panel>
      <st:include page="sidepanel.jelly"/>
    </l:side-panel>
    <l:main-panel>
      <st:adjunct includes="io.jenkins.plugins.omniauth.OmniAuthManagementLink.indexAssets"/>

      <j:set var="cfg"        value="${it.omniAuthGlobalConfig}"/>
      <j:set var="nlog"       value="${it.notificationLog}"/>
      <j:set var="bgActive"   value="${it.breakGlassActive}"/>
      <j:set var="failed24h"  value="${it.failedLoginsLast24h}"/>
      <j:set var="bfEntries"  value="${it.bruteForceEntries}"/>
      <j:set var="total"      value="${it.totalUserCount}"/>
      <j:set var="active"     value="${it.activeUserCount}"/>
      <j:set var="staleCount" value="${it.staleUserCount}"/>
      <j:set var="ssoCount"   value="${it.entraUserCount}"/>
      <j:set var="nativeCount" value="${it.legacyUserCount}"/>
      <j:set var="smtpEntry"  value="${nlog.lastSmtpEntry()}"/>
      <j:set var="slackEntry" value="${nlog.lastSlackEntry()}"/>
      <j:set var="teamsEntry" value="${nlog.lastTeamsEntry()}"/>

      <!-- ── App Bar ───────────────────────────────────────────────────────── -->
      <div class="jenkins-app-bar">
        <div class="jenkins-app-bar__content">
          <h1 class="jenkins-app-bar__heading">Overview</h1>
        </div>
        <div class="jenkins-app-bar__controls" style="display:inline-flex;align-items:center;gap:12px;">
          <span class="oau-live-status" id="oauLiveStatus">
            <span class="oau-live-dot" id="oauLiveDot"></span>
            <span id="oauLiveText">Live</span>
          </span>
          <button type="button" class="jenkins-button" id="oauLiveToggle" onclick="oauToggleLive()"
                  title="Pause or resume live updates"
                  style="display:inline-flex;align-items:center;gap:6px;">
            <svg id="oauLiveIcon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/>
            </svg>
            <span id="oauLiveBtnText">Pause</span>
          </button>
        </div>
      </div>

      <div style="padding:0 24px 24px;">

        <!-- ── Status Banner ────────────────────────────────────────────────── -->
        <j:choose>
          <j:when test="${bgActive}">
            <div class="oau-status-banner oau-status-banner--critical">
              <div class="oau-status-banner__icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <line x1="12" y1="8" x2="12" y2="12"/><circle cx="12" cy="16" r="1" fill="currentColor"/>
                </svg>
              </div>
              <div class="oau-status-banner__body">
                <strong>Emergency Override Active</strong>
                <span class="oau-status-banner__sep">—</span>
                Activated by <strong>${it.breakGlassActivatedBy}</strong>.
                Direct access to the authorization matrix is enabled.
              </div>
              <a href="breakGlass" class="oau-status-banner__action">Manage Override →</a>
            </div>
          </j:when>
          <j:when test="${failed24h gt 0 or !bfEntries.isEmpty()}">
            <div id="oau-warning-banner" class="oau-status-banner oau-status-banner--warning">
              <div class="oau-status-banner__icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                  <line x1="12" y1="9" x2="12" y2="13"/><circle cx="12" cy="17" r="1" fill="currentColor"/>
                </svg>
              </div>
              <div class="oau-status-banner__body">
                <strong>Attention Required</strong>
                <span class="oau-status-banner__sep">—</span>
                <j:if test="${failed24h gt 0}"><strong>${failed24h}</strong> failed login<j:if test="${failed24h != 1}">s</j:if> in the last 24 hours.</j:if>
                <j:if test="${!bfEntries.isEmpty()}"><span style="margin-left:3px"><strong>${bfEntries.size()}</strong> brute force alert<j:if test="${bfEntries.size() != 1}">s</j:if> active.</span></j:if>
              </div>
              <a href="security" class="oau-status-banner__action">View Security →</a>
              <button class="oau-status-banner__close" onclick="oauDismissWarning()" title="Dismiss">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
              </button>
            </div>
          </j:when>
          <j:otherwise>
            <div class="oau-status-banner oau-status-banner--healthy">
              <div class="oau-status-banner__icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <polyline points="9 12 11 14 15 10"/>
                </svg>
              </div>
              <div class="oau-status-banner__body">
                <strong>All Systems Operational</strong>
                <span class="oau-status-banner__sep">—</span>
                No active security alerts. Authorization framework is functioning normally.
              </div>
            </div>
          </j:otherwise>
        </j:choose>

        <!-- ── Weekly Info Banners ───────────────────────────────────────── -->
        <j:if test="${!cfg.notificationsEnabled}">
          <div id="oau_notif_dismiss_banner" class="oau-status-banner oau-status-banner--info">
            <div class="oau-status-banner__icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                <line x1="1" y1="1" x2="23" y2="23"/>
              </svg>
            </div>
            <div class="oau-status-banner__body">
              <strong>Notifications disabled</strong>
              <span class="oau-status-banner__sep">—</span>
              Security alerts cannot be delivered. Enable at least one channel to stay informed.
            </div>
            <a href="notifications" class="oau-status-banner__action">Configure →</a>
            <button class="oau-status-banner__close" onclick="oauDismissWeekly('oau_notif_dismiss')" title="Dismiss for 1 week">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
          </div>
        </j:if>
        <j:if test="${!cfg.cleanupEnabled}">
          <div id="oau_cleanup_dismiss_banner" class="oau-status-banner oau-status-banner--info">
            <div class="oau-status-banner__icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/>
                <path d="M10 11v6"/><path d="M14 11v6"/>
                <path d="M9 6V4h6v2"/>
              </svg>
            </div>
            <div class="oau-status-banner__body">
              <strong>Auto cleanup disabled</strong>
              <span class="oau-status-banner__sep">—</span>
              Stale and inactive accounts accumulate over time. Enable cleanup to maintain a clean directory.
            </div>
            <a href="settings" class="oau-status-banner__action">Enable →</a>
            <button class="oau-status-banner__close" onclick="oauDismissWeekly('oau_cleanup_dismiss')" title="Dismiss for 1 week">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
          </div>
        </j:if>

        <j:set var="pendingReview" value="${it.pendingReviewCount}"/>
        <j:if test="${pendingReview gt 0}">
          <div id="oau_review_dismiss_banner" class="oau-status-banner oau-status-banner--info">
            <div class="oau-status-banner__icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
              </svg>
            </div>
            <div class="oau-status-banner__body">
              <strong>${pendingReview} access assignment<j:if test="${pendingReview != 1}">s</j:if> pending review</strong>
              <span class="oau-status-banner__sep">—</span>
              Open Access Review to keep or revoke stale grants.
            </div>
            <a href="accessReview" class="oau-status-banner__action">Review now →</a>
            <button class="oau-status-banner__close" onclick="oauDismissWeekly('oau_review_dismiss')" title="Dismiss for 1 week">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
          </div>
        </j:if>

        <!-- ── KPI Cards ──────────────────────────────────────────────────── -->
        <div class="oau-kpi-row">

          <a href="userStatus" class="oau-kpi-card">
            <div class="oau-kpi-card__icon" style="background:color-mix(in srgb, #0078d4 15%, transparent);">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                   stroke="#0078d4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            </div>
            <div class="oau-kpi-card__value" data-kpi="total" style="color:#0078d4;">${total}</div>
            <div class="oau-kpi-card__label">Total Users</div>
          </a>

          <a href="userStatus" class="oau-kpi-card">
            <div class="oau-kpi-card__icon" style="background:color-mix(in srgb, var(--success-color) 15%, transparent);">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                   stroke="var(--success-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
              </svg>
            </div>
            <div class="oau-kpi-card__value" data-kpi="active" style="color:var(--success-color);">${active}</div>
            <div class="oau-kpi-card__label">Active <span class="oau-kpi-card__sublabel">(${cfg.activeThresholdDays}d)</span></div>
          </a>

          <a href="staleUsers" class="oau-kpi-card">
            <div class="oau-kpi-card__icon" style="background:${staleCount gt 0 ? 'color-mix(in srgb, var(--error-color) 15%, transparent)' : 'var(--oau-neutral-bg)'};">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                   stroke="${staleCount gt 0 ? 'var(--error-color)' : 'var(--text-color-secondary)'}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <div class="oau-kpi-card__value" style="color:${staleCount gt 0 ? 'var(--error-color)' : 'var(--text-color-secondary)'};" data-kpi="stale">${staleCount}</div>
            <div class="oau-kpi-card__label">Stale <span class="oau-kpi-card__sublabel">(${cfg.staleThresholdDays}d)</span></div>
          </a>

          <a href="protectedUsers" class="oau-kpi-card">
            <div class="oau-kpi-card__icon" style="background:color-mix(in srgb, #7c3aed 15%, transparent);">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                   stroke="#7c3aed" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </div>
            <div class="oau-kpi-card__value" data-kpi="protected" style="color:#7c3aed;">${it.protectedUserCount}</div>
            <div class="oau-kpi-card__label">Protected</div>
          </a>

          <a href="userStatus" class="oau-kpi-card">
            <div class="oau-kpi-card__icon" style="background:color-mix(in srgb, #1d4ed8 15%, transparent);">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                   stroke="#1d4ed8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                <line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
              </svg>
            </div>
            <div class="oau-kpi-card__value" data-kpi="sso" style="color:#1d4ed8;">${ssoCount}</div>
            <div class="oau-kpi-card__label">SSO Users</div>
          </a>

          <a href="userStatus" class="oau-kpi-card">
            <div class="oau-kpi-card__icon" style="background:var(--oau-neutral-bg);">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                   stroke="var(--text-color-secondary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
              </svg>
            </div>
            <div class="oau-kpi-card__value" data-kpi="native" style="color:var(--text-color-secondary);">${nativeCount}</div>
            <div class="oau-kpi-card__label">Native Users</div>
          </a>

          <a href="sessions" class="oau-kpi-card">
            <div class="oau-kpi-card__icon" style="background:color-mix(in srgb, #be185d 15%, transparent);">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                   stroke="#be185d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
            </div>
            <div class="oau-kpi-card__value" data-kpi="sessions" style="color:#be185d;">${it.activeSessionCount}</div>
            <div class="oau-kpi-card__label">Live Sessions</div>
          </a>

          <a href="security" class="oau-kpi-card">
            <div class="oau-kpi-card__icon" style="background:${failed24h gt 0 ? 'color-mix(in srgb, var(--error-color) 15%, transparent)' : 'var(--oau-neutral-bg)'};">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                   stroke="${failed24h gt 0 ? 'var(--error-color)' : 'var(--text-color-secondary)'}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <circle cx="12" cy="16" r="1" fill="currentColor"/>
              </svg>
            </div>
            <div class="oau-kpi-card__value" style="color:${failed24h gt 0 ? 'var(--error-color)' : 'var(--text-color-secondary)'};" data-kpi="failed24h">${failed24h}</div>
            <div class="oau-kpi-card__label">Failed Logins <span class="oau-kpi-card__sublabel">(24h)</span></div>
          </a>

          <j:set var="pendingJit" value="${it.pendingJitCount}"/>
          <a href="jitRequests" class="oau-kpi-card">
            <div class="oau-kpi-card__icon" style="background:${pendingJit gt 0 ? 'var(--oau-warning-bg)' : 'var(--oau-neutral-bg)'};">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                   stroke="${pendingJit gt 0 ? 'var(--warning-color)' : 'var(--text-color-secondary)'}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
              </svg>
            </div>
            <div class="oau-kpi-card__value" style="color:${pendingJit gt 0 ? 'var(--warning-color)' : 'var(--text-color-secondary)'};" data-kpi="pendingJit">${pendingJit}</div>
            <div class="oau-kpi-card__label">Pending JIT</div>
          </a>

        </div>

        <!-- ── Login Activity chart (14-day, SVG/CSS, no deps) ──────────────── -->
        <j:set var="act" value="${it.loginActivity}"/>
        <div class="jenkins-card oau-widget oau-chart-card" style="margin-bottom:16px;">
          <div class="oau-widget__header">
            <div class="oau-widget__title">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>
              </svg>
              Login Activity
              <span style="font-weight:400;color:var(--text-color-secondary);font-size:0.85em;margin-left:4px;">· last 14 days</span>
            </div>
            <div class="oau-chart-legend">
              <span><span class="oau-dot" style="background:#1d4ed8;"></span> SSO</span>
              <span><span class="oau-dot" style="background:var(--success-color);"></span> Native</span>
              <span><span class="oau-dot" style="background:var(--error-color);"></span> Failed</span>
            </div>
          </div>
          <div class="oau-chart-plot">
            <j:forEach var="d" items="${act.days}" varStatus="st">
              <!-- Click a day to open the Audit Log filtered to that date. -->
              <a class="oau-chart-col" href="auditLog?from=${d.label}&amp;to=${d.label}"
                 title="${d.label} — ${d.ssoSuccess} SSO, ${d.nativeSuccess} native, ${d.failure} failed">
                <div class="oau-chart-bars">
                  <!-- Success bar: native (green) base, SSO (blue) stacked on top -->
                  <div class="oau-chart-stack">
                    <div class="oau-chart-seg oau-chart-seg--sso"
                         style="--h:${act.max gt 0 ? (d.ssoSuccess * 100 / act.max) : 0}%; animation-delay:${st.index * 35}ms;"></div>
                    <div class="oau-chart-seg oau-chart-seg--native"
                         style="--h:${act.max gt 0 ? (d.nativeSuccess * 100 / act.max) : 0}%; animation-delay:${st.index * 35}ms;"></div>
                  </div>
                  <div class="oau-chart-bar oau-chart-bar--fail"
                       style="--h:${act.max gt 0 ? (d.failure * 100 / act.max) : 0}%; animation-delay:${st.index * 35 + 15}ms;"></div>
                </div>
              </a>
            </j:forEach>
          </div>
          <div class="oau-chart-xaxis">
            <span>${act.days.get(0).label}</span>
            <span style="font-weight:600;color:var(--text-color);">Today</span>
          </div>
        </div>

        <!-- ── Row 2: Needs Attention + Expiring Access + User Composition + Notifications ── -->
        <div class="oau-grid-row" style="margin-bottom:16px;">

          <!-- Needs Attention -->
          <j:set var="pendingDel"       value="${it.pendingDeletionCount}"/>
          <j:set var="unenrolledAdmin"  value="${it.unenrolledAdminCount}"/>
          <j:set var="sosUnprotected"   value="${it.sosUnprotectedAdminCount}"/>
          <j:set var="expiringGrants"   value="${it.getExpiringGrants(7)}"/>
          <j:set var="orphanedAccounts" value="${it.orphanedGroupAccountCount}"/>
          <j:set var="failingChannels"  value="${it.failingNotificationChannels}"/>
          <j:set var="noProtected"      value="${it.protectedUserCount eq 0 and cfg.cleanupEnabled}"/>
          <!-- Cleanup active = stale/pending are informational only, not action items -->
          <j:set var="cleanupActive"    value="${cfg.cleanupEnabled and !cfg.cleanupDryRun}"/>
          <!-- Action count: stale/pending only count when cleanup is NOT active -->
          <j:set var="attentionCount"   value="${(!cleanupActive and staleCount gt 0 ? 1 : 0) + (!cleanupActive and pendingDel gt 0 ? 1 : 0) + (unenrolledAdmin gt 0 ? 1 : 0) + (sosUnprotected gt 0 ? 1 : 0) + (expiringGrants.size() gt 0 ? 1 : 0) + (orphanedAccounts gt 0 ? 1 : 0) + (failingChannels.size() gt 0 ? 1 : 0) + (noProtected ? 1 : 0)}"/>

          <div class="jenkins-card oau-widget" style="flex:1.4; min-width:240px;">
            <div class="oau-widget__header">
              <div class="oau-widget__title">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                  <line x1="12" y1="9" x2="12" y2="13"/><circle cx="12" cy="17" r="1" fill="currentColor"/>
                </svg>
                Needs Attention
              </div>
              <j:choose>
                <j:when test="${attentionCount gt 0}">
                  <span class="oau-pill oau-pill--red">${attentionCount} item<j:if test="${attentionCount != 1}">s</j:if></span>
                </j:when>
                <j:otherwise>
                  <span class="oau-pill oau-pill--green">All clear</span>
                </j:otherwise>
              </j:choose>
            </div>
            <div style="padding:8px 16px 12px; display:flex; flex-direction:column; gap:2px;">

              <j:choose>
                <j:when test="${attentionCount eq 0}">
                  <div style="text-align:center;padding:20px 0;color:var(--text-color-secondary,var(--text-color-secondary));font-size:0.85em;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none"
                         stroke="var(--success-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:block;margin:0 auto 8px;">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                      <polyline points="9 12 11 14 15 10"/>
                    </svg>
                    No action required
                  </div>
                </j:when>
                <j:otherwise>

                  <!-- Stale users: action if no cleanup, informational if cleanup active -->
                  <j:if test="${staleCount gt 0}">
                    <a href="staleUsers" class="oau-attention-row ${cleanupActive ? 'oau-attention-row--info' : 'oau-attention-row--warn'}">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                      </svg>
                      <span class="oau-attention-row__text">
                        <strong>${staleCount}</strong> stale user<j:if test="${staleCount != 1}">s</j:if>
                        <j:choose>
                          <j:when test="${cleanupActive}"> — will be auto-removed</j:when>
                          <j:otherwise> — review or remove</j:otherwise>
                        </j:choose>
                      </span>
                      <span class="oau-attention-row__arrow">→</span>
                    </a>
                  </j:if>

                  <!-- Pending deletion: action if no cleanup, informational if cleanup active -->
                  <j:if test="${pendingDel gt 0}">
                    <a href="userStatus" class="oau-attention-row ${cleanupActive ? 'oau-attention-row--info' : 'oau-attention-row--danger'}">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/>
                        <path d="M10 11v6"/><path d="M14 11v6"/>
                      </svg>
                      <span class="oau-attention-row__text">
                        <strong>${pendingDel}</strong> user<j:if test="${pendingDel != 1}">s</j:if> pending deletion
                        <j:if test="${cleanupActive}"> — queued for next run</j:if>
                      </span>
                      <span class="oau-attention-row__arrow">→</span>
                    </a>
                  </j:if>

                  <!-- Notification channel failing -->
                  <j:if test="${failingChannels.size() gt 0}">
                    <a href="notifications" class="oau-attention-row oau-attention-row--danger">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                        <line x1="2" y1="2" x2="22" y2="22"/>
                      </svg>
                      <span class="oau-attention-row__text"><strong>${failingChannels}</strong> notification<j:if test="${failingChannels.size() != 1}">s</j:if> failing — security alerts not delivered</span>
                      <span class="oau-attention-row__arrow">→</span>
                    </a>
                  </j:if>

                  <!-- No protected users with cleanup active -->
                  <j:if test="${noProtected}">
                    <a href="protectedUsers" class="oau-attention-row oau-attention-row--warn">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        <line x1="12" y1="8" x2="12" y2="12"/><circle cx="12" cy="16" r="1" fill="currentColor"/>
                      </svg>
                      <span class="oau-attention-row__text">No protected users — admin accounts at risk of auto-cleanup</span>
                      <span class="oau-attention-row__arrow">→</span>
                    </a>
                  </j:if>

                  <!-- Orphaned group accounts -->
                  <j:if test="${orphanedAccounts gt 0}">
                    <a href="userStatus" class="oau-attention-row oau-attention-row--warn">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <line x1="23" y1="11" x2="17" y2="11"/>
                      </svg>
                      <span class="oau-attention-row__text"><strong>${orphanedAccounts}</strong> orphaned group account<j:if test="${orphanedAccounts != 1}">s</j:if> — group removed from Access Management</span>
                      <span class="oau-attention-row__arrow">→</span>
                    </a>
                  </j:if>

                  <j:if test="${unenrolledAdmin gt 0}">
                    <a href="emergencyAccess" class="oau-attention-row oau-attention-row--warn">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="5" y="11" width="14" height="10" rx="2"/>
                        <path d="M12 3a4 4 0 0 1 4 4v4H8V7a4 4 0 0 1 4-4z"/>
                      </svg>
                      <span class="oau-attention-row__text"><strong>${unenrolledAdmin}</strong> admin<j:if test="${unenrolledAdmin != 1}">s</j:if> without Break Glass TOTP</span>
                      <span class="oau-attention-row__arrow">→</span>
                    </a>
                  </j:if>

                  <j:if test="${sosUnprotected gt 0}">
                    <a href="emergencyAccess" class="oau-attention-row oau-attention-row--warn">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"/><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"/>
                      </svg>
                      <span class="oau-attention-row__text"><strong>${sosUnprotected}</strong> admin<j:if test="${sosUnprotected != 1}">s</j:if> without usable SOS recovery codes</span>
                      <span class="oau-attention-row__arrow">→</span>
                    </a>
                  </j:if>

                  <j:if test="${expiringGrants.size() gt 0}">
                    <a href="accessReview" class="oau-attention-row oau-attention-row--info">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                      </svg>
                      <span class="oau-attention-row__text"><strong>${expiringGrants.size()}</strong> access grant<j:if test="${expiringGrants.size() != 1}">s</j:if> expiring within 7 days</span>
                      <span class="oau-attention-row__arrow">→</span>
                    </a>
                  </j:if>

                </j:otherwise>
              </j:choose>

            </div>
          </div>

          <!-- Expiring Access -->
          <div class="jenkins-card oau-widget" style="flex:1.6; min-width:240px;">
            <div class="oau-widget__header">
              <div class="oau-widget__title">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                </svg>
                Expiring Access — Next 14 Days
              </div>
              <a href="accessManagement" class="oau-widget__link">Manage →</a>
            </div>
            <j:set var="expiring14" value="${it.getExpiringGrants(14)}"/>
            <j:choose>
              <j:when test="${expiring14.isEmpty()}">
                <div style="text-align:center;padding:28px 0;color:var(--text-color-secondary,var(--text-color-secondary));font-size:0.85em;">
                  No grants expiring in the next 14 days.
                </div>
              </j:when>
              <j:otherwise>
                <table style="width:100%;border-collapse:collapse;font-size:0.82em;">
                  <thead>
                    <tr style="border-bottom:1px solid var(--panel-border-color,var(--oau-card-border));">
                      <th style="padding:7px 16px;text-align:left;font-weight:600;color:var(--text-color-secondary,var(--text-color-secondary));font-size:0.88em;">User</th>
                      <th style="padding:7px 8px;text-align:left;font-weight:600;color:var(--text-color-secondary,var(--text-color-secondary));font-size:0.88em;">Role</th>
                      <th style="padding:7px 16px;text-align:right;font-weight:600;color:var(--text-color-secondary,var(--text-color-secondary));font-size:0.88em;">Expires</th>
                    </tr>
                  </thead>
                  <tbody>
                    <j:forEach var="g" items="${expiring14}" begin="0" end="5">
                      <tr style="border-bottom:1px solid var(--panel-border-color,var(--oau-card-border));">
                        <td style="padding:8px 16px;font-weight:600;">${g.userId}</td>
                        <td style="padding:8px 8px;color:var(--text-color-secondary,var(--text-color-secondary));">${g.roleId}</td>
                        <td style="padding:8px 16px;text-align:right;">
                          <j:choose>
                            <j:when test="${g.daysLeft eq 0}"><span style="color:var(--error-color);font-weight:700;">Today</span></j:when>
                            <j:when test="${g.daysLeft eq 1}"><span style="color:var(--error-color);font-weight:600;">Tomorrow</span></j:when>
                            <j:when test="${g.daysLeft le 3}"><span style="color:var(--warning-color);font-weight:600;">${g.daysLeft}d</span></j:when>
                            <j:otherwise><span style="color:var(--text-color-secondary,var(--text-color-secondary));">${g.daysLeft}d</span></j:otherwise>
                          </j:choose>
                        </td>
                      </tr>
                    </j:forEach>
                  </tbody>
                </table>
                <j:if test="${expiring14.size() gt 6}">
                  <div style="padding:6px 16px;font-size:0.78em;color:var(--text-color-secondary,var(--text-color-secondary));">+${expiring14.size() - 6} more</div>
                </j:if>
              </j:otherwise>
            </j:choose>
          </div>

          <!-- Right column: User Composition + Notifications stacked -->
          <div style="flex:1; min-width:220px; display:flex; flex-direction:column; gap:16px;">

            <!-- User Composition -->
            <div class="jenkins-card oau-widget">
              <div class="oau-widget__header">
                <div class="oau-widget__title">
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                       stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                  </svg>
                  User Composition
                </div>
              </div>
              <div style="padding:0 16px 16px; display:flex; flex-direction:column; gap:12px;">

                <!-- SSO vs Native — SVG donut (circumference 2πr with r=40 ≈ 251) -->
                <div style="display:flex; align-items:center; gap:16px;">
                  <svg width="104" height="104" viewBox="0 0 120 120" style="flex-shrink:0;">
                    <circle cx="60" cy="60" r="40" fill="none" stroke="var(--oau-neutral-bg)" stroke-width="14"/>
                    <circle class="oau-donut-arc" cx="60" cy="60" r="40" fill="none" stroke="#1d4ed8" stroke-width="14"
                            stroke-linecap="round" transform="rotate(-90 60 60)"
                            stroke-dasharray="${total gt 0 ? (ssoCount * 251 / total) : 0} 251"/>
                    <text x="60" y="57" text-anchor="middle" font-size="22" font-weight="800" fill="var(--text-color)">${total}</text>
                    <text x="60" y="73" text-anchor="middle" font-size="9" letter-spacing="0.5" fill="var(--text-color-secondary)">USERS</text>
                  </svg>
                  <div style="display:flex; flex-direction:column; gap:8px; font-size:0.82em;">
                    <div style="display:flex; align-items:center; gap:7px;">
                      <span class="oau-dot" style="background:#1d4ed8;"></span>
                      <span style="color:var(--text-color-secondary);">SSO</span>
                      <strong style="margin-left:auto;">${ssoCount}</strong>
                    </div>
                    <div style="display:flex; align-items:center; gap:7px;">
                      <span class="oau-dot" style="background:var(--text-color-secondary);"></span>
                      <span style="color:var(--text-color-secondary);">Native</span>
                      <strong style="margin-left:auto;">${nativeCount}</strong>
                    </div>
                    <div style="font-size:0.85em; color:var(--text-color-secondary); margin-top:2px;">
                      ${total gt 0 ? (ssoCount * 100 / total) : 0}% single sign-on
                    </div>
                  </div>
                </div>

                <div>
                  <div style="display:flex;justify-content:space-between;font-size:0.8em;margin-bottom:5px;">
                    <span style="color:var(--text-color-secondary,var(--text-color-secondary));">Active vs Stale</span>
                    <span style="font-weight:600;">${active} / ${staleCount}</span>
                  </div>
                  <div class="oau-progress-track">
                    <div class="oau-progress-fill" style="width:${total gt 0 ? (active * 100 / total) : 0}%; background:var(--success-color);"></div>
                  </div>
                  <div style="display:flex;gap:12px;margin-top:5px;font-size:0.75em;color:var(--text-color-secondary,var(--text-color-secondary));">
                    <span><span class="oau-dot" style="background:var(--success-color);"></span> Active</span>
                    <span><span class="oau-dot" style="background:var(--error-color);"></span> Stale</span>
                  </div>
                </div>

              </div>
            </div>

            <!-- Notification Health -->
            <div class="jenkins-card oau-widget">
              <div class="oau-widget__header">
                <div class="oau-widget__title">
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                       stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                  </svg>
                  Notifications
                </div>
                <a href="notifications" class="oau-widget__link">Configure →</a>
              </div>
              <div style="padding:0 16px 12px;">

                <div class="oau-notif-row">
                  <div style="display:flex;align-items:center;gap:8px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none"
                         stroke="var(--text-color-secondary,var(--text-color-secondary))" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                      <polyline points="22,6 12,13 2,6"/>
                    </svg>
                    <span style="font-size:0.85em;">Email</span>
                  </div>
                  <j:choose>
                    <j:when test="${!cfg.smtpEnabled}"><span class="oau-notif-badge oau-notif-badge--off">Disabled</span></j:when>
                    <j:when test="${smtpEntry == null}"><span class="oau-notif-badge oau-notif-badge--idle">No sends yet</span></j:when>
                    <j:when test="${smtpEntry.success}"><span class="oau-notif-badge oau-notif-badge--ok">OK</span></j:when>
                    <j:otherwise><span class="oau-notif-badge oau-notif-badge--fail">Failed</span></j:otherwise>
                  </j:choose>
                </div>

                <div class="oau-notif-row">
                  <div style="display:flex;align-items:center;gap:8px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none"
                         stroke="var(--text-color-secondary,var(--text-color-secondary))" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                    </svg>
                    <span style="font-size:0.85em;">Slack</span>
                  </div>
                  <j:choose>
                    <j:when test="${!cfg.slackEnabled}"><span class="oau-notif-badge oau-notif-badge--off">Disabled</span></j:when>
                    <j:when test="${slackEntry == null}"><span class="oau-notif-badge oau-notif-badge--idle">No sends yet</span></j:when>
                    <j:when test="${slackEntry.success}"><span class="oau-notif-badge oau-notif-badge--ok">OK</span></j:when>
                    <j:otherwise><span class="oau-notif-badge oau-notif-badge--fail">Failed</span></j:otherwise>
                  </j:choose>
                </div>

                <div class="oau-notif-row" style="border-bottom:none;">
                  <div style="display:flex;align-items:center;gap:8px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none"
                         stroke="var(--text-color-secondary,var(--text-color-secondary))" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
                    </svg>
                    <span style="font-size:0.85em;">Teams</span>
                  </div>
                  <j:choose>
                    <j:when test="${!cfg.teamsEnabled}"><span class="oau-notif-badge oau-notif-badge--off">Disabled</span></j:when>
                    <j:when test="${teamsEntry == null}"><span class="oau-notif-badge oau-notif-badge--idle">No sends yet</span></j:when>
                    <j:when test="${teamsEntry.success}"><span class="oau-notif-badge oau-notif-badge--ok">OK</span></j:when>
                    <j:otherwise><span class="oau-notif-badge oau-notif-badge--fail">Failed</span></j:otherwise>
                  </j:choose>
                </div>

              </div>
            </div>

          </div>
        </div>

        <!-- ── Row 3: Audit Feed + System Config + Break Glass ───────────────── -->
        <div class="oau-grid-row">

          <!-- Recent Security Events -->
          <div class="jenkins-card oau-widget" style="flex:3; min-width:300px;">
            <div class="oau-widget__header">
              <div class="oau-widget__title">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/>
                  <line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
                  <polyline points="10 9 9 9 8 9"/>
                </svg>
                Recent Security Events
              </div>
              <a href="auditLog" class="oau-widget__link">Full audit log →</a>
            </div>
            <div style="padding:0 16px 8px;">
              <j:set var="auditEntries" value="${it.recentAuditEntries}"/>
              <j:choose>
                <j:when test="${auditEntries.isEmpty()}">
                  <div style="text-align:center;padding:28px 0;color:var(--text-color-secondary,var(--text-color-secondary));font-size:0.85em;">
                    No events recorded yet.
                  </div>
                </j:when>
                <j:otherwise>
                  <j:forEach var="entry" items="${auditEntries}">
                    <j:set var="action" value="${entry.get('action')}"/>
                    <div class="oau-audit-row">
                      <!-- Icon per event type -->
                      <j:choose>
                        <j:when test="${action eq 'login_failure' or action eq 'break_glass_failed'}">
                          <div class="oau-audit-icon" style="background:color-mix(in srgb, var(--error-color) 15%, transparent);">
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none"
                                 stroke="var(--error-color)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                              <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
                            </svg>
                          </div>
                        </j:when>
                        <j:when test="${action eq 'break_glass_activate'}">
                          <div class="oau-audit-icon" style="background:color-mix(in srgb, var(--warning-color) 15%, transparent);">
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none"
                                 stroke="var(--warning-color)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                            </svg>
                          </div>
                        </j:when>
                        <j:when test="${action eq 'revoke' or action eq 'user_deleted' or action eq 'role_deleted' or action eq 'expired' or action eq 'permission_revoked' or action eq 'session_revoked' or action eq 'provisioning_rejected' or action eq 'jit_denied' or action eq 'jit_revoked' or action eq 'audit_purged'}">
                          <div class="oau-audit-icon" style="background:color-mix(in srgb, #be185d 15%, transparent);">
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none"
                                 stroke="#be185d" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                              <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/>
                              <path d="M10 11v6"/><path d="M14 11v6"/>
                            </svg>
                          </div>
                        </j:when>
                        <j:when test="${action eq 'grant' or action eq 'user_created' or action eq 'role_created' or action eq 'break_glass_enrolled' or action eq 'permission_granted' or action eq 'jit_approved' or action eq 'review_confirmed'}">
                          <div class="oau-audit-icon" style="background:color-mix(in srgb, var(--success-color) 15%, transparent);">
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none"
                                 stroke="var(--success-color)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                              <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/>
                            </svg>
                          </div>
                        </j:when>
                        <j:otherwise>
                          <div class="oau-audit-icon" style="background:color-mix(in srgb, #0078d4 15%, transparent);">
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none"
                                 stroke="#0078d4" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                            </svg>
                          </div>
                        </j:otherwise>
                      </j:choose>

                      <!-- Description -->
                      <div class="oau-audit-body">
                        <div class="oau-audit-desc">
                          <j:choose>
                            <j:when test="${action eq 'login_success'}">Login by <strong>${entry.get('user')}</strong> via ${entry.get('authType')}</j:when>
                            <j:when test="${action eq 'login_failure'}">Failed login attempt — <strong>${entry.get('user')}</strong><j:if test="${entry.get('ip') != null and entry.get('ip') != ''}"><span style="margin-left:0.25em">from ${entry.get('ip')}</span></j:if></j:when>
                            <j:when test="${action eq 'grant'}"><strong>${entry.get('by')}</strong> granted <em>${entry.get('role')}</em> to <strong>${entry.get('user')}</strong> on ${entry.get('scope')}</j:when>
                            <j:when test="${action eq 'revoke'}"><strong>${entry.get('by')}</strong> revoked access for <strong>${entry.get('user')}</strong> on ${entry.get('scope')}</j:when>
                            <j:when test="${action eq 'edit'}"><strong>${entry.get('by')}</strong> changed <strong>${entry.get('user')}</strong>: <em>${entry.get('oldRole')}</em> → <em>${entry.get('newRole')}</em></j:when>
                            <j:when test="${action eq 'expired'}">Access expired for <strong>${entry.get('user')}</strong> on ${entry.get('scope')}</j:when>
                            <j:when test="${action eq 'user_created'}">User account created: <strong>${entry.get('user')}</strong> by ${entry.get('by')}</j:when>
                            <j:when test="${action eq 'user_deleted'}">User account deleted: <strong>${entry.get('user')}</strong> by ${entry.get('by')}</j:when>
                            <j:when test="${action eq 'break_glass_activate'}">Emergency Override activated by <strong>${entry.get('by')}</strong></j:when>
                            <j:when test="${action eq 'break_glass_deactivate'}">Emergency Override deactivated by <strong>${entry.get('by')}</strong></j:when>
                            <j:when test="${action eq 'break_glass_enrolled'}">Break Glass TOTP enrolled by <strong>${entry.get('by')}</strong></j:when>
                            <j:when test="${action eq 'break_glass_unenrolled'}">Break Glass TOTP removed by <strong>${entry.get('by')}</strong></j:when>
                            <j:when test="${action eq 'break_glass_failed'}">Emergency Override attempt failed by <strong>${entry.get('by')}</strong></j:when>
                            <j:when test="${action eq 'role_created'}">Role created: <em>${entry.get('role')}</em> by <strong>${entry.get('by')}</strong></j:when>
                            <j:when test="${action eq 'role_edited'}">Role edited: <em>${entry.get('role')}</em> by <strong>${entry.get('by')}</strong></j:when>
                            <j:when test="${action eq 'role_deleted'}">Role deleted: <em>${entry.get('role')}</em> by <strong>${entry.get('by')}</strong></j:when>
                            <j:when test="${action eq 'permission_granted'}"><strong>${entry.get('by')}</strong> granted permissions to <strong>${entry.get('user')}</strong> on ${entry.get('scope')}<j:if test="${entry.get('detail') != null and entry.get('detail') != ''}"> — ${entry.get('detail')}</j:if></j:when>
                            <j:when test="${action eq 'permission_revoked'}"><strong>${entry.get('by')}</strong> revoked permissions for <strong>${entry.get('user')}</strong> on ${entry.get('scope')}<j:if test="${entry.get('detail') != null and entry.get('detail') != ''}"> — ${entry.get('detail')}</j:if></j:when>
                            <j:when test="${action eq 'session_revoked'}"><strong>${entry.get('by')}</strong> force-revoked the session of <strong>${entry.get('user')}</strong></j:when>
                            <j:when test="${action eq 'bruteforce_cleared'}"><strong>${entry.get('by')}</strong> cleared the lockout for <strong>${entry.get('user')}</strong></j:when>
                            <j:when test="${action eq 'audit_purged'}">Audit log purged by <strong>${entry.get('by')}</strong> (${entry.get('count')} file(s))</j:when>
                            <j:when test="${action eq 'config_changed'}"><strong>${entry.get('by')}</strong> changed <em>${entry.get('area')}</em><j:if test="${entry.get('detail') != null and entry.get('detail') != ''}"> — ${entry.get('detail')}</j:if></j:when>
                            <j:when test="${action eq 'config_exported'}">Configuration exported by <strong>${entry.get('by')}</strong></j:when>
                            <j:when test="${action eq 'config_imported'}">Configuration imported by <strong>${entry.get('by')}</strong><j:if test="${entry.get('detail') != null and entry.get('detail') != ''}"> (${entry.get('detail')})</j:if></j:when>
                            <j:when test="${action eq 'config_reverted'}">Configuration reverted by <strong>${entry.get('by')}</strong><j:if test="${entry.get('detail') != null and entry.get('detail') != ''}"> — ${entry.get('detail')}</j:if></j:when>
                            <j:when test="${action eq 'user_marked_deletion'}"><strong>${entry.get('user')}</strong> marked for deletion by <strong>${entry.get('by')}</strong></j:when>
                            <j:when test="${action eq 'user_unmarked_deletion'}">Pending deletion cleared for <strong>${entry.get('user')}</strong> by <strong>${entry.get('by')}</strong></j:when>
                            <j:when test="${action eq 'password_changed'}">Password set by <strong>${entry.get('user')}</strong></j:when>
                            <j:when test="${action eq 'provisioning_requested'}">Access requested by <strong>${entry.get('user')}</strong><j:if test="${entry.get('authType') != null and entry.get('authType') != ''}"> (${entry.get('authType')})</j:if></j:when>
                            <j:when test="${action eq 'provisioning_rejected'}"><strong>${entry.get('by')}</strong> rejected the access request from <strong>${entry.get('user')}</strong></j:when>
                            <j:when test="${action eq 'activation_resent'}"><strong>${entry.get('by')}</strong> resent the activation link to <strong>${entry.get('user')}</strong></j:when>
                            <j:when test="${action eq 'jit_requested'}">JIT access requested by <strong>${entry.get('user')}</strong> on ${entry.get('scope')}</j:when>
                            <j:when test="${action eq 'jit_approved'}"><strong>${entry.get('by')}</strong> approved JIT access for <strong>${entry.get('user')}</strong> on ${entry.get('scope')}</j:when>
                            <j:when test="${action eq 'jit_denied'}"><strong>${entry.get('by')}</strong> denied JIT access for <strong>${entry.get('user')}</strong> on ${entry.get('scope')}</j:when>
                            <j:when test="${action eq 'jit_expired'}">JIT access expired for <strong>${entry.get('user')}</strong> on ${entry.get('scope')}</j:when>
                            <j:when test="${action eq 'jit_timed_out'}">JIT request timed out for <strong>${entry.get('user')}</strong> on ${entry.get('scope')}</j:when>
                            <j:when test="${action eq 'jit_revoked'}"><strong>${entry.get('by')}</strong> revoked JIT access for <strong>${entry.get('user')}</strong> on ${entry.get('scope')}</j:when>
                            <j:when test="${action eq 'jit_cancelled'}">JIT request cancelled by <strong>${entry.get('user')}</strong> on ${entry.get('scope')}</j:when>
                            <j:when test="${action eq 'review_confirmed'}"><strong>${entry.get('by')}</strong> confirmed access for <strong>${entry.get('user')}</strong> on ${entry.get('scope')}</j:when>
                            <j:otherwise>${action}</j:otherwise>
                          </j:choose>
                        </div>
                        <div class="oau-audit-ts" data-ts="${entry.get('ts')}">
                          <j:if test="${entry.get('ip') != null and entry.get('ip') != '' and action eq 'login_success'}">
                            <span style="font-size:0.75em;color:var(--text-color-secondary,var(--text-color-secondary));margin-right:6px;">${entry.get('ip')}</span>
                          </j:if>
                        </div>
                      </div>
                    </div>
                  </j:forEach>
                </j:otherwise>
              </j:choose>
            </div>
          </div>

          <!-- Right column: System Config + Break Glass -->
          <div style="flex:1.4; min-width:220px; display:flex; flex-direction:column; gap:16px;">

            <!-- System Configuration -->
            <div class="jenkins-card oau-widget">
              <div class="oau-widget__header">
                <div class="oau-widget__title">
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                       stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"/>
                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/>
                    <path d="M12 2v2m0 16v2M2 12h2m16 0h2"/>
                  </svg>
                  System Configuration
                </div>
                <a href="settings" class="oau-widget__link">Settings →</a>
              </div>
              <div style="padding:0 16px 14px; display:flex; flex-direction:column; gap:10px;">

                <div class="oau-config-row">
                  <span class="oau-config-label">Authentication</span>
                  <j:choose>
                    <j:when test="${it.ssoConfigured}"><span class="oau-pill oau-pill--blue">Native + SSO</span></j:when>
                    <j:otherwise><span class="oau-pill oau-pill--gray">Native</span></j:otherwise>
                  </j:choose>
                </div>
                <div class="oau-config-row">
                  <span class="oau-config-label">PKCE + Nonce</span>
                  <!-- Always enforced on the OAuth flow — not a toggle. -->
                  <span class="oau-pill oau-pill--blue" title="Always enforced on the SSO flow — cannot be disabled">Always on</span>
                </div>
                <div class="oau-config-row">
                  <span class="oau-config-label">Group Sync</span>
                  <!-- Group sync is a property of the Entra (SSO) config, not the global config. -->
                  <j:choose>
                    <j:when test="${!it.ssoConfigured}"><span class="oau-pill oau-pill--gray" title="No SSO provider configured">N/A</span></j:when>
                    <j:when test="${it.entraConfig.enableGroupSync}"><span class="oau-pill oau-pill--green">On</span></j:when>
                    <j:otherwise><span class="oau-pill oau-pill--gray">Off</span></j:otherwise>
                  </j:choose>
                </div>
                <div class="oau-config-row">
                  <span class="oau-config-label">Cleanup</span>
                  <j:choose>
                    <j:when test="${cfg.cleanupEnabled and cfg.cleanupDryRun}"><span class="oau-pill oau-pill--amber">Dry Run</span></j:when>
                    <j:when test="${cfg.cleanupEnabled}"><span class="oau-pill oau-pill--green">On</span></j:when>
                    <j:otherwise><span class="oau-pill oau-pill--gray">Off</span></j:otherwise>
                  </j:choose>
                </div>
                <div class="oau-config-row">
                  <span class="oau-config-label">Notifications</span>
                  <j:choose>
                    <j:when test="${cfg.notificationsEnabled}"><span class="oau-pill oau-pill--green">On</span></j:when>
                    <j:otherwise><span class="oau-pill oau-pill--gray">Off</span></j:otherwise>
                  </j:choose>
                </div>
                <div class="oau-config-row">
                  <span class="oau-config-label">Brute Force</span>
                  <span class="oau-pill oau-pill--blue">Threshold: ${cfg.bruteForceThreshold}</span>
                </div>

              </div>
            </div>

            <!-- Break Glass Widget -->
            <div class="jenkins-card oau-widget">
              <div class="oau-widget__header">
                <div class="oau-widget__title">
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                       stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  </svg>
                  Break Glass
                </div>
                <a href="breakGlass" class="oau-widget__link">Manage →</a>
              </div>
              <div style="padding:0 16px 14px;">

                <!-- Active state -->
                <j:if test="${bgActive}">
                  <div style="padding:10px 12px;background:var(--oau-warning-bg);border:1px solid var(--oau-warning-border);border-radius:8px;margin-bottom:10px;">
                    <div style="font-size:0.82em;font-weight:700;color:var(--warning-color);margin-bottom:2px;">Override ACTIVE</div>
                    <div style="font-size:0.78em;color:var(--warning-color);">By: ${it.breakGlassActivatedBy}</div>
                  </div>
                </j:if>

                <!-- Enrolled admins count -->
                <j:set var="bgEnrolled" value="${it.breakGlassEnrolledAdminCount}"/>
                <div class="oau-config-row" style="margin-bottom:8px;">
                  <span class="oau-config-label">Enrolled Admins</span>
                  <j:choose>
                    <j:when test="${bgEnrolled gt 0}">
                      <span class="oau-pill oau-pill--green">${bgEnrolled} enrolled</span>
                    </j:when>
                    <j:otherwise>
                      <span class="oau-pill oau-pill--amber">None</span>
                    </j:otherwise>
                  </j:choose>
                </div>

                <div class="oau-config-row">
                  <span class="oau-config-label">Override Status</span>
                  <j:choose>
                    <j:when test="${bgActive}">
                      <span class="oau-pill oau-pill--amber">Active</span>
                    </j:when>
                    <j:otherwise>
                      <span class="oau-pill oau-pill--gray">Inactive</span>
                    </j:otherwise>
                  </j:choose>
                </div>

              </div>
            </div>

          </div>
        </div>

      </div>

      <!-- Styles: the oau-* components live in the shared adjunct
           (io.jenkins.plugins.omniauth.oau.oau), injected via sidepanel.jelly. -->


    </l:main-panel>
  </l:layout>

</j:jelly>
