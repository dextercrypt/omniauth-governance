<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">

  <l:layout title="OmniAuth — Security" norefresh="true">
    <l:side-panel>
      <st:include page="sidepanel.jelly"/>
    </l:side-panel>
    <l:main-panel>
      <st:adjunct includes="io.jenkins.plugins.omniauth.OmniAuthManagementLink.securityAssets"/>

      <div class="jenkins-app-bar">
        <div class="jenkins-app-bar__content">
          <h1 class="jenkins-app-bar__heading">Security</h1>
        </div>
      </div>

      <div style="padding: 16px 24px;">

        <j:set var="cfg" value="${it.omniAuthGlobalConfig}"/>

        <!-- ── Brute Force State ─────────────────────────────────── -->
        <div class="jenkins-card" style="padding:16px;margin-bottom:16px;">
          <h3 style="margin:0 0 12px;">Brute Force — Active Counters</h3>
          <p style="color:var(--text-color-secondary);font-size:0.85em;margin:0 0 12px;">
            Users with consecutive failed logins. Counters reset on successful login.
            Alert fires at <strong>${cfg.bruteForceThreshold}</strong> failures.
            <j:choose>
              <j:when test="${cfg.bruteForceLockoutEnabled}">
                Lockout is <strong style="color:var(--oau-success-fg);">enforced</strong> — a reached account is locked for
                <strong>${cfg.bruteForceLockoutMinutes} min</strong> (protected users exempt).
              </j:when>
              <j:otherwise>
                Lockout enforcement is <strong style="color:var(--warning-color);">off</strong> (detection only).
              </j:otherwise>
            </j:choose>
            Configure in <a href="notifications">Notifications</a>.
          </p>

          <j:set var="bfEntries" value="${it.bruteForceEntries}"/>
          <j:choose>
            <j:when test="${bfEntries.isEmpty()}">
              <div style="color:var(--oau-success-fg);font-size:0.88em;display:flex;align-items:center;gap:6px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><path d="M20 6 9 17l-5-5"/></svg><span>No users with active failure counters.</span></div>
            </j:when>
            <j:otherwise>
              <table class="jenkins-table" style="width:100%;">
                <thead>
                  <tr>
                    <th>Username</th>
                    <th>Full Name</th>
                    <th>Failures</th>
                    <th>Status</th>
                    <th>Alerted</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <j:forEach var="bf" items="${bfEntries}">
                    <tr>
                      <td><strong>${bf.userId}</strong></td>
                      <td>${bf.fullName}</td>
                      <td style="text-align:center;">
                        <j:choose>
                          <j:when test="${bf.failureCount > 0}">
                            <strong style="color:var(--error-color);">${bf.failureCount}</strong>
                          </j:when>
                          <j:otherwise>
                            <span style="color:var(--text-color-secondary);">—</span>
                          </j:otherwise>
                        </j:choose>
                      </td>
                      <td>
                        <j:choose>
                          <j:when test="${bf.locked}">
                            <span style="background:var(--oau-danger-fg);color:#fff;padding:2px 8px;border-radius:4px;font-size:0.82em;display:inline-flex;align-items:center;gap:5px;"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>Locked · ~${bf.lockRemainingMinutes}m left</span>
                          </j:when>
                          <j:when test="${bf.failureCount >= cfg.bruteForceThreshold}">
                            <span style="background:var(--oau-danger-bg);color:var(--oau-danger-fg);padding:2px 8px;border-radius:4px;font-size:0.82em;">Threshold reached</span>
                          </j:when>
                          <j:when test="${bf.failureCount > 0}">
                            <span style="background:var(--oau-warning-bg);color:var(--oau-warning-fg);padding:2px 8px;border-radius:4px;font-size:0.82em;">Warning</span>
                          </j:when>
                          <j:otherwise>
                            <span style="background:var(--oau-danger-bg);color:var(--oau-danger-fg);padding:2px 8px;border-radius:4px;font-size:0.82em;">Previously alerted</span>
                          </j:otherwise>
                        </j:choose>
                      </td>
                      <td>
                        <j:choose>
                          <j:when test="${bf.alerted}">
                            <span style="font-size:0.82em;color:var(--text-color-secondary);">${bf.relativeAlertedAt}</span>
                          </j:when>
                          <j:otherwise>—</j:otherwise>
                        </j:choose>
                      </td>
                      <td>
                        <j:if test="${bf.alerted or bf.locked}">
                          <form method="post" action="clearBruteForce" style="display:inline;">
                            <input type="hidden" name="userId" value="${bf.userId}"/>
                            <input type="hidden" name="${app.crumbRequestField}" value="${app.crumb}"/>
                            <button type="submit" class="jenkins-button jenkins-button--small">${bf.locked ? 'Unlock' : 'Clear'}</button>
                          </form>
                        </j:if>
                      </td>
                    </tr>
                  </j:forEach>
                </tbody>
              </table>
            </j:otherwise>
          </j:choose>
        </div>

        <!-- ── Failed Logins ─────────────────────────────────────── -->
        <div class="jenkins-card" style="padding:16px;">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
            <h3 style="margin:0;">Failed Logins</h3>
            <div style="display:flex;gap:8px;">
              <a href="security?window=24"  class="jenkins-button jenkins-button--small${windowHours == '24'  ? ' jenkins-button--primary' : ''}">24h</a>
              <a href="security?window=48"  class="jenkins-button jenkins-button--small${windowHours == '48'  ? ' jenkins-button--primary' : ''}">48h</a>
              <a href="security?window=168" class="jenkins-button jenkins-button--small${windowHours == '168' ? ' jenkins-button--primary' : ''}">7d</a>
            </div>
          </div>

          <j:set var="windowHours" value="${request2.getAttribute('windowHours')}"/>
          <j:set var="failedLogins" value="${request2.getAttribute('failedLogins')}"/>

          <j:choose>
            <j:when test="${failedLogins.isEmpty()}">
              <div style="color:var(--oau-success-fg);font-size:0.88em;display:flex;align-items:center;gap:6px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><path d="M20 6 9 17l-5-5"/></svg><span>No failed logins in this window.</span></div>
            </j:when>
            <j:otherwise>
              <table class="jenkins-table sortable" style="width:100%;">
                <thead>
                  <tr>
                    <th>When</th>
                    <th>Username</th>
                    <th>IP Address</th>
                    <th>Browser</th>
                    <th>OS</th>
                    <th>Method</th>
                  </tr>
                </thead>
                <tbody>
                  <j:forEach var="f" items="${failedLogins}">
                    <tr>
                      <td>
                        <span style="display:inline-flex;align-items:center;gap:4px;">
                          <span>${f.event.relativeTimestamp}</span>
                          <span class="oau-info-wrap">
                            <span class="oau-info-btn">i</span>
                            <span class="oau-info-tip">${f.event.formattedTimestamp}</span>
                          </span>
                        </span>
                      </td>
                      <td><strong>${f.userId}</strong></td>
                      <td style="font-family:monospace;font-size:0.88em;">${f.event.ipAddress}</td>
                      <td>${f.event.browser}</td>
                      <td>${f.event.os}</td>
                      <td>
                        <j:choose>
                          <j:when test="${f.event.method != 'Native'}">
                            <span style="background:var(--oau-info-bg);color:var(--blue);padding:2px 8px;border-radius:4px;font-size:0.82em;">${f.event.method}</span>
                          </j:when>
                          <j:otherwise>
                            <span style="background:var(--oau-neutral-bg);color:var(--text-color-secondary);padding:2px 8px;border-radius:4px;font-size:0.82em;">Native</span>
                          </j:otherwise>
                        </j:choose>
                      </td>
                    </tr>
                  </j:forEach>
                </tbody>
              </table>
            </j:otherwise>
          </j:choose>
        </div>

      </div>

    </l:main-panel>
  </l:layout>

</j:jelly>
