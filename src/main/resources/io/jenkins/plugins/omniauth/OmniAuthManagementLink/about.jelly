<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">

  <l:layout title="OmniAuth — Info" norefresh="true">
    <l:side-panel>
      <st:include page="sidepanel.jelly"/>
    </l:side-panel>
    <l:main-panel>

      <div class="jenkins-app-bar">
        <div class="jenkins-app-bar__content">
          <h1 class="jenkins-app-bar__heading">Info</h1>
        </div>
      </div>

      <div style="padding: 16px 24px; max-width: 860px;">

        <!-- ================================================================
             MICROSOFT ENTRA CONFIGURATION (read-only)
             ================================================================ -->
        <j:set var="entra" value="${it.entraConfig}"/>
        <div class="jenkins-card" style="padding: 0; margin-bottom: 20px; overflow: hidden;">
          <div style="padding: 14px 20px; border-bottom: 1px solid var(--oau-card-border); display: flex; align-items: center; justify-content: space-between;">
            <div style="display: flex; align-items: center; gap: 10px;">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--blue,var(--blue));flex-shrink:0;">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              <h3 style="margin: 0; font-size: 0.95em; font-weight: 600;">Microsoft Entra (Azure AD) Configuration</h3>
            </div>
            <a href="${rootURL}/manage/configureSecurity/" style="font-size: 0.8em; color: var(--blue,var(--blue)); text-decoration: none;">
              Edit in Configure Global Security &#8599;
            </a>
          </div>
          <div style="padding: 16px 20px;">
            <j:choose>
              <j:when test="${entra == null}">
                <div class="jenkins-alert jenkins-alert-warning" style="margin: 0;">
                  Security realm is not set to OmniAuth. Entra configuration is unavailable.
                </div>
              </j:when>
              <j:otherwise>
                <table style="width: 100%; border-collapse: collapse; font-size: 0.88em;">
                  <tr>
                    <td style="color: var(--text-color-secondary); padding: 8px 0; width: 140px; vertical-align: top; border-bottom: 1px solid var(--oau-card-border);">Tenant ID</td>
                    <td style="font-family: monospace; padding: 8px 0; word-break: break-all; border-bottom: 1px solid var(--oau-card-border);">${entra.tenantId}</td>
                  </tr>
                  <tr>
                    <td style="color: var(--text-color-secondary); padding: 8px 0; vertical-align: top; border-bottom: 1px solid var(--oau-card-border);">Client ID</td>
                    <td style="font-family: monospace; padding: 8px 0; word-break: break-all; border-bottom: 1px solid var(--oau-card-border);">${entra.clientId}</td>
                  </tr>
                  <tr>
                    <td style="color: var(--text-color-secondary); padding: 8px 0; vertical-align: top; border-bottom: 1px solid var(--oau-card-border);">Client Secret</td>
                    <td style="padding: 8px 0; border-bottom: 1px solid var(--oau-card-border);">
                      <span style="background: var(--panel-header-bg,var(--oau-neutral-bg)); color: var(--text-color-secondary); font-family: monospace; padding: 2px 8px; border-radius: 4px; font-size: 0.9em; letter-spacing: 2px;">••••••••</span>
                      <span style="font-size: 0.8em; color: var(--text-color-secondary); margin-left: 8px;">(stored encrypted)</span>
                    </td>
                  </tr>
                  <tr>
                    <td style="color: var(--text-color-secondary); padding: 8px 0; vertical-align: top; border-bottom: 1px solid var(--oau-card-border);">Redirect URI</td>
                    <td style="font-family: monospace; padding: 8px 0; word-break: break-all; border-bottom: 1px solid var(--oau-card-border);">${it.entraRedirectUri}</td>
                  </tr>
                  <tr>
                    <td style="color: var(--text-color-secondary); padding: 8px 0; vertical-align: top; border-bottom: 1px solid var(--oau-card-border);">Group Sync</td>
                    <td style="padding: 8px 0; border-bottom: 1px solid var(--oau-card-border);">
                      <j:choose>
                        <j:when test="${entra.enableGroupSync}">
                          <span style="background: var(--oau-success-bg); color: var(--oau-success-fg); padding: 2px 8px; border-radius: 4px; font-size: 0.82em;">Enabled</span>
                        </j:when>
                        <j:otherwise>
                          <span style="background: var(--oau-neutral-bg); color: var(--text-color-secondary); padding: 2px 8px; border-radius: 4px; font-size: 0.82em;">Disabled</span>
                        </j:otherwise>
                      </j:choose>
                    </td>
                  </tr>
                  <tr>
                    <td style="color: var(--text-color-secondary); padding: 8px 0; vertical-align: top;">Scopes</td>
                    <td style="font-family: monospace; padding: 8px 0; font-size: 0.85em; color: var(--text-color-secondary);">${entra.scope}</td>
                  </tr>
                </table>
                <div style="margin-top: 14px; padding: 10px 14px; background: var(--oau-info-bg); border-radius: 6px; font-size: 0.82em; color: var(--blue);">
                  <strong>Azure AD App Registration:</strong> register
                  <code style="background: rgba(0,120,212,0.1); padding: 1px 5px; border-radius: 3px;">${it.entraRedirectUri}</code>
                  as an allowed Redirect URI.
                </div>
              </j:otherwise>
            </j:choose>
          </div>
        </div>

        <!-- ================================================================
             PLUGIN INFO
             ================================================================ -->
        <div class="jenkins-card" style="padding: 0; overflow: hidden;">
          <div style="padding: 14px 20px; border-bottom: 1px solid var(--oau-card-border); display: flex; align-items: center; gap: 10px;">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="10 10 44 46" width="20" height="21" shape-rendering="geometricPrecision" style="flex-shrink:0;">
              <style>
                .oa-s-sec { stroke: var(--text-color-secondary); }
                .oa-s-pri { stroke: var(--text-color); }
                .oa-f-sec { fill: var(--text-color-secondary); }
                .oa-f-pri { fill: var(--text-color); }
              </style>
              <path class="oa-s-sec" d="M16 51 L16 32 A16 16 0 0 1 32 16" fill="none" stroke-width="8.5" stroke-linecap="butt"/>
              <path class="oa-s-pri" d="M32 16 A16 16 0 0 1 48 32 L48 51" fill="none" stroke-width="8.5" stroke-linecap="butt"/>
              <circle class="oa-f-sec" cx="16" cy="51" r="3.2"/>
              <circle class="oa-f-pri" cx="48" cy="51" r="3.2"/>
              <circle class="oa-f-pri" cx="32" cy="29" r="5"/>
              <path class="oa-f-pri" d="M30 33 H34 L33.2 39.5 H30.8 Z"/>
            </svg>
            <h3 style="margin: 0; font-size: 0.95em; font-weight: 600;">Plugin</h3>
          </div>
          <div style="padding: 16px 20px;">
            <table style="width: 100%; border-collapse: collapse; font-size: 0.88em;">
              <tr>
                <td style="color: var(--text-color-secondary); padding: 8px 0; width: 140px; border-bottom: 1px solid var(--oau-card-border);">Name</td>
                <td style="padding: 8px 0; border-bottom: 1px solid var(--oau-card-border);">OmniAuth — Dual Auth Plugin</td>
              </tr>
              <tr>
                <td style="color: var(--text-color-secondary); padding: 8px 0; border-bottom: 1px solid var(--oau-card-border);">Auth Methods</td>
                <td style="padding: 8px 0; border-bottom: 1px solid var(--oau-card-border);">
                  <span style="background:var(--oau-info-bg);color:var(--blue);padding:2px 8px;border-radius:4px;font-size:0.82em;margin-right:6px;">Entra SSO</span>
                  <span style="background:var(--oau-neutral-bg);color:var(--text-color-secondary);padding:2px 8px;border-radius:4px;font-size:0.82em;">Native</span>
                </td>
              </tr>
              <tr>
                <td style="color: var(--text-color-secondary); padding: 8px 0; border-bottom: 1px solid var(--oau-card-border);">Login URL</td>
                <td style="font-family: monospace; padding: 8px 0; font-size: 0.85em; border-bottom: 1px solid var(--oau-card-border);">${rootURL}/login</td>
              </tr>
              <tr>
                <td style="color: var(--text-color-secondary); padding: 8px 0;">Made by</td>
                <td style="padding: 8px 0;">
                  <a href="https://github.com/dextercrypt" target="_blank" rel="noopener noreferrer"
                     style="color: var(--blue); font-weight: 600; text-decoration: none;">@dextercrypt</a>
                </td>
              </tr>
            </table>
          </div>
        </div>

      </div>

    </l:main-panel>
  </l:layout>

</j:jelly>
