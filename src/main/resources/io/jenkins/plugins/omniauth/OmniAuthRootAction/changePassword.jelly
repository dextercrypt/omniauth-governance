<!--
  First-login set-password page. Twin of the OmniAuth login page: same
  app-sign-in-register shell, same animated butler branding panel on the left
  (pulled from the security realm), same dark right-panel theming. Only the
  right-panel content differs — a set-password form instead of the login form.

  Reached pre-login by a user who validated their temporary password but still
  owes a password change. Identity comes from the server-side pending marker
  (it.pendingPasswordUser); there is NO session yet. 'it' here is the
  OmniAuthRootAction; branding getters live on the realm (app.securityRealm).
-->
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:x="jelly:xml" xmlns:st="jelly:stapler">
  <l:view xmlns:l="/lib/layout" contentType="text/html;charset=UTF-8">
    <st:setHeader name="Expires" value="0" />
    <st:setHeader name="Cache-Control" value="no-cache,no-store,must-revalidate" />
    ${h.initPageVariables(context)}
    <x:doctype name="html" />

    <j:set var="realm" value="${app.securityRealm}"/>
    <j:set var="logoPos" value="${realm.loginLogoPosition}"/>
    <j:set var="logoSize" value="${realm.loginLogoSize}"/>
    <j:set var="simpleDecorator" value="${h.simplePageDecorator}"/>

    <html lang="${request2.getLocale().toLanguageTag()}">
      <head data-rooturl="${rootURL}" data-resurl="${resURL}" data-imagesurl="${imagesURL}" resURL="${resURL}">
        <title>Set your password</title>
        <meta name="ROBOTS" content="NOFOLLOW" />
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <st:include it="${simpleDecorator}" page="simple-head.jelly" />
        <style>
          /* ===== Dark right panel + soft glow (verbatim from login.jelly) ===== */
          .app-sign-in-register__content {
            position: relative;
            overflow: hidden;
            background: linear-gradient(160deg, #0a1226 0%, #0c1730 60%, #0a1426 100%);
          }
          .app-sign-in-register__content::before {
            content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none;
            background:
              radial-gradient(140% 90% at -6% 50%, rgba(40,120,230,0.18) 0%, rgba(30,90,200,0.06) 28%, transparent 56%),
              radial-gradient(60% 50% at 6% 42%, rgba(34,211,238,0.07) 0%, transparent 60%);
          }
          .app-sign-in-register__content::after {
            content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none;
            background: radial-gradient(120% 120% at 70% 50%, transparent 55%, rgba(2,6,16,0.55) 100%);
          }
          .app-sign-in-register__content-inner { position: relative; z-index: 2; }

          /* company-logo placement (Settings → Logo Position: a|e|f) */
          .brand-logo img { height: ${logoSize}px; width: auto; max-width: none; object-fit: contain; display: block; }
          .pos-a .brand-logo { align-self: flex-start; margin: 0 0 18px 0; }
          .pos-e .brand-logo { position: absolute; top: 28px; right: 9%; z-index: 3; }
          .pos-f .brand-logo { align-self: center; margin: 0 auto 18px auto; }

          /* text */
          .app-sign-in-register__content-inner h1 { color: #f2f6ff; }
          .app-sign-in-register__content-inner label { color: #aebbd0; }

          /* inputs */
          .app-sign-in-register__content-inner input[type=text],
          .app-sign-in-register__content-inner input[type=password] {
            background: #101a2e;
            border: 1px solid #26344c;
            color: #eaf1ff;
            transition: box-shadow .2s, border-color .2s;
          }
          .app-sign-in-register__content-inner input::placeholder { color: #6b7a92; }
          .app-sign-in-register__content-inner input[type=text]:focus,
          .app-sign-in-register__content-inner input[type=password]:focus {
            border-color: #3f7ce8;
            box-shadow: 0 0 0 2px rgba(47,116,232,0.18), 0 0 10px rgba(47,116,232,0.10);
            outline: none;
          }

          /* submit button — gentle lift, no bloom */
          .app-sign-in-register__content-inner button[type=submit] {
            background: #1f57e0;
            color: #fff;
            box-shadow: 0 0 0 1px rgba(80,150,255,.22), 0 6px 18px rgba(31,87,224,0.32);
          }
          .app-sign-in-register__content-inner button[type=submit]:hover { background: #2a63ee; }

          /* ===== show-password eye toggle (verbatim from login.jelly) ===== */
          .pw-wrap { position: relative; }
          .pw-wrap input[type=text],
          .pw-wrap input[type=password] { padding-right: 44px; }
          .pw-toggle {
            position: absolute; top: 0; right: 0; height: 100%; width: 42px;
            display: flex; align-items: center; justify-content: center;
            background: none; border: none; padding: 0; margin: 0; cursor: pointer;
            color: #9fb2d0;
          }
          .pw-toggle:hover { color: #e2e9f5; }
          .pw-toggle svg { width: 20px !important; height: 20px !important; display: block; }
          .pw-toggle .icon-eye-off { display: none; }
          .pw-toggle.revealed .icon-eye { display: none; }
          .pw-toggle.revealed .icon-eye-off { display: block; }

          /* ===== set-password specifics ===== */
          .sp-sub { color: #9fb2d0; font-size: 14px; line-height: 1.5; margin: -6px 0 22px; }
          .sp-sub b { color: #dbe7fb; }
          .sp-err {
            margin-bottom: 16px; padding: 10px 14px; border-radius: 6px; font-size: 13px;
            background: rgba(229, 62, 62, 0.12); border: 1px solid rgba(229, 62, 62, 0.45); color: #fca5a5;
          }
          .sp-bar { height: 3px; border-radius: 2px; margin-top: 7px; background: #1d2a44; overflow: hidden; }
          .sp-fill { height: 100%; width: 0%; transition: width 0.3s, background 0.3s; background: #1d2a44; }
          .sp-hint { font-size: 12px; color: #8ea3c4; margin-top: 5px; min-height: 1em; }
          .sp-foot { margin-top: 20px; text-align: center; font-size: 12px; color: #6f81a0; }
          .app-sign-in-register__content-inner button[type=submit].sp-btn {
            width: 100%; margin-top: 6px; padding: 11px; font-size: 15px; font-weight: 600;
            border: none; border-radius: 6px; cursor: pointer;
          }
        </style>
      </head>
      <body class="app-sign-in-register">
        <!-- Left branding panel: identical to the login page, driven by the realm. -->
        <j:choose>
          <j:when test="${realm.loginBackground == 'starburst'}">
            <st:include it="${simpleDecorator}" page="simple-branding.jelly" />
          </j:when>
          <j:otherwise>
            <st:include it="${realm}" page="animated-branding.jelly"/>
          </j:otherwise>
        </j:choose>

        <main id="main-panel" class="app-sign-in-register__content pos-${logoPos}">
          <j:if test="${logoPos == 'e' and realm.loginLogoUrl != null and realm.loginLogoUrl != ''}">
            <div class="brand-logo"><img src="${realm.loginLogoUrl}" alt=""/></div>
          </j:if>
          <div class="app-sign-in-register__content-inner">
            <j:if test="${logoPos != 'e' and realm.loginLogoUrl != null and realm.loginLogoUrl != ''}">
              <div class="brand-logo"><img src="${realm.loginLogoUrl}" alt=""/></div>
            </j:if>

            <h1>Set your password</h1>
            <div class="sp-sub">
              <j:choose>
                <j:when test="${it.pendingPasswordUser != null}">
                  Choose a password for <b>${it.pendingPasswordUser}</b> to finish signing in.
                </j:when>
                <j:otherwise>
                  Choose a password to finish signing in.
                </j:otherwise>
              </j:choose>
            </div>

            <j:if test="${request2.getParameter('error') == 'tooShort'}">
              <div class="sp-err">Password must be at least 8 characters.</div>
            </j:if>
            <j:if test="${request2.getParameter('error') == 'mismatch'}">
              <div class="sp-err">Passwords do not match. Please try again.</div>
            </j:if>
            <j:if test="${request2.getParameter('error') == 'saveFailed'}">
              <div class="sp-err">Could not save password. Please contact your administrator.</div>
            </j:if>
            <j:if test="${request2.getParameter('error') == 'noUser'}">
              <div class="sp-err">Your account could not be found. Please contact your administrator.</div>
            </j:if>

            <form method="post" action="${rootURL}/omniauth/submitPasswordChange" onsubmit="return validateForm()">
              <input type="hidden" name="${it.crumbFieldName}" value="${it.crumbValue}"/>
              <div>
                <label class="app-sign-in-register__form-label" for="newPassword">New password</label>
                <div class="pw-wrap">
                  <input id="newPassword" class="jenkins-input" type="password" name="newPassword"
                         required="required" placeholder="Min. 8 characters" autocomplete="new-password"
                         autofocus="autofocus" oninput="checkStrength(this.value)"/>
                  <button type="button" class="pw-toggle" tabindex="-1" aria-label="Show password" data-target="newPassword">
                    <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                    </svg>
                    <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>
                    </svg>
                  </button>
                </div>
                <div class="sp-bar"><div id="strengthFill" class="sp-fill"></div></div>
                <div id="strengthLabel" class="sp-hint"></div>
              </div>

              <div style="margin-top:16px;">
                <label class="app-sign-in-register__form-label" for="confirmPassword">Confirm password</label>
                <div class="pw-wrap">
                  <input id="confirmPassword" class="jenkins-input" type="password" name="confirmPassword"
                         required="required" placeholder="Repeat your new password" autocomplete="new-password"/>
                  <button type="button" class="pw-toggle" tabindex="-1" aria-label="Show password" data-target="confirmPassword">
                    <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                    </svg>
                    <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>
                    </svg>
                  </button>
                </div>
                <div id="matchMsg" class="sp-hint"></div>
              </div>

              <button type="submit" class="sp-btn" style="margin-top:22px;">Set password</button>
            </form>

            <div class="sp-foot">Contact your administrator if you need help.</div>
          </div>
        </main>

        <script>//<![CDATA[
          function checkStrength(val) {
            var fill  = document.getElementById('strengthFill');
            var label = document.getElementById('strengthLabel');
            var score = 0;
            if (val.length >= 8)  score++;
            if (val.length >= 12) score++;
            if (/[A-Z]/.test(val)) score++;
            if (/[0-9]/.test(val)) score++;
            if (/[^A-Za-z0-9]/.test(val)) score++;
            var colors = ['#e53e3e','#e53e3e','#dd6b20','#38a169','#22c55e'];
            var labels = ['','Too weak','Weak','Good','Strong','Very strong'];
            fill.style.width = (score / 5 * 100) + '%';
            fill.style.background = colors[Math.max(0, score - 1)] || '#1d2a44';
            label.textContent = val.length > 0 ? (labels[score] || '') : '';
            label.style.color = colors[Math.max(0, score - 1)] || '#8ea3c4';
          }

          function validateForm() {
            var p1 = document.getElementById('newPassword').value;
            var p2 = document.getElementById('confirmPassword').value;
            if (p1.length < 8) { alert('Password must be at least 8 characters.'); return false; }
            if (p1 !== p2) { alert('Passwords do not match.'); return false; }
            return true;
          }

          document.getElementById('confirmPassword').addEventListener('input', function () {
            var msg = document.getElementById('matchMsg');
            var p1  = document.getElementById('newPassword').value;
            if (!this.value) { msg.textContent = ''; return; }
            if (this.value === p1) {
              msg.textContent = '✓ Passwords match'; msg.style.color = '#22c55e';
            } else {
              msg.textContent = '✗ Passwords do not match'; msg.style.color = '#fca5a5';
            }
          });

          var toggles = document.querySelectorAll('.pw-toggle');
          for (var i = 0; i < toggles.length; i++) {
            toggles[i].addEventListener('click', function () {
              var input = document.getElementById(this.getAttribute('data-target'));
              if (!input) { return; }
              var reveal = input.type === 'password';
              input.type = reveal ? 'text' : 'password';
              this.classList.toggle('revealed', reveal);
              this.setAttribute('aria-label', reveal ? 'Hide password' : 'Show password');
              input.focus();
            });
          }
        //]]></script>
      </body>
    </html>
  </l:view>
</j:jelly>
