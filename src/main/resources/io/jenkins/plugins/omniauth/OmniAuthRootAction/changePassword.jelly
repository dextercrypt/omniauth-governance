<!--
  First-login set-password page. Twin of the OmniAuth login page: same
  app-sign-in-register shell, same animated butler branding panel on the left
  (pulled from the security realm), same dark right-panel theming. Only the
  right-panel content differs — a set-password form instead of the login form.

  Reached pre-login by a user who validated their temporary password but still
  owes a password change. Identity comes from the server-side pending marker
  (it.pendingPasswordUser); there is NO session yet. 'it' here is the
  OmniAuthRootAction; branding getters live on the realm (app.securityRealm).
-->
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:x="jelly:xml" xmlns:st="jelly:stapler">
  <l:view xmlns:l="/lib/layout" contentType="text/html;charset=UTF-8">
    <st:setHeader name="Expires" value="0" />
    <st:setHeader name="Cache-Control" value="no-cache,no-store,must-revalidate" />
    ${h.initPageVariables(context)}
    <x:doctype name="html" />

    <j:set var="realm" value="${app.securityRealm}"/>
    <j:set var="logoPos" value="${realm.loginLogoPosition}"/>
    <j:set var="logoSize" value="${realm.loginLogoSize}"/>
    <j:set var="simpleDecorator" value="${h.simplePageDecorator}"/>

    <html lang="${request2.getLocale().toLanguageTag()}">
      <head data-rooturl="${rootURL}" data-resurl="${resURL}" data-imagesurl="${imagesURL}" resURL="${resURL}">
        <title>Set your password</title>
        <meta name="ROBOTS" content="NOFOLLOW" />
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <st:include it="${simpleDecorator}" page="simple-head.jelly" />
        <st:adjunct includes="io.jenkins.plugins.omniauth.OmniAuthRootAction.changePasswordAssets"/>
      </head>
      <body class="app-sign-in-register">
        <!-- Left branding panel: identical to the login page, driven by the realm. -->
        <j:choose>
          <j:when test="${realm.loginBackground == 'starburst'}">
            <st:include it="${simpleDecorator}" page="simple-branding.jelly" />
          </j:when>
          <j:otherwise>
            <st:include it="${realm}" page="animated-branding.jelly"/>
          </j:otherwise>
        </j:choose>

        <main id="main-panel" class="app-sign-in-register__content pos-${logoPos}">
          <j:if test="${logoPos == 'e' and realm.loginLogoUrl != null and realm.loginLogoUrl != ''}">
            <div class="brand-logo"><img src="${realm.loginLogoUrl}" alt="" style="height:${logoSize}px"/></div>
          </j:if>
          <div class="app-sign-in-register__content-inner">
            <j:if test="${logoPos != 'e' and realm.loginLogoUrl != null and realm.loginLogoUrl != ''}">
              <div class="brand-logo"><img src="${realm.loginLogoUrl}" alt="" style="height:${logoSize}px"/></div>
            </j:if>

            <h1>Set your password</h1>
            <div class="sp-sub">
              <j:choose>
                <j:when test="${it.pendingPasswordUser != null}">
                  Choose a password for <b>${it.pendingPasswordUser}</b> to finish signing in.
                </j:when>
                <j:otherwise>
                  Choose a password to finish signing in.
                </j:otherwise>
              </j:choose>
            </div>

            <j:if test="${request2.getParameter('error') == 'tooShort'}">
              <div class="sp-err">Password must be at least 8 characters.</div>
            </j:if>
            <j:if test="${request2.getParameter('error') == 'mismatch'}">
              <div class="sp-err">Passwords do not match. Please try again.</div>
            </j:if>
            <j:if test="${request2.getParameter('error') == 'saveFailed'}">
              <div class="sp-err">Could not save password. Please contact your administrator.</div>
            </j:if>
            <j:if test="${request2.getParameter('error') == 'noUser'}">
              <div class="sp-err">Your account could not be found. Please contact your administrator.</div>
            </j:if>

            <form method="post" action="${rootURL}/omniauth/submitPasswordChange" id="oauChangePasswordForm">
              <input type="hidden" name="${it.crumbFieldName}" value="${it.crumbValue}"/>
              <div>
                <label class="app-sign-in-register__form-label" for="newPassword">New password</label>
                <div class="pw-wrap">
                  <input id="newPassword" class="jenkins-input" type="password" name="newPassword"
                         required="required" placeholder="Min. 8 characters" autocomplete="new-password"
                         autofocus="autofocus"/>
                  <button type="button" class="pw-toggle" tabindex="-1" aria-label="Show password" data-target="newPassword">
                    <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                    </svg>
                    <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>
                    </svg>
                  </button>
                </div>
                <div class="sp-bar"><div id="strengthFill" class="sp-fill"></div></div>
                <div id="strengthLabel" class="sp-hint"></div>
              </div>

              <div style="margin-top:16px;">
                <label class="app-sign-in-register__form-label" for="confirmPassword">Confirm password</label>
                <div class="pw-wrap">
                  <input id="confirmPassword" class="jenkins-input" type="password" name="confirmPassword"
                         required="required" placeholder="Repeat your new password" autocomplete="new-password"/>
                  <button type="button" class="pw-toggle" tabindex="-1" aria-label="Show password" data-target="confirmPassword">
                    <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                    </svg>
                    <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>
                    </svg>
                  </button>
                </div>
                <div id="matchMsg" class="sp-hint"></div>
              </div>

              <button type="submit" class="sp-btn" style="margin-top:22px;">Set password</button>
            </form>

            <div class="sp-foot">Contact your administrator if you need help.</div>
          </div>
        </main>
      </body>
    </html>
  </l:view>
</j:jelly>
