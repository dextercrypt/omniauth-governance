<!--
  First-login set-password page. Standalone, branded to match the OmniAuth login
  page (no Jenkins chrome). Reached pre-login by a user who has validated their
  temporary password but still owes a password change. Identity comes from the
  server-side pending marker (it.pendingPasswordUser); there is NO session yet.
-->
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:x="jelly:xml" xmlns:st="jelly:stapler">
  <l:view xmlns:l="/lib/layout" contentType="text/html;charset=UTF-8">
    <st:setHeader name="Expires" value="0" />
    <st:setHeader name="Cache-Control" value="no-cache,no-store,must-revalidate" />
    <j:set var="simpleDecorator" value="${h.simplePageDecorator}"/>
    <x:doctype name="html" />
    <html lang="${request2.getLocale().toLanguageTag()}">
      <head data-rooturl="${rootURL}" data-resurl="${resURL}" resURL="${resURL}">
        <title>Set your password</title>
        <meta name="ROBOTS" content="NOFOLLOW" />
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <st:include it="${simpleDecorator}" page="simple-head.jelly" />
        <style>
          html, body {
            margin: 0; height: 100%;
            background: linear-gradient(160deg, #0a1226 0%, #0c1730 60%, #0a1426 100%);
            color: #dde6f4;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
          }
          .sp-wrap {
            min-height: 100vh; box-sizing: border-box;
            display: flex; align-items: center; justify-content: center; padding: 40px 16px;
          }
          .sp-card-col { width: 100%; max-width: 400px; }
          .sp-head { text-align: center; margin-bottom: 28px; }
          .sp-key { font-size: 2.6em; margin-bottom: 10px; }
          .sp-title { font-weight: 700; font-size: 1.35em; margin-bottom: 8px; color: #f1f5fb; }
          .sp-sub { font-size: 0.9em; color: #9fb2d0; line-height: 1.5; }
          .sp-sub b { color: #dbe7fb; }
          .sp-err {
            margin-bottom: 16px; padding: 10px 14px; border-radius: 6px; font-size: 0.85em;
            background: rgba(229, 62, 62, 0.12); border: 1px solid rgba(229, 62, 62, 0.45); color: #fca5a5;
          }
          .sp-panel {
            background: #0e1a30; border: 1px solid #24344f; border-radius: 12px;
            padding: 26px 26px 22px; box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35);
          }
          .sp-label {
            display: block; font-size: 0.72em; font-weight: 700; text-transform: uppercase;
            letter-spacing: 0.05em; color: #8ea3c4; margin-bottom: 6px;
          }
          .sp-field { margin-bottom: 16px; }
          .pw-wrap { position: relative; }
          .pw-input {
            width: 100%; box-sizing: border-box; padding: 9px 44px 9px 12px;
            background: #0b1426; border: 1px solid #2a3a54; border-radius: 6px;
            color: #e8eefb; font-size: 14px; outline: none;
          }
          .pw-input:focus { border-color: #3b82f6; box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.25); }
          .pw-toggle {
            position: absolute; top: 0; right: 0; height: 100%; width: 42px;
            display: flex; align-items: center; justify-content: center;
            background: none; border: none; padding: 0; margin: 0; cursor: pointer; color: #9fb2d0;
          }
          .pw-toggle:hover { color: #e2e9f5; }
          .pw-toggle svg { width: 20px !important; height: 20px !important; display: block; }
          .pw-toggle .icon-eye-off { display: none; }
          .pw-toggle.revealed .icon-eye { display: none; }
          .pw-toggle.revealed .icon-eye-off { display: block; }
          .sp-bar { height: 3px; border-radius: 2px; margin-top: 7px; background: #1d2a44; overflow: hidden; }
          .sp-fill { height: 100%; width: 0%; transition: width 0.3s, background 0.3s; background: #1d2a44; }
          .sp-hint { font-size: 0.72em; color: #8ea3c4; margin-top: 4px; min-height: 1em; }
          .sp-btn {
            width: 100%; margin-top: 6px; padding: 11px; font-size: 0.95em; font-weight: 600;
            color: #fff; background: #2563eb; border: none; border-radius: 6px; cursor: pointer;
            transition: background 0.15s ease;
          }
          .sp-btn:hover { background: #1d4ed8; }
          .sp-foot { text-align: center; margin-top: 18px; font-size: 0.78em; color: #6f81a0; }
        </style>
      </head>
      <body>
        <div class="sp-wrap">
          <div class="sp-card-col">

            <div class="sp-head">
              <div class="sp-key">&#128273;</div>
              <div class="sp-title">Set your password</div>
              <div class="sp-sub">
                <j:choose>
                  <j:when test="${it.pendingPasswordUser != null}">
                    Choose a password for <b>${it.pendingPasswordUser}</b> to finish signing in.
                  </j:when>
                  <j:otherwise>
                    Choose a password to finish signing in.
                  </j:otherwise>
                </j:choose>
              </div>
            </div>

            <j:if test="${request2.getParameter('error') == 'tooShort'}">
              <div class="sp-err">Password must be at least 8 characters.</div>
            </j:if>
            <j:if test="${request2.getParameter('error') == 'mismatch'}">
              <div class="sp-err">Passwords do not match. Please try again.</div>
            </j:if>
            <j:if test="${request2.getParameter('error') == 'saveFailed'}">
              <div class="sp-err">Could not save password. Please contact your administrator.</div>
            </j:if>
            <j:if test="${request2.getParameter('error') == 'noUser'}">
              <div class="sp-err">Your account could not be found. Please contact your administrator.</div>
            </j:if>

            <div class="sp-panel">
              <form method="post" action="${rootURL}/omniauth/submitPasswordChange" onsubmit="return validateForm()">

                <div class="sp-field">
                  <label class="sp-label" for="newPassword">New password</label>
                  <div class="pw-wrap">
                    <input id="newPassword" type="password" name="newPassword" required="required"
                           class="pw-input" placeholder="Min. 8 characters" autocomplete="new-password"
                           autofocus="autofocus" oninput="checkStrength(this.value)"/>
                    <button type="button" class="pw-toggle" tabindex="-1" aria-label="Show password"
                            data-target="newPassword">
                      <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                           stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                      </svg>
                      <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                           stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>
                      </svg>
                    </button>
                  </div>
                  <div class="sp-bar"><div id="strengthFill" class="sp-fill"></div></div>
                  <div id="strengthLabel" class="sp-hint"></div>
                </div>

                <div class="sp-field">
                  <label class="sp-label" for="confirmPassword">Confirm password</label>
                  <div class="pw-wrap">
                    <input id="confirmPassword" type="password" name="confirmPassword" required="required"
                           class="pw-input" placeholder="Repeat your new password" autocomplete="new-password"/>
                    <button type="button" class="pw-toggle" tabindex="-1" aria-label="Show password"
                            data-target="confirmPassword">
                      <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                           stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                      </svg>
                      <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                           stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>
                      </svg>
                    </button>
                  </div>
                  <div id="matchMsg" class="sp-hint"></div>
                </div>

                <button type="submit" class="sp-btn">Set password</button>
              </form>
            </div>

            <div class="sp-foot">Contact your administrator if you need help.</div>

          </div>
        </div>

        <script>//<![CDATA[
          function checkStrength(val) {
            var fill  = document.getElementById('strengthFill');
            var label = document.getElementById('strengthLabel');
            var score = 0;
            if (val.length >= 8)  score++;
            if (val.length >= 12) score++;
            if (/[A-Z]/.test(val)) score++;
            if (/[0-9]/.test(val)) score++;
            if (/[^A-Za-z0-9]/.test(val)) score++;
            var colors = ['#e53e3e','#e53e3e','#dd6b20','#38a169','#22c55e'];
            var labels = ['','Too weak','Weak','Good','Strong','Very strong'];
            fill.style.width = (score / 5 * 100) + '%';
            fill.style.background = colors[Math.max(0, score - 1)] || '#1d2a44';
            label.textContent = val.length > 0 ? (labels[score] || '') : '';
            label.style.color = colors[Math.max(0, score - 1)] || '#8ea3c4';
          }

          function validateForm() {
            var p1 = document.getElementById('newPassword').value;
            var p2 = document.getElementById('confirmPassword').value;
            if (p1.length < 8) { alert('Password must be at least 8 characters.'); return false; }
            if (p1 !== p2) { alert('Passwords do not match.'); return false; }
            return true;
          }

          document.getElementById('confirmPassword').addEventListener('input', function () {
            var msg = document.getElementById('matchMsg');
            var p1  = document.getElementById('newPassword').value;
            if (!this.value) { msg.textContent = ''; return; }
            if (this.value === p1) {
              msg.textContent = '✓ Passwords match'; msg.style.color = '#22c55e';
            } else {
              msg.textContent = '✗ Passwords do not match'; msg.style.color = '#fca5a5';
            }
          });

          var toggles = document.querySelectorAll('.pw-toggle');
          for (var i = 0; i < toggles.length; i++) {
            toggles[i].addEventListener('click', function () {
              var input = document.getElementById(this.getAttribute('data-target'));
              if (!input) { return; }
              var reveal = input.type === 'password';
              input.type = reveal ? 'text' : 'password';
              this.classList.toggle('revealed', reveal);
              var label = reveal ? 'Hide password' : 'Show password';
              this.setAttribute('aria-label', label);
              input.focus();
            });
          }
        //]]></script>
      </body>
    </html>
  </l:view>
</j:jelly>
