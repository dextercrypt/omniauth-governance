<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler">
  <!--
    Animated branding panel.
    IMPORTANT: do NOT override `position` here. Jenkins' own CSS sets this section to
    `position:fixed; width:40vw; height:100vh` and flex-centers the logo. Overriding position
    drops it into normal flow and breaks the whole two-column layout.
    We only add a background colour; the canvas is absolutely positioned inside the fixed
    section (inset:0) and the logo stays a normal flex-centered child (sized by Jenkins CSS).
  -->
  <!--
    Styles and the canvas animation script are externalised to CSP-compliant adjuncts
    (animated-branding.css / animated-branding.js) so this page passes the Jenkins hosting
    checks. The CSS kills Jenkins' native starburst blobs and version-proofs the panel layout;
    see the adjunct files for the detailed rationale.
  -->
  <section class="app-sign-in-register__branding"
           style="background:linear-gradient(135deg,#080b1e 0%,#0a1026 50%,#0c1430 100%);">

    <st:adjunct includes="io.jenkins.plugins.omniauth.OmniAuthSecurityRealm.brandingAnim"/>

    <canvas id="omniauth-bg-canvas"
            style="position:absolute;inset:0;display:block;z-index:0;"></canvas>

    
    <j:choose>
      <j:when test="${it.resolvedLoginButler =='jenkinsx'}">
        <st:include page="butler-jenkinsx.jelly"/>
      
      </j:when>
      <j:when test="${it.resolvedLoginButler =='austin'}">
        <st:include page="butler-austin.jelly"/>
      
      </j:when>
      <j:when test="${it.resolvedLoginButler =='general'}">
        <st:include page="butler-general.jelly"/>
      </j:when>
      <j:when test="${it.resolvedLoginButler =='nerd'}">
        <st:include page="butler-nerd.jelly"/>
      </j:when>
      <j:when test="${it.resolvedLoginButler =='ninja'}">
        <st:include page="butler-ninja.jelly"/>
      </j:when>
      <j:when test="${it.resolvedLoginButler =='santaclaus'}">
        <st:include page="butler-santa-claus.jelly"/>
      </j:when>
      <j:when test="${it.resolvedLoginButler =='superhero'}">
        <st:include page="butler-superhero.jelly"/>
      </j:when>
      <j:when test="${it.resolvedLoginButler =='raleigh'}">
        <st:include page="butler-raleigh.jelly"/>
      </j:when>
      <j:when test="${it.resolvedLoginButler =='sandiego'}">
        <st:include page="butler-san-diego.jelly"/>
      </j:when>
      <j:when test="${it.resolvedLoginButler =='cowboy'}">
        <st:include page="butler-cowboy.jelly"/>
      </j:when>
      <j:otherwise>
        <img src="${resURL}/images/svgs/logo.svg" alt="Jenkins"
             style="position:relative;z-index:1;filter:drop-shadow(0 0 28px rgba(34,211,238,0.45));"/>
      </j:otherwise>
    </j:choose>

  </section>
</j:jelly>
