<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:f="/lib/form">

  <f:entry title="Tenant ID" field="tenantId"
           help="/plugin/omni-auth/help/tenantId.html">
    <f:textbox/>
  </f:entry>

  <f:entry title="Client ID" field="clientId"
           help="/plugin/omni-auth/help/clientId.html">
    <f:textbox/>
  </f:entry>

  <f:entry title="Client Secret" field="clientSecret"
           help="/plugin/omni-auth/help/clientSecret.html">
    <f:password/>
  </f:entry>

  <f:entry title="">
    <div class="oau-test-connection">
      <f:validateButton title="Test Connection" progress="Contacting Microsoft…"
                        method="testConnection" with="tenantId,clientId,clientSecret"/>
      <div class="jenkins-form-description">
        Checks the Tenant ID, Client ID and Client Secret above against Microsoft before you save.
      </div>
    </div>
    <!-- Jenkins floats the validate button right and stacks the progress ABOVE and the result
         BELOW it. Lay the container out as a left-aligned column so the button sits under the
         fields and BOTH the "Contacting…" spinner and the result land directly beneath it, in the
         same fixed spot. Also suppress Jenkins' built-in validation icon (.error::before) — we
         render our own inline SVG, so without this an error would show two icons. -->
    <style>
      .oau-test-connection .jenkins-validate-button__container {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
      }
      .oau-test-connection .jenkins-validate-button__container > .jenkins-button {
        float: none;
        order: 0;
      }
      .oau-test-connection .jenkins-validate-button__container > *:not(.jenkins-button) {
        order: 1;
        margin: 0;
      }
      .oau-test-connection .jenkins-validate-button__container .jenkins-spinner {
        margin: 0;
      }
      .oau-test-connection .error::before {
        display: none;
      }
      /* .error reserves left padding for that icon; reclaim it so our content starts at the
         button's left edge (the icon then lines up under the button, like the success state). */
      .oau-test-connection .error {
        padding-left: 0;
      }
    </style>
  </f:entry>

  <f:entry title="Enable Group Sync" field="enableGroupSync"
           help="/plugin/omni-auth/help/enableGroupSync.html">
    <f:checkbox/>
  </f:entry>

  <f:entry title="Allowed email domains" field="allowedDomains"
           help="/plugin/omni-auth/help/allowedDomains.html">
    <f:textbox placeholder="Leave blank to allow any domain — or list domains, e.g. example.com, example.org"/>
  </f:entry>

  <f:block>
    <div class="jenkins-alert jenkins-alert-info">
      <b>Required Azure AD App Registration settings:</b>
      <ul>
        <li>Redirect URI: <code>${descriptor.redirectUri}</code></li>
        <li>API Permissions: <code>openid</code>, <code>profile</code>, <code>email</code> (delegated)</li>
        <li>If group sync enabled: <code>GroupMember.Read.All</code> (delegated, admin consent required)</li>
      </ul>
    </div>
  </f:block>

</j:jelly>
